@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkInInput = document.getElementById('checkInDate');
            const checkOutInput = document.getElementById('checkOutDate');
            const nightCountSpan = document.getElementById('nightCount');
            const durationText = document.getElementById('durationText');
            const roomRadios = document.querySelectorAll('.room-radio');

            const sumRoomName = document.getElementById('sumRoomName');
            const sumRoomType = document.getElementById('sumRoomType');
            const sumCheckIn = document.getElementById('sumCheckIn');
            const sumCheckOut = document.getElementById('sumCheckOut');
            const sumNights = document.getElementById('sumNights');
            const sumUnitPrice = document.getElementById('sumUnitPrice');
            const sumTotalAmount = document.getElementById('sumTotalAmount');

            function formatDateVN(dateStr) {
                if (!dateStr) return '--';
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    return `${parts[2]}/${parts[1]}/${parts[0]}`;
                }
                return dateStr;
            }

            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
            }

            function calculateNights() {
                const checkInVal = checkInInput.value;
                const checkOutVal = checkOutInput.value;
                if (!checkInVal || !checkOutVal) return 1;

                const checkIn = new Date(checkInVal);
                const checkOut = new Date(checkOutVal);
                const diffTime = checkOut - checkIn;
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                return diffDays > 0 ? diffDays : 1;
            }

            function updateSummary() {
                const nights = calculateNights();
                nightCountSpan.textContent = nights + ' đêm';
                sumNights.textContent = nights + ' đêm';
                sumCheckIn.textContent = formatDateVN(checkInInput.value);
                sumCheckOut.textContent = formatDateVN(checkOutInput.value);

                // Update min date for checkout
                if (checkInInput.value) {
                    const nextDay = new Date(checkInInput.value);
                    nextDay.setDate(nextDay.getDate() + 1);
                    checkOutInput.min = nextDay.toISOString().split('T')[0];
                }

                // Selected room
                let selectedRadio = document.querySelector('.room-radio:checked');
                if (!selectedRadio && roomRadios.length > 0) {
                    roomRadios[0].checked = true;
                    selectedRadio = roomRadios[0];
                }

                // Update card visual
                document.querySelectorAll('.room-option-card').forEach(card => {
                    card.classList.remove('selected');
                });

                if (selectedRadio) {
                    const parentCard = selectedRadio.closest('.room-option-card');
                    if (parentCard) parentCard.classList.add('selected');

                    const roomNum = selectedRadio.dataset.roomNumber;
                    const roomType = selectedRadio.dataset.roomType;
                    const price = parseFloat(selectedRadio.dataset.price) || 0;

                    sumRoomName.textContent = 'Phòng ' + roomNum;
                    sumRoomType.textContent = roomType;
                    sumUnitPrice.textContent = formatCurrency(price);

                    const total = price * nights;
                    sumTotalAmount.textContent = formatCurrency(total);
                }
            }

            checkInInput.addEventListener('change', function () {
                const nextDay = new Date(this.value);
                nextDay.setDate(nextDay.getDate() + 1);
                const nextDayStr = nextDay.toISOString().split('T')[0];
                if (checkOutInput.value <= this.value) {
                    checkOutInput.value = nextDayStr;
                }
                updateSummary();
            });

            checkOutInput.addEventListener('change', updateSummary);

            roomRadios.forEach(radio => {
                radio.addEventListener('change', updateSummary);
            });

            // Payment radio cards
            const paymentRadios = document.querySelectorAll('.payment-radio');
            paymentRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    document.querySelectorAll('.payment-option-card').forEach(c => c.classList.remove('active'));
                    const parent = this.closest('.payment-option-card');
                    if (parent) parent.classList.add('active');
                });
            });

            // Initial calculation
            updateSummary();
        });
    </script>
}