@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-page">

    <div class="dashboard-heading">
        <div>
            <span class="dashboard-eyebrow">HOTEL MANAGEMENT / OVERVIEW</span>
            <h1>Tổng quan hệ thống</h1>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
    </div>

    <div class="dashboard-welcome">
        <div class="welcome-content">
            <span class="welcome-eyebrow">WELCOME BACK</span>
            <h2>Quản lý tinh tế.<br />Trải nghiệm hoàn hảo.</h2>
            <p>
                Theo dõi hoạt động và quản lý khách sạn của cậu
                từ một không gian làm việc thống nhất.
            </p>
            <a asp-controller="LoaiPhong" asp-action="Index" class="welcome-button">
                Khám phá hệ thống <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="welcome-decoration">
            <i class="bi bi-buildings"></i>
            <span>EXCELLENCE IN HOSPITALITY</span>
        </div>
    </div>

    <div class="dashboard-section-heading">
        <div>
            <span class="dashboard-eyebrow">AT A GLANCE</span>
            <h2>Tổng quan nhanh</h2>
        </div>
        <span class="dashboard-note">Các chức năng quản lý</span>
    </div>

    <div class="dashboard-stats">
        <a asp-controller="Phong" asp-action="Index" class="dashboard-stat">
            <div class="stat-top">
                <span class="stat-icon"><i class="bi bi-door-closed"></i></span>
                <i class="bi bi-arrow-up-right stat-arrow"></i>
            </div>
            <span class="stat-label">QUẢN LÝ PHÒNG</span>
            <h3>Phòng khách sạn</h3>
            <p>Xem và quản lý danh sách phòng.</p>
            <span class="stat-link">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
        </a>

        <a asp-controller="LoaiPhong" asp-action="Index" class="dashboard-stat">
            <div class="stat-top">
                <span class="stat-icon"><i class="bi bi-tags"></i></span>
                <i class="bi bi-arrow-up-right stat-arrow"></i>
            </div>
            <span class="stat-label">ROOM CATEGORIES</span>
            <h3>Loại phòng</h3>
            <p>Quản lý loại phòng và thông tin liên quan.</p>
            <span class="stat-link">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
        </a>

        <div class="dashboard-stat dashboard-stat-disabled">
            <div class="stat-top">
                <span class="stat-icon"><i class="bi bi-calendar2-check"></i></span>
                <span class="stat-status">SẮP CÓ</span>
            </div>
            <span class="stat-label">RESERVATIONS</span>
            <h3>Đặt phòng</h3>
            <p>Quản lý đặt phòng sẽ được bổ sung sau.</p>
            <span class="stat-link">Đang phát triển</span>
        </div>

        <div class="dashboard-stat dashboard-stat-disabled">
            <div class="stat-top">
                <span class="stat-icon"><i class="bi bi-people"></i></span>
                <span class="stat-status">SẮP CÓ</span>
            </div>
            <span class="stat-label">GUEST SERVICES</span>
            <h3>Khách hàng</h3>
            <p>Thông tin khách hàng và lịch sử lưu trú.</p>
            <span class="stat-link">Đang phát triển</span>
        </div>
    </div>

    <div class="dashboard-bottom">
        <div class="dashboard-info-card">
            <span class="dashboard-eyebrow">QUICK ACCESS</span>
            <h3>Thao tác nhanh</h3>
            <p>Truy cập trực tiếp các khu vực quản lý thường dùng.</p>

            <div class="quick-links">
                <a asp-controller="Phong" asp-action="Index">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>Danh sách phòng</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a asp-controller="LoaiPhong" asp-action="Index">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>Danh sách loại phòng</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="dashboard-info-card dashboard-note-card">
            <span class="dashboard-eyebrow">SYSTEM INFORMATION</span>
            <div class="system-symbol"><i class="bi bi-stars"></i></div>
            <h3>Không gian quản trị khách sạn</h3>
            <div class="system-divider"></div>
            <span class="system-caption">
                <i class="bi bi-shield-check"></i>
                HotelManager · @DateTime.Now.Year
            </span>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
