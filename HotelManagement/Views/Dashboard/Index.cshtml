
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-quick-grid">
    <a asp-controller="LoaiPhong" asp-action="Index" class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-door-closed"></i>
        </span>
        <span>
            <h2>Sơ đồ phòng & loại phòng</h2>
            <p>Xem và quản lý danh mục loại phòng hiện có.</p>
        </span>
    </a>

    <a asp-controller="DichVu" asp-action="Index" class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-cup-hot"></i>
        </span>
        <span>
            <h2>Quản lý dịch vụ</h2>
            <p>Cập nhật dịch vụ và thông tin giá dịch vụ.</p>
        </span>
    </a>

    <a asp-controller="DatPhong" asp-action="Index" class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-calendar2-check"></i>
        </span>
        <span>
            <h2>Quản lý đặt phòng</h2>
            <p>Xem danh sách phiếu đặt phòng, tạo phiếu, nhận và trả phòng.</p>
        </span>
    </a>

    <div class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-receipt"></i>
        </span>
        <span>
            <h2>Hóa đơn & thanh toán</h2>
            <p>Khu vực quản lý tài chính sẽ được bổ sung sau.</p>
        </span>
    </div>

    <div class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-bar-chart-line"></i>
        </span>
        <span>
            <h2>Báo cáo thống kê</h2>
            <p>Tổng hợp số liệu hoạt động khi các nghiệp vụ được hoàn thiện.</p>
        </span>
    </div>

    <a asp-controller="CaiDat" asp-action="Index" class="dashboard-quick-card">
        <span class="dashboard-quick-icon">
            <i class="bi bi-gear"></i>
        </span>
        <span>
            <h2>Cài đặt hệ thống</h2>
            <p>Cấu hình thông tin khách sạn, tham số và phân quyền hệ thống.</p>
        </span>
    </a>
</div>

<h2 class="dashboard-section-title">Trạng thái hệ thống</h2>

<div class="dashboard-notice">
    <i class="bi bi-info-circle"></i>
    <div>
        <strong>Giao diện quản trị đã sẵn sàng.</strong>
        <br />
        Hiện có thể sử dụng các mục Loại phòng và Dịch vụ.
        Những mục chưa có chức năng được hiển thị để định hướng
        phát triển và chưa dẫn tới trang không tồn tại.
    </div>
</div>
