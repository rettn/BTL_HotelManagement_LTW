@model HotelManagement.ViewModels.FinancialDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Báo cáo thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-0">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                Báo cáo & Thống kê Tài chính
            </h3>
            <p class="text-muted small mb-0">Theo dõi doanh thu phòng, dịch vụ và phân tích biến động dòng tiền</p>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm d-print-none">
                <i class="bi bi-printer me-1"></i>In báo cáo
            </button>
        </div>
    </div>

    <!-- 4 Cards thống kê chính -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Hôm nay</span>
                            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.DoanhThuHomNay.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-calendar2-day fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tuần này</span>
                            <h4 class="fw-bold text-info mb-0 mt-1">@Model.DoanhThuTuanNay.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-calendar-week fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tháng @DateTime.Now.Month/@DateTime.Now.Year</span>
                            <h4 class="fw-bold text-success mb-0 mt-1">@Model.DoanhThuThangNay.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-calendar-month fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng tích lũy</span>
                            <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TongDoanhThu.ToString("N0") đ</h4>
                        </div>
                        <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng biểu đồ -->
    <div class="row g-4">
        <!-- Biểu đồ cột: Biến động 7 ngày gần nhất -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bar-chart-line text-primary me-2"></i>Biến động Doanh thu 7 ngày gần nhất
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">7 ngày qua</span>
                </div>
                <div class="card-body p-3">
                    <div style="height: 320px; position: relative;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ Donut: Tỷ lệ tiền phòng vs tiền dịch vụ -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-pie-chart text-primary me-2"></i>Cơ cấu Doanh thu
                    </h5>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div style="height: 220px; position: relative;">
                        <canvas id="structureChart"></canvas>
                    </div>
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between mb-2">
                            <span><i class="bi bi-circle-fill me-1" style="color: #0d6efd;"></i>Tiền phòng:</span>
                            <strong>@Model.DoanhThuPhong.ToString("N0") đ (@Model.TiLeDoanhThuPhong%)</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span><i class="bi bi-circle-fill me-1" style="color: #ff9800;"></i>Tiền dịch vụ:</span>
                            <strong>@Model.DoanhThuDichVu.ToString("N0") đ (@Model.TiLeDoanhThuDichVu%)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const labels7Ngay = @Html.Raw(JsonSerializer.Serialize(Model.Labels7Ngay));
            const dataPhong = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuPhong7Ngay));
            const dataDichVu = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuDichVu7Ngay));

            // 1. Biểu đồ cột 7 ngày gần nhất
            const ctxRev = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRev, {
                type: 'bar',
                data: {
                    labels: labels7Ngay,
                    datasets: [
                        {
                            label: 'Tiền phòng',
                            data: dataPhong,
                            backgroundColor: '#0d6efd',
                            borderRadius: 6
                        },
                        {
                            label: 'Tiền dịch vụ',
                            data: dataDichVu,
                            backgroundColor: '#ff9800',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return (value / 1000000) + ' Tr';
                                }
                            }
                        }
                    }
                }
            });

            // 2. Biểu đồ tròn Donut (Cơ cấu doanh thu) - Ép màu trực tiếp cam cho dịch vụ
            const doanhThuPhongVal = Number('@Model.DoanhThuPhong'.toString().replace(/\./g, '').replace(',', '.'));
            const doanhThuDichVuVal = Number('@Model.DoanhThuDichVu'.toString().replace(/\./g, '').replace(',', '.'));

            const ctxStruct = document.getElementById('structureChart').getContext('2d');
            new Chart(ctxStruct, {
                type: 'doughnut',
                data: {
                    labels: ['Tiền phòng', 'Tiền dịch vụ'],
                    datasets: [{
                        data: [doanhThuPhongVal, doanhThuDichVuVal],
                        backgroundColor: ['#0d6efd', '#ff9800'],
                        borderColor: '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
}

<style>
    @@media print {
        .d-print-none,
        nav,
        footer,
        aside,
        .sidebar,
        .navbar,
        header,
        .main-sidebar,
        .main-header,
        .input-group,
        button {
            display: none !important;
        }

        body {
            background-color: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .container-fluid {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .card {
            border: 1px solid #dee2e6 !important;
            box-shadow: none !important;
        }
    }
</style>