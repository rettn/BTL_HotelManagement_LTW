@model HotelManagement.ViewModels.EditScheduleViewModel
@{
    ViewData["Title"] = "Chỉnh sửa ca";
}
<div class="container-fluid px-0"><div class="mb-4"><h2 class="fw-bold">Chỉnh sửa ca làm</h2><p class="text-muted">Thay đổi nhân viên, ca, ngày làm hoặc trạng thái.</p></div>
    <div class="card border-0 shadow-sm" style="max-width:800px;border-radius:13px"><div class="card-body p-4">
        <form asp-action="EditSchedule" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3"><div class="col-md-6"><label asp-for="EmployeeId" class="form-label">Nhân viên</label><select asp-for="EmployeeId" class="form-select">@foreach(var employee in Model.Employees){<option value="@employee.Id">NV@(employee.Id.ToString("D4")) · @employee.Name · @employee.Position</option>}</select><span asp-validation-for="EmployeeId" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="ShiftId" class="form-label">Ca làm</label><select asp-for="ShiftId" class="form-select">@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name (@shift.Start.ToString(@"hh\:mm")–@shift.End.ToString(@"hh\:mm"))</option>}</select><span asp-validation-for="ShiftId" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Date" class="form-label">Ngày làm</label><input asp-for="Date" type="date" class="form-control"/><span asp-validation-for="Date" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Status" class="form-label">Trạng thái</label><select asp-for="Status" class="form-select"><option value="ChoXacNhan">Chờ xác nhận</option><option value="DaXacNhan">Đã xác nhận</option><option value="TuChoi">Từ chối</option></select></div>
            <div class="col-12"><label asp-for="Note" class="form-label">Ghi chú</label><input asp-for="Note" class="form-control"/></div></div>
            <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" asp-route-weekStart="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-light border">Hủy</a><button class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Lưu ca</button></div>
        </form>
    </div></div>
</div>
