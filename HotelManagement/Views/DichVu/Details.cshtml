@model HotelManagement.Models.DichVu
@{
    ViewData["Title"] = "Dịch vụ";
}
<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Chi tiết dịch vụ</h2>
            
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <strong>Thông tin chi tiết</strong>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 mb-3 text-muted">Mã dịch vụ</dt>
                <dd class="col-sm-9 mb-3 fw-semibold">@Model.Id</dd>

                <dt class="col-sm-3 mb-3 text-muted">Tên dịch vụ</dt>
                <dd class="col-sm-9 mb-3 fw-bold text-primary">@Model.TenDichVu</dd>

                <dt class="col-sm-3 mb-3 text-muted">Giá hiện tại</dt>
                <dd class="col-sm-9 mb-3 text-danger fw-semibold">@Model.Gia.ToString("N0") VNĐ</dd>

                <dt class="col-sm-3 mb-3 text-muted">Mô tả</dt>
                <dd class="col-sm-9 mb-3">
                    @(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có thông tin mô tả." : Model.MoTa)
                </dd>

                <dt class="col-sm-3 mb-3 text-muted">Trạng thái</dt>
                <dd class="col-sm-9 mb-3">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng kinh doanh</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light py-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark me-2">Sửa dịch vụ</a>
            <a asp-action="Index" class="btn btn-light border">Quay lại</a>
        </div>
    </div>
</div>