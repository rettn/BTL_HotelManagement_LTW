@model HotelManagement.ViewModels.DichVuFormViewModel
@{
    ViewData["Title"] = "Dịch vụ & Hàng hóa";
    var groups = ViewBag.NhomHangs as List<string> ?? new();
}
<style>
    .goods-form-page{color:#263449}.goods-form-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.goods-form-head h2{margin:0 0 4px;font-size:24px;font-weight:700}.goods-form-head p{margin:0;color:#748198}.goods-form-card{max-width:960px;border:1px solid #e2e8f0;border-radius:14px;background:#fff;overflow:hidden}.goods-form-tabs{display:flex;gap:6px;padding:10px 22px 0;border-bottom:1px solid #e6ebf1}.goods-tab{padding:11px 13px;border:0;border-bottom:3px solid transparent;background:none;color:#64748b;font-weight:600}.goods-tab.active{border-color:#198754;color:#198754}.goods-form-body{padding:24px}.goods-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.goods-form-field label{display:block;margin-bottom:6px;font-size:13px;font-weight:650;color:#475569}.goods-form-field .form-control,.goods-form-field .form-select{min-height:43px;border-color:#dce3ed;border-radius:8px}.goods-form-field textarea{min-height:112px}.goods-form-help{margin-top:5px;color:#8390a3;font-size:11px}.goods-upload{display:flex;align-items:center;gap:18px;padding:16px;border:1px dashed #b9c7d6;border-radius:12px;background:#f9fbfd}.goods-upload-preview{width:120px;height:120px;display:grid;place-items:center;overflow:hidden;border-radius:11px;background:#eef2f6;color:#9aa5b1;font-size:30px}.goods-upload-preview img{width:100%;height:100%;object-fit:cover}.goods-upload-action{flex:1}.goods-form-footer{display:flex;justify-content:flex-end;gap:9px;padding:16px 24px;border-top:1px solid #e8edf2;background:#fbfcfd}.goods-form-section{margin-top:22px;padding:18px;border:1px solid #e2e8f0;border-radius:11px}.goods-form-section h3{margin:0 0 14px;font-size:15px;font-weight:700}.goods-stock-fields{display:none}.goods-stock-fields.show{display:grid}.goods-sell-toggle{display:flex;align-items:center;gap:10px;margin-top:17px}.goods-tab-panel[hidden]{display:none!important}
    @@media(max-width:650px){.goods-form-body{padding:17px}.goods-form-grid{grid-template-columns:1fr}.goods-upload{align-items:flex-start;flex-direction:column}.goods-form-head{align-items:flex-start}}
</style>
<div class="goods-form-page">
    <div class="goods-form-head"><div><h2>Cập nhật dịch vụ / hàng hóa</h2><p>Chỉnh sửa thông tin mặt hàng: @Model.TenDichVu</p></div><a asp-action="Index" class="btn btn-light border">Quay lại</a></div>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="goods-form-card">
        <input asp-for="Id" type="hidden" />
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3"></div>
        <div class="goods-form-tabs"><button type="button" class="goods-tab active" data-tab="basic">Thông tin</button><button type="button" class="goods-tab" data-tab="media">Hình ảnh, mô tả, ghi chú</button></div>
        <div class="goods-form-body">
            <section class="goods-tab-panel" data-panel="basic">
                <div class="goods-form-grid">
                    <div class="goods-form-field"><label asp-for="TenDichVu">Tên hàng</label><input asp-for="TenDichVu" class="form-control" placeholder="Ví dụ: Nước suối, giặt ủi..." /><span asp-validation-for="TenDichVu" class="text-danger small"></span></div>
                    <div class="goods-form-field"><label>Loại hàng</label><select asp-for="LoaiHang" id="LoaiHang" class="form-select"><option value="DichVu">Dịch vụ</option><option value="SanPham">Sản phẩm</option></select></div>
                    <div class="goods-form-field"><label>Mã hàng</label><input class="form-control" value="Tự động khi lưu" disabled /><div class="goods-form-help">Mã DV/SP được tạo tự động.</div></div>
                    <div class="goods-form-field"><label asp-for="NhomHang">Nhóm hàng</label><input asp-for="NhomHang" list="goodsGroups" class="form-control" placeholder="Dịch vụ, đồ ăn, đồ uống..." /><datalist id="goodsGroups">@foreach(var group in groups){<option value="@group"></option>}</datalist></div>
                    <div class="goods-form-field"><label asp-for="DonViTinh">Đơn vị tính</label><input asp-for="DonViTinh" class="form-control" placeholder="Lần, gói, chai..." /></div>
                    <div class="goods-form-field goods-stock-fields" id="stockFields"><label asp-for="TonKho">Số lượng tồn kho</label><input asp-for="TonKho" type="number" min="0" class="form-control" /><span asp-validation-for="TonKho" class="text-danger small"></span></div>
                </div>
                <div class="goods-form-section"><h3>Giá bán, giá vốn</h3><div class="goods-form-grid"><div class="goods-form-field"><label asp-for="Gia">Giá bán</label><div class="input-group"><input asp-for="Gia" type="number" min="0" step="1" class="form-control" /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="Gia" class="text-danger small"></span></div><div class="goods-form-field"><label asp-for="GiaVon">Giá vốn</label><div class="input-group"><input asp-for="GiaVon" type="number" min="0" step="1" class="form-control" /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="GiaVon" class="text-danger small"></span></div></div></div>
                <div class="goods-sell-toggle"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Cho phép kinh doanh</label></div>
            </section>
            <section class="goods-tab-panel" data-panel="media" hidden>
                <div class="goods-form-field"><label asp-for="Anh">Ảnh dịch vụ / sản phẩm</label><div class="goods-upload"><div class="goods-upload-preview" id="imagePreview">@if (!string.IsNullOrEmpty(Model.AnhUrl)){<img src="@Model.AnhUrl" alt="Ảnh hiện tại" />}else{<i class="bi bi-image"></i>}</div><div class="goods-upload-action"><input asp-for="Anh" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" id="imageInput" /><div class="goods-form-help">JPG, PNG hoặc WEBP · tối đa 5 MB. Ảnh sẽ xuất hiện trong danh sách và khi thêm vào phòng.</div><span asp-validation-for="Anh" class="text-danger small"></span></div></div></div>
                <div class="goods-form-field mt-3"><label asp-for="MoTa">Mô tả / ghi chú</label><textarea asp-for="MoTa" class="form-control" rows="5" placeholder="Thông tin phục vụ nhân viên khi ghi nhận dịch vụ..."></textarea><span asp-validation-for="MoTa" class="text-danger small"></span></div>
            </section>
        </div>
        <div class="goods-form-footer"><a asp-action="Index" class="btn btn-light border">Hủy</a><button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RichTextEditor" />
    <script>
        document.querySelectorAll('.goods-tab').forEach(tab => tab.addEventListener('click', () => { document.querySelectorAll('.goods-tab').forEach(x => x.classList.toggle('active', x === tab)); document.querySelectorAll('.goods-tab-panel').forEach(panel => panel.hidden = panel.dataset.panel !== tab.dataset.tab); }));
        const typeSelect = document.getElementById('LoaiHang'); const stockFields = document.getElementById('stockFields');
        function updateType() { const product = typeSelect.value === 'SanPham'; stockFields.classList.toggle('show', product); }
        typeSelect.addEventListener('change', updateType); updateType();
        document.getElementById('imageInput').addEventListener('change', event => { const file = event.target.files[0]; if (!file) return; const img = document.createElement('img'); img.src = URL.createObjectURL(file); img.onload = () => URL.revokeObjectURL(img.src); const box = document.getElementById('imagePreview'); box.replaceChildren(img); });
    </script>
}
