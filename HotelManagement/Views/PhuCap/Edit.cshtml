@model HotelManagement.Models.PhuCap
@{ ViewData["Title"] = "Sửa phụ cấp"; }
<div class="container-fluid px-0"><div class="mb-4"><h3 class="fw-bold mb-1">Sửa phụ cấp</h3><p class="text-muted mb-0">Cập nhật thông tin khoản phụ cấp.</p></div><div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Edit" asp-route-id="@Model.MaPhuCap" method="post">@Html.AntiForgeryToken()<input asp-for="MaPhuCap" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="MaNV" class="form-label">Nhân viên</label><select asp-for="MaNV" class="form-select" asp-items="@(new SelectList(ViewBag.NhanViens, "MaNV", "HoTen"))"><option value="">-- Chọn nhân viên --</option></select><span asp-validation-for="MaNV" class="text-danger small"></span></div><div class="col-md-3"><label asp-for="Thang" class="form-label">Tháng</label><select asp-for="Thang" class="form-select">@for(var i=1;i<=12;i++){<option value="@i">Tháng @i</option>}</select><span asp-validation-for="Thang" class="text-danger small"></span></div><div class="col-md-3"><label asp-for="Nam" class="form-label">Năm</label><input asp-for="Nam" type="number" min="2000" max="2100" class="form-control"/><span asp-validation-for="Nam" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="TenPhuCap" class="form-label">Tên phụ cấp</label><input asp-for="TenPhuCap" class="form-control"/><span asp-validation-for="TenPhuCap" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="SoTien" class="form-label">Số tiền (VNĐ)</label><input asp-for="SoTien" type="number" min="0.01" step="0.01" class="form-control"/><span asp-validation-for="SoTien" class="text-danger small"></span></div><div class="col-12"><label asp-for="LyDo" class="form-label">Lý do</label><textarea asp-for="LyDo" class="form-control" rows="3"></textarea><span asp-validation-for="LyDo" class="text-danger small"></span></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button><a asp-action="Index" asp-route-thang="@Model.Thang" asp-route-nam="@Model.Nam" class="btn btn-outline-secondary">Hủy</a></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
