@model HotelManagement.Models.BangLuong
@{ ViewData["Title"] = "Quản lý bảng lương"; }
<div class="container-fluid px-0">
    <div class="mb-4"><h3 class="fw-bold mb-1">Chi tiết bảng lương</h3>
    <div class="card border-0 shadow-sm" id="payrollSlip"><div class="card-header bg-white p-4"><div class="d-flex flex-wrap justify-content-between gap-3"><div><div class="text-primary small fw-semibold text-uppercase">Phiếu lương</div><h3 class="fw-bold mb-1">Tháng @Model.Thang/@Model.Nam</h3><span class="text-muted">Mã bảng lương: #@Model.MaBangLuong</span></div><div>@if(Model.TrangThai == "DaThanhToan"){<span class="badge bg-success-subtle text-success fs-6">Đã thanh toán</span>}else{<span class="badge bg-warning-subtle text-warning-emphasis fs-6">Chưa thanh toán</span>}</div></div></div><div class="card-body p-4"><div class="row g-3 mb-4"><div class="col-md-6"><div class="text-muted small">Nhân viên</div><div class="fw-semibold">@(Model.NhanVien?.HoTen ?? "—")</div><div class="text-muted">Mã NV: @($"NV{Model.MaNV:D4}") · @(Model.NhanVien?.ChucVu ?? "")</div></div><div class="col-md-6"><div class="text-muted small">Ngày công</div><div class="fw-semibold">@Model.NgayCongThucTe.ToString("0.##") / @Model.NgayCongQuyDinh ngày</div></div></div><div class="table-responsive"><table class="table align-middle"><tbody><tr><th>Lương cơ bản</th><td class="text-end">@Model.LuongCoBan.ToString("N0") đ</td></tr><tr><th>Lương theo công</th><td class="text-end">@Model.LuongTheoCong.ToString("N0") đ</td></tr><tr><th>Tổng thưởng</th><td class="text-end">@Model.TongThuong.ToString("N0") đ</td></tr><tr><th>Tổng phụ cấp</th><td class="text-end">@Model.TongPhuCap.ToString("N0") đ</td></tr><tr><th>Tổng khấu trừ</th><td class="text-end text-danger">−@Model.TongKhauTru.ToString("N0") đ</td></tr></tbody></table></div><div class="rounded-3 bg-success-subtle p-4 d-flex justify-content-between align-items-center"><span class="fw-semibold text-success">THỰC LĨNH</span><strong class="fs-3 text-success">@Model.ThucLinh.ToString("N0") đ</strong></div><div class="row mt-4 text-muted small"><div class="col-md-6">Ngày tạo: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</div><div class="col-md-6">Ngày thanh toán: @(Model.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</div></div></div><div class="card-footer bg-white d-flex justify-content-between"><a asp-action="Index" asp-route-thang="@Model.Thang" asp-route-nam="@Model.Nam" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a><button class="btn btn-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-1"></i>In phiếu lương</button></div></div></div>
@section Styles { <style>@@media print { body { background:#fff !important; } .admin-sidebar,.admin-topbar,.admin-footer,.card-footer,.content-heading { display:none !important; } .admin-main { margin:0 !important; } .admin-content { padding:0 !important; } .card { box-shadow:none !important; } }</style> }
