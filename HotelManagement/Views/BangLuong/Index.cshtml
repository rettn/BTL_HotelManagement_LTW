@model HotelManagement.ViewModels.BangLuongIndexViewModel
@{ ViewData["Title"] = "Quản lý bảng lương"; }
<div class="container-fluid px-0">
    <div class="mb-4"><h3 class="fw-bold mb-1">Bảng lương</h3></div>
    <div class="card border-0 shadow-sm mb-3"><div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3"><label class="form-label" for="thang">Tháng</label><select id="thang" name="thang" class="form-select">@for (var i=1;i<=12;i++){<option value="@i" selected="@(Model.Thang == i)">Tháng @i</option>}</select></div>
            <div class="col-sm-4 col-md-3"><label class="form-label" for="nam">Năm</label><input id="nam" name="nam" type="number" min="2000" max="2100" value="@Model.Nam" class="form-control" /></div>
            <div class="col-auto"><button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Lọc dữ liệu</button></div>
        </form>
    </div></div>
    <div class="row g-3 mb-4"><div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body d-flex align-items-center gap-3"><span class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-people fs-4"></i></span><div><div class="text-muted small">Nhân viên có bảng lương</div><div class="fs-3 fw-bold">@Model.TongNhanVien</div></div></div></div></div><div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body d-flex align-items-center gap-3"><span class="rounded-3 bg-success-subtle text-success p-3"><i class="bi bi-cash-stack fs-4"></i></span><div><div class="text-muted small">Tổng quỹ lương</div><div class="fs-3 fw-bold">@Model.TongLuong.ToString("N0") đ</div></div></div></div></div></div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white py-3"><strong><i class="bi bi-calculator me-2 text-primary"></i>Tính lương tháng @Model.Thang/@Model.Nam</strong></div><div class="card-body">
        @if (!Model.NhanViens.Any()) { <div class="text-center text-muted py-3"><i class="bi bi-person-x fs-3 d-block mb-2"></i>Không có nhân viên đang làm việc.</div> }
        else { <form asp-action="Calculate" method="post" id="calculatePayroll">@Html.AntiForgeryToken()<input type="hidden" name="thang" value="@Model.Thang"/><input type="hidden" name="nam" value="@Model.Nam"/><div class="row g-3 align-items-end mb-3"><div class="col-sm-5 col-md-3"><label class="form-label" for="ngayCongQuyDinh">Ngày công quy định</label><input id="ngayCongQuyDinh" name="ngayCongQuyDinh" type="number" min="1" max="31" value="@Model.NgayCongQuyDinh" class="form-control" required/></div><div class="col-auto"><button type="submit" class="btn btn-primary" onclick="return confirm('Xác nhận tính lương cho tháng @Model.Thang/@Model.Nam?');"><i class="bi bi-calculator me-1"></i>Tính lương</button></div></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Mã NV</th><th>Nhân viên</th><th>Chức vụ</th><th style="width:180px">Ngày công thực tế</th></tr></thead><tbody>@foreach(var nv in Model.NhanViens){<tr><td class="fw-semibold">@($"NV{nv.MaNV:D4}")</td><td>@nv.HoTen</td><td>@nv.ChucVu</td><td><input class="form-control form-control-sm" type="number" name="ngayCongThucTe[@nv.MaNV]" min="0" max="31" step="0.5" value="" placeholder="Ngày công" aria-label="Ngày công thực tế của @nv.HoTen" required/></td></tr>}</tbody></table></div></form> }
    </div></div>
    <div class="card border-0 shadow-sm"><div class="card-header bg-white py-3"><strong>Bảng lương tháng @Model.Thang/@Model.Nam</strong></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>STT</th><th>Mã NV</th><th>Họ tên</th><th>Lương cơ bản</th><th>Ngày công</th><th>Lương theo công</th><th>Thưởng</th><th>Phụ cấp</th><th>Khấu trừ</th><th>Thực lĩnh</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @if(Model.BangLuongs.Any()){var stt=0;foreach(var b in Model.BangLuongs){stt++;<tr><td>@stt</td><td>NV@(b.MaNV.ToString("D4"))</td><td class="fw-semibold">@(b.NhanVien?.HoTen ?? "—")</td><td class="text-nowrap">@b.LuongCoBan.ToString("N0") đ</td><td>@b.NgayCongThucTe.ToString("0.##") / @b.NgayCongQuyDinh</td><td class="text-nowrap">@b.LuongTheoCong.ToString("N0") đ</td><td class="text-nowrap">@b.TongThuong.ToString("N0") đ</td><td class="text-nowrap">@b.TongPhuCap.ToString("N0") đ</td><td class="text-nowrap">@b.TongKhauTru.ToString("N0") đ</td><td class="text-nowrap fw-semibold text-success">@b.ThucLinh.ToString("N0") đ</td><td>@if(b.TrangThai == "DaThanhToan"){<span class="badge bg-success-subtle text-success">Đã thanh toán</span>}else{<span class="badge bg-warning-subtle text-warning-emphasis">Chưa thanh toán</span>}</td><td><a asp-action="Details" asp-route-id="@b.MaBangLuong" class="btn btn-sm btn-outline-primary" title="Xem chi tiết"><i class="bi bi-eye"></i></a></td></tr>}}</tbody>
    @if(!Model.BangLuongs.Any()){<tr><td colspan="12" class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Chưa có bảng lương trong kỳ này.</td></tr>}
    </table></div></div></div>
</div>
