@model HotelManagement.ViewModels.BangLuongIndexViewModel
@{
    ViewData["Title"] = "Quản lý bảng lương";
    var paid = Model.BangLuongs.Count(x => x.TrangThai == "DaThanhToan");
    var unpaid = Model.BangLuongs.Count - paid;
}
<style>
.payroll-page{color:#263449}.payroll-head,.payroll-actions,.payroll-toolbar,.payroll-panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.payroll-head{margin-bottom:16px}.payroll-head h2{font-size:24px;font-weight:700;margin:0 0 4px}.payroll-head p{margin:0;color:#748198}.payroll-period{display:inline-flex;align-items:center;gap:7px;border:1px solid #cfe8d8;background:#f1faf4;color:#198754;border-radius:20px;padding:7px 12px;font-size:12px;font-weight:650}.payroll-tools{padding:13px;margin-bottom:14px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.payroll-toolbar{justify-content:flex-start}.payroll-field{min-width:150px}.payroll-field label{display:block;margin:0 0 5px;color:#65748b;font-size:12px;font-weight:650}.payroll-field .form-select,.payroll-field .form-control{height:40px;border-color:#dce3ed;border-radius:8px}.payroll-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}.payroll-stat{position:relative;padding:15px 17px;border:1px solid #e2e8f0;border-radius:11px;background:#fff}.payroll-stat span{display:block;color:#718096;font-size:12px}.payroll-stat strong{display:block;margin-top:5px;font-size:22px}.payroll-stat i{position:absolute;top:14px;right:17px;color:#198754;font-size:20px}.payroll-panel{overflow:hidden;border:1px solid #e2e8f0;border-radius:13px;background:#fff;margin-bottom:15px}.payroll-panel-title{padding:14px 17px;border-bottom:1px solid #edf0f5}.payroll-panel-title h3{font-size:15px;font-weight:700;margin:0}.payroll-panel-title span{font-size:12px;color:#748198}.payroll-panel-body{padding:16px}.payroll-calc-options{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-bottom:13px}.payroll-field.compact{width:190px}.payroll-table-wrap{overflow:auto}.payroll-table{width:100%;min-width:860px;border-collapse:collapse}.payroll-table th{padding:12px;background:#e9f5ee;color:#41516a;text-align:left;font-size:12px;white-space:nowrap}.payroll-table td{padding:10px 12px;border-top:1px solid #edf0f5;vertical-align:middle;font-size:13px}.payroll-table tbody tr:hover td{background:#f8fbf9}.payroll-code{color:#198754;font-weight:700}.payroll-employee{font-weight:650}.payroll-muted{display:block;margin-top:2px;font-size:11px;color:#8290a5}.payroll-input{max-width:150px;min-width:100px}.payroll-input.form-control{height:36px;border-color:#dce3ed;border-radius:7px}.payroll-status{display:inline-flex;padding:5px 9px;border-radius:14px;font-size:11px;font-weight:650;white-space:nowrap}.payroll-status.paid{background:#e9f7ee;color:#16804a}.payroll-status.unpaid{background:#fff5df;color:#a76a00}.payroll-total{font-weight:700;color:#198754;white-space:nowrap}.payroll-empty{padding:42px 12px;text-align:center;color:#8290a5}.payroll-footer{display:flex;justify-content:space-between;gap:10px;padding:11px 14px;border-top:1px solid #edf0f5;color:#748198;font-size:12px}.payroll-actions{justify-content:flex-end}.payroll-alert{margin-bottom:12px}@@media(max-width:820px){.payroll-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.payroll-head{align-items:flex-start}.payroll-field.compact{width:calc(50% - 8px)}}
</style>
<div class="payroll-page">
    <div class="payroll-head"><div><h2>Bảng lương nhân viên</h2><p>Tính và theo dõi lương theo kỳ hàng tháng</p></div><span class="payroll-period"><i class="bi bi-calendar3"></i>Kỳ lương @Model.Thang/@Model.Nam</span></div>
    @if(TempData["Success"] is string success){<div class="alert alert-success payroll-alert">@success</div>}
    @if(TempData["Error"] is string error){<div class="alert alert-danger payroll-alert">@error</div>}
    <div class="payroll-tools"><form asp-action="Index" method="get" class="payroll-toolbar"><div class="payroll-field"><label for="thang">Tháng</label><select id="thang" name="thang" class="form-select">@for(var i=1;i<=12;i++){<option value="@i" selected="@(Model.Thang==i)">Tháng @i</option>}</select></div><div class="payroll-field"><label for="nam">Năm</label><input id="nam" name="nam" type="number" min="2000" max="2100" value="@Model.Nam" class="form-control"/></div><button class="btn btn-success align-self-end"><i class="bi bi-funnel me-1"></i>Xem kỳ lương</button><a asp-action="Index" asp-route-thang="@DateTime.Today.Month" asp-route-nam="@DateTime.Today.Year" class="btn btn-light border align-self-end">Kỳ hiện tại</a></form></div>
    <div class="payroll-summary"><div class="payroll-stat"><span>Nhân viên có bảng lương</span><strong>@Model.TongNhanVien</strong><i class="bi bi-people"></i></div><div class="payroll-stat"><span>Tổng thực lĩnh kỳ này</span><strong>@Model.TongLuong.ToString("N0") đ</strong><i class="bi bi-cash-stack"></i></div><div class="payroll-stat"><span>Chưa thanh toán</span><strong>@unpaid</strong><i class="bi bi-hourglass-split"></i></div><div class="payroll-stat"><span>Đã thanh toán</span><strong>@paid</strong><i class="bi bi-check-circle"></i></div></div>
    <section class="payroll-panel"><div class="payroll-panel-title"><h3><i class="bi bi-calculator me-2 text-success"></i>Tính lương tháng @Model.Thang/@Model.Nam</h3><span>@Model.NhanViens.Count nhân viên đang làm việc</span></div><div class="payroll-panel-body">
    @if(!Model.NhanViens.Any()){<div class="payroll-empty"><i class="bi bi-person-x fs-3 d-block mb-2"></i>Không có nhân viên đang làm việc.</div>}else{
        <form asp-action="Calculate" method="post" id="calculatePayroll">@Html.AntiForgeryToken()<input type="hidden" name="thang" value="@Model.Thang"/><input type="hidden" name="nam" value="@Model.Nam"/><div class="payroll-calc-options"><div class="payroll-field compact"><label for="ngayCongQuyDinh">Ngày công quy định</label><input id="ngayCongQuyDinh" name="ngayCongQuyDinh" type="number" min="1" max="31" value="@Model.NgayCongQuyDinh" class="form-control" required/></div><button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận tính lương cho tháng @Model.Thang/@Model.Nam?');"><i class="bi bi-calculator me-1"></i>Tính lương</button><span class="payroll-muted">Nhập ngày công thực tế của từng nhân viên trước khi tính.</span></div>
        <div class="payroll-table-wrap"><table class="payroll-table"><thead><tr><th>Mã NV</th><th>Nhân viên</th><th>Chức vụ</th><th>Ngày công thực tế</th></tr></thead><tbody>@foreach(var nv in Model.NhanViens){<tr><td class="payroll-code">NV@(nv.MaNV.ToString("D4"))</td><td class="payroll-employee">@nv.HoTen</td><td>@nv.ChucVu</td><td><input class="form-control payroll-input" type="number" name="ngayCongThucTe[@nv.MaNV]" min="0" max="31" step="0.5" placeholder="Ngày công" aria-label="Ngày công thực tế của @nv.HoTen" required/></td></tr>}</tbody></table></div></form>
    }</div></section>
    <section class="payroll-panel"><div class="payroll-panel-title"><h3>Kết quả bảng lương</h3><span>Tháng @Model.Thang/@Model.Nam</span></div><div class="payroll-table-wrap"><table class="payroll-table"><thead><tr><th>STT</th><th>Mã NV</th><th>Nhân viên</th><th>Lương cơ bản</th><th>Ngày công</th><th>Lương theo công</th><th>Thưởng</th><th>Phụ cấp</th><th>Khấu trừ</th><th>Thực lĩnh</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @if(Model.BangLuongs.Any()){var stt=0;foreach(var b in Model.BangLuongs){stt++;<tr><td>@stt</td><td class="payroll-code">NV@(b.MaNV.ToString("D4"))</td><td class="payroll-employee">@(b.NhanVien?.HoTen??"—")</td><td class="text-nowrap">@b.LuongCoBan.ToString("N0") đ</td><td>@b.NgayCongThucTe.ToString("0.##") / @b.NgayCongQuyDinh</td><td class="text-nowrap">@b.LuongTheoCong.ToString("N0") đ</td><td>@b.TongThuong.ToString("N0") đ</td><td>@b.TongPhuCap.ToString("N0") đ</td><td>@b.TongKhauTru.ToString("N0") đ</td><td class="payroll-total">@b.ThucLinh.ToString("N0") đ</td><td>@if(b.TrangThai=="DaThanhToan"){<span class="payroll-status paid">Đã thanh toán</span>}else{<span class="payroll-status unpaid">Chưa thanh toán</span>}</td><td><a asp-action="Details" asp-route-id="@b.MaBangLuong" class="btn btn-sm btn-outline-success" title="Xem chi tiết"><i class="bi bi-eye"></i></a></td></tr>}}
    else{<tr><td colspan="12"><div class="payroll-empty"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Chưa có bảng lương trong kỳ này.</div></td></tr>}
    </tbody></table></div><div class="payroll-footer"><span>Tổng <strong>@Model.BangLuongs.Count</strong> bảng lương</span><span>Thực lĩnh được tính sau thưởng, phụ cấp và khấu trừ.</span></div></section>
</div>
