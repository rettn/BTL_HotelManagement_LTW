@model HotelManagement.Models.NhanVien
@{
    ViewData["Title"] = "Quản lý nhân sự";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<style>
    .nv-salary-box {
        padding: 16px 18px;
        border: 1px solid #dcefe3;
        border-radius: 12px;
        background: #fbfefc;
    }

        .nv-salary-box .form-label {
            color: #166534;
            font-weight: 600;
        }

        .nv-salary-box .input-group-text {
            background: #e7f7ed;
            color: #15803d;
            font-weight: 700;
            border-color: #cfe9d9;
        }

        .nv-salary-box .form-control {
            border-color: #cfe9d9;
            font-weight: 600;
        }

            .nv-salary-box .form-control:focus {
                border-color: #198754;
                box-shadow: 0 0 0 .2rem rgba(25, 135, 84, .15);
            }

    #luongHint {
        margin-top: 8px;
        font-size: 13px;
        color: #64748b;
    }
</style>

<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h3 class="fw-bold mt-3">
            <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa nhân viên
        </h3>
        <p class="text-muted">Cập nhật thông tin của nhân viên NV@Model.MaNV.ToString("D4").</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MaNV" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaNV" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ChucVu" class="form-label">Chức vụ <span class="text-danger">*</span></label>
                        <select asp-for="ChucVu" class="form-select" id="chucVuSelect">
                            <option value="" data-luong="0">-- Chọn chức vụ --</option>
                            @foreach (ChucVu cv in ViewBag.ChucVus)
                            {
                                if (cv.TrangThai ||
                                cv.TenChucVu == Model.ChucVu)
                                {
                                    <option value="@cv.TenChucVu"
                                            data-luong="@cv.LuongCoBanMacDinh.ToString("0.##", inv)">
                                        @cv.TenChucVu
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ChucVu" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="nv-salary-box">
                            <label asp-for="LuongCoBan" class="form-label">
                                <i class="bi bi-cash-coin me-1"></i>Lương cơ bản thực tế (VNĐ)
                            </label>
                            <div class="input-group">
                                <input asp-for="LuongCoBan" id="luongInput" type="number" min="0" step="any"
                                       class="form-control" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <div id="luongHint" class="d-none"></div>
                            <span asp-validation-for="LuongCoBan" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgayVaoLam" class="form-label">Ngày vào làm</label>
                        <input asp-for="NgayVaoLam" type="date" asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="NgayVaoLam" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="TrangThai" class="form-check-input" />
                            <label asp-for="TrangThai" class="form-check-label">Đang làm việc</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const select = document.getElementById('chucVuSelect');
            const luong = document.getElementById('luongInput');
            const hint = document.getElementById('luongHint');
            const fmt = n => Number(n).toLocaleString('vi-VN') + ' đ';

            // Sua nhan vien: GIU luong thuc te hien tai, chi goi y muc mac dinh.
            // Luong chi doi khi quan tri vien tu sua o nhap hoac bam "Dung muc nay".
            function capNhatGoiY() {
                const macDinh = parseFloat(select.selectedOptions[0]?.dataset.luong || '0');
                const hienTai = parseFloat(luong.value || '0');

                if (macDinh > 0 && macDinh !== hienTai) {
                    hint.innerHTML = '<i class="bi bi-lightbulb text-warning me-1"></i>' +
                        'Lương mặc định của chức vụ: <strong>' + fmt(macDinh) + '</strong> ' +
                        '<button type="button" class="btn btn-link btn-sm p-0 ms-1" id="btnDungMacDinh">Dùng mức này</button>';
                    hint.classList.remove('d-none');
                    document.getElementById('btnDungMacDinh').onclick = function () {
                        luong.value = macDinh;
                        capNhatGoiY();
                    };
                } else {
                    hint.classList.add('d-none');
                }
            }

            select.addEventListener('change', capNhatGoiY);
            luong.addEventListener('input', capNhatGoiY);
            capNhatGoiY();
        })();
    </script>
}
