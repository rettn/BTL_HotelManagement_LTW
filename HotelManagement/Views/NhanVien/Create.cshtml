
@model HotelManagement.Models.NhanVien
@{
    ViewData["Title"] = "Thêm nhân viên";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<style>
    .nv-salary-box {
        padding: 16px 18px;
        border: 1px solid #dcefe3;
        border-radius: 12px;
        background: #fbfefc;
    }

        .nv-salary-box .form-label {
            color: #166534;
            font-weight: 600;
        }

        .nv-salary-box .input-group-text {
            background: #e7f7ed;
            color: #15803d;
            font-weight: 700;
            border-color: #cfe9d9;
        }

        .nv-salary-box .form-control {
            border-color: #cfe9d9;
            font-weight: 600;
        }

            .nv-salary-box .form-control:focus {
                border-color: #198754;
                box-shadow: 0 0 0 .2rem rgba(25, 135, 84, .15);
            }

    #luongHint {
        margin-top: 8px;
        font-size: 13px;
        color: #64748b;
    }

    .nv-flash {
        animation: nvFlash .9s ease-out;
    }

    @@keyframes nvFlash {
        from {
            background: #bbf7d0;
        }

        to {
            background: #fff;
        }
    }
</style>

<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h3 class="fw-bold mt-3">
            <i class="bi bi-person-plus me-2"></i>Thêm nhân viên
        </h3>
        <p class="text-muted">Nhập thông tin nhân viên mới của khách sạn.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ChucVu" class="form-label">Chức vụ <span class="text-danger">*</span></label>
                        <select asp-for="ChucVu" class="form-select" id="chucVuSelect">
                            <option value="" data-luong="0">-- Chọn chức vụ --</option>
                            @foreach (ChucVu cv in ViewBag.ChucVus)
                            {
                                if (cv.TrangThai ||
                                cv.TenChucVu == Model.ChucVu)
                                {
                                    <option value="@cv.TenChucVu"
                                            data-luong="@cv.LuongCoBanMacDinh.ToString("0.##", inv)">
                                        @cv.TenChucVu
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ChucVu" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="nv-salary-box">
                            <label asp-for="LuongCoBan" class="form-label">
                                <i class="bi bi-cash-coin me-1"></i>Lương cơ bản (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="LuongCoBan" id="luongInput" type="number" min="0" step="1000"
                                       class="form-control" placeholder="Chọn chức vụ để tự điền" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <div id="luongHint">
                                <i class="bi bi-info-circle me-1"></i>Tự điền theo chức vụ, bạn vẫn có thể chỉnh lại.
                            </div>
                            <span asp-validation-for="LuongCoBan" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgayVaoLam" class="form-label">Ngày vào làm</label>
                        <input asp-for="NgayVaoLam" type="date" asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="NgayVaoLam" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="TrangThai" class="form-check-input" />
                            <label asp-for="TrangThai" class="form-check-label">Đang làm việc</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu nhân viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const select = document.getElementById('chucVuSelect');
            const luong = document.getElementById('luongInput');
            const hint = document.getElementById('luongHint');
            const fmt = n => Number(n).toLocaleString('vi-VN') + ' đ';

            // Chon chuc vu -> tu dien luong co ban mac dinh
            select.addEventListener('change', function () {
                const value = parseFloat(this.selectedOptions[0].dataset.luong || '0');

                if (!this.value) {
                    hint.innerHTML = '<i class="bi bi-info-circle me-1"></i>' +
                        'Tự điền theo chức vụ, bạn vẫn có thể chỉnh lại.';
                    return;
                }

                if (value > 0) {
                    luong.value = value;
                    luong.classList.remove('nv-flash');
                    void luong.offsetWidth;
                    luong.classList.add('nv-flash');
                    hint.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>' +
                        'Đã điền lương mặc định của chức vụ: <strong>' + fmt(value) + '</strong>';
                } else {
                    hint.innerHTML = '<i class="bi bi-exclamation-circle text-warning me-1"></i>' +
                        'Chức vụ này chưa có lương mặc định, vui lòng nhập tay.';
                }
            });
        })();
    </script>
}
