@model IEnumerable<HotelManagement.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân sự";
}

<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                Quản lý nhân sự
            </h3>
            <p class="text-muted mb-0">Quản lý thông tin và trạng thái nhân viên khách sạn.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="ChucVu" asp-action="Index"
               class="btn btn-outline-primary">
                <i class="bi bi-person-workspace me-1"></i>
                Quản lý chức vụ
            </a>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i>
                Thêm nhân viên
            </a>
        </div>
    </div>


    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng nhân viên</div>
                        <div class="fs-3 fw-bold">@ViewBag.TongNhanVien</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đang làm việc</div>
                        <div class="fs-3 fw-bold">@ViewBag.DangLam</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-secondary-subtle text-secondary p-3">
                        <i class="bi bi-person-dash fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đã nghỉ việc</div>
                        <div class="fs-3 fw-bold">@ViewBag.DaNghi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 mb-4">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Tìm theo mã NV, tên, chức vụ, email, số điện thoại..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ tên</th>
                            <th>Chức vụ</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Lương cơ bản</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var nv in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@($"NV{nv.MaNV:D4}")</td>
                                <td>
                                    <div class="fw-semibold">@nv.HoTen</div>
                                    <small class="text-muted">
                                        @(nv.GioiTinh ?? "Chưa cập nhật")
                                    </small>
                                </td>
                                <td>@nv.ChucVu</td>
                                <td>@(nv.SoDienThoai ?? "—")</td>
                                <td>@(nv.Email ?? "—")</td>
                                <td class="text-nowrap">
                                    @nv.LuongCoBan.ToString("N0") đ
                                </td>
                                <td>
                                    @if (nv.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Đang làm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            Đã nghỉ
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@nv.MaNV"
                                           class="btn btn-sm btn-outline-info"
                                           title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@nv.MaNV"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ChangeStatus" asp-route-id="@nv.MaNV"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái nhân viên này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm @(nv.TrangThai ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(nv.TrangThai ? "Cho nghỉ việc" : "Kích hoạt lại")">
                                                <i class="bi @(nv.TrangThai ? "bi-person-dash" : "bi-person-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy nhân viên phù hợp.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="text-muted small">
                Tổng số: @(Model?.Count() ?? 0) nhân viên
            </div>
        </div>
    </div>
</div>
