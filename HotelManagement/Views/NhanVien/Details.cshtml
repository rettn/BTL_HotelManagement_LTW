
@model HotelManagement.Models.NhanVien

@{
    ViewData["Title"] = "Quản lý nhân sự";
}

<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h3 class="fw-bold mt-3">
            <i class="bi bi-person-vcard me-2"></i>Chi tiết nhân viên
        </h3>
        <p class="text-muted">Thông tin hồ sơ nhân viên NV@Model.MaNV.ToString("D4").</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                     style="width:72px;height:72px;">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">@Model.HoTen</h4>
                    <div class="text-muted">@Model.ChucVu</div>
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success-subtle text-success mt-2">Đang làm việc</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary mt-2">Đã nghỉ việc</span>
                    }
                </div>
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Mã nhân viên</div>
                    <div class="fw-semibold">NV@Model.MaNV.ToString("D4")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Giới tính</div>
                    <div class="fw-semibold">@(Model.GioiTinh ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Ngày sinh</div>
                    <div class="fw-semibold">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Số điện thoại</div>
                    <div class="fw-semibold">@(Model.SoDienThoai ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Email</div>
                    <div class="fw-semibold">@(Model.Email ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Địa chỉ</div>
                    <div class="fw-semibold">@(Model.DiaChi ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Lương cơ bản</div>
                    <div class="fw-semibold text-primary">@Model.LuongCoBan.ToString("N0") đ</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Ngày vào làm</div>
                    <div class="fw-semibold">@Model.NgayVaoLam.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model.MaNV" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>
