@model HotelManagement.ViewModels.NhapKhoFormViewModel
@{
    ViewData["Title"] = "Quản lý kho";
    var products = ViewBag.Products as List<HotelManagement.Models.DichVu> ?? new();
}
<style>
.receive-page{max-width:1120px;color:#263449}.receive-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.receive-head h2{font-size:24px;font-weight:700;margin:0 0 4px}.receive-head p{margin:0;color:#748198}.receive-card{border:1px solid #e2e8f0;border-radius:14px;background:#fff;overflow:hidden;margin-bottom:16px}.receive-card-head{padding:15px 19px;border-bottom:1px solid #edf0f5;display:flex;align-items:center;justify-content:space-between}.receive-card-head h3{font-size:16px;font-weight:700;margin:0}.receive-card-body{padding:20px}.receive-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.receive-field label{display:block;margin-bottom:6px;font-size:13px;font-weight:650;color:#475569}.receive-field .form-control{min-height:42px;border-color:#dce3ed;border-radius:8px}.receive-lines{width:100%;border-collapse:collapse}.receive-lines th{background:#f5f8fb;color:#65748b;padding:11px 9px;text-align:left;font-size:12px}.receive-lines td{padding:9px;border-top:1px solid #edf0f5}.receive-lines select,.receive-lines input{height:40px;border:1px solid #dce3ed;border-radius:8px;padding:7px 9px;width:100%;background:#fff}.receive-lines .qty{min-width:90px}.receive-line-total{font-weight:650;white-space:nowrap}.receive-remove{width:34px;height:34px;border:1px solid #e4e8ed;border-radius:8px;background:#fff;color:#b54444}.receive-total{display:flex;justify-content:flex-end;align-items:center;gap:18px;padding:14px 10px 2px;font-weight:650}.receive-total strong{font-size:20px;color:#198754}.receive-actions{display:flex;justify-content:flex-end;gap:9px;padding:15px 20px;border-top:1px solid #edf0f5;background:#fbfcfd}.receive-empty{padding:18px;text-align:center;color:#8491a3}.receive-error{margin-bottom:13px}@@media(max-width:720px){.receive-grid{grid-template-columns:1fr}.receive-head{align-items:flex-start}.receive-card-body{padding:14px}.receive-lines{min-width:700px}.receive-lines-wrap{overflow:auto}}
</style>
<div class="receive-page">
    <div class="receive-head"><div><h2>Nhập hàng vào kho</h2></div><a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i>Quay lại kho</a></div>
    <form asp-action="NhapHang" method="post" id="receiveForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger receive-error"></div>
        <section class="receive-card"><div class="receive-card-head"><h3>Thông tin phiếu nhập</h3><span class="text-muted small">Ngày nhập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span></div><div class="receive-card-body"><div class="receive-grid"><div class="receive-field"><label asp-for="NhaCungCap">Nhà cung cấp</label><input asp-for="NhaCungCap" class="form-control" placeholder="Tên nhà cung cấp (không bắt buộc)"/><span asp-validation-for="NhaCungCap" class="text-danger small"></span></div><div class="receive-field"><label asp-for="GhiChu">Ghi chú</label><input asp-for="GhiChu" class="form-control" placeholder="Thông tin thêm cho phiếu nhập"/><span asp-validation-for="GhiChu" class="text-danger small"></span></div></div></div></section>
        <section class="receive-card"><div class="receive-card-head"><h3>Sản phẩm nhập</h3><button type="button" class="btn btn-sm btn-outline-success" id="addLine"><i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm</button></div><div class="receive-card-body"><div class="receive-lines-wrap"><table class="receive-lines"><thead><tr><th style="width:45%">Sản phẩm</th><th style="width:16%">Số lượng nhập</th><th style="width:20%">Giá nhập / đơn vị</th><th style="width:15%">Thành tiền</th><th></th></tr></thead><tbody id="receiveRows"></tbody></table></div><div id="noProducts" class="receive-empty" hidden>Chưa có sản phẩm nào. Hãy tạo sản phẩm trong mục Hàng hóa và dịch vụ trước khi nhập kho.</div><div class="receive-total"><span>Tổng phiếu nhập</span><strong id="receiveGrandTotal">0 đ</strong></div></div><div class="receive-actions"><a asp-action="Index" class="btn btn-light border">Hủy</a><button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg me-1"></i>Lưu phiếu nhập</button></div></section>
    </form>
</div>
<template id="receiveLineTemplate"><tr class="receive-line"><td><select name="DongHang[__INDEX__].DichVuId" class="product-select" required><option value="0">-- Chọn sản phẩm --</option>@foreach(var product in products){<option value="@product.Id" data-cost="@product.GiaVon.ToString(System.Globalization.CultureInfo.InvariantCulture)">@product.MaHang · @product.TenDichVu (@product.TonKho @product.DonViTinh)</option>}</select><span class="text-danger small" data-valmsg-for="DongHang[__INDEX__].DichVuId"></span></td><td><input name="DongHang[__INDEX__].SoLuong" class="qty" type="number" min="1" max="100000" value="1" required /></td><td><input name="DongHang[__INDEX__].DonGiaNhap" class="cost" type="number" min="0" step="0.01" value="0" required /></td><td class="receive-line-total">0 đ</td><td><button type="button" class="receive-remove" title="Xóa dòng"><i class="bi bi-trash"></i></button></td></tr></template>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
 const rows=document.getElementById('receiveRows'), template=document.getElementById('receiveLineTemplate'), empty=document.getElementById('noProducts');let index=0;
 const money=n=>Number(n||0).toLocaleString('vi-VN')+' đ';
 function recalc(){let grand=0;rows.querySelectorAll('.receive-line').forEach(row=>{const amount=(Number(row.querySelector('.qty').value)||0)*(Number(row.querySelector('.cost').value)||0);grand+=amount;row.querySelector('.receive-line-total').textContent=money(amount)});document.getElementById('receiveGrandTotal').textContent=money(grand);empty.hidden=rows.children.length!==0}
 function addLine(){const html=template.innerHTML.replaceAll('__INDEX__',String(index++));const wrapper=document.createElement('tbody');wrapper.innerHTML=html;const row=wrapper.firstElementChild;rows.appendChild(row);row.querySelector('.product-select').addEventListener('change',e=>{const cost=Number(e.target.selectedOptions[0]?.dataset.cost||0);row.querySelector('.cost').value=cost;recalc()});row.querySelector('.qty').addEventListener('input',recalc);row.querySelector('.cost').addEventListener('input',recalc);row.querySelector('.receive-remove').addEventListener('click',()=>{row.remove();recalc()});recalc()}
 document.getElementById('addLine').addEventListener('click',addLine);document.getElementById('receiveForm').addEventListener('submit',e=>{if(!rows.querySelector('.product-select')||[...rows.querySelectorAll('.product-select')].some(x=>!x.value||x.value==='0')){e.preventDefault();alert('Hãy chọn sản phẩm cho từng dòng nhập.')}});if(@products.Count>0)addLine();else{empty.hidden=false;document.getElementById('addLine').disabled=true}
})();
</script>
}
