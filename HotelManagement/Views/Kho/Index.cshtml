@model IEnumerable<HotelManagement.Models.DichVu>
@{
    ViewData["Title"] = "Quản lý kho";
    var products = Model.ToList();
    var receipts = ViewBag.Receipts as List<HotelManagement.Models.PhieuNhapKho> ?? new();
}
<style>
.warehouse-page{color:#263449}.warehouse-head,.warehouse-actions,.warehouse-toolbar,.warehouse-receipt-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.warehouse-head{margin-bottom:18px}.warehouse-head h2{margin:0 0 5px;font-size:25px;font-weight:700}.warehouse-head p{margin:0;color:#748198}.warehouse-actions{justify-content:flex-end}.warehouse-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 15px;border-radius:9px;background:#198754;color:#fff;text-decoration:none;font-weight:650}.warehouse-btn:hover{background:#157347;color:#fff}.warehouse-btn.light{background:#fff;color:#198754;border:1px solid #198754}.warehouse-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:15px}.warehouse-card{position:relative;padding:16px 18px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.warehouse-card span{display:block;color:#718096;font-size:12px}.warehouse-card strong{display:block;margin-top:5px;font-size:23px}.warehouse-card i{position:absolute;top:15px;right:17px;color:#198754;font-size:20px}.warehouse-tools{padding:13px;margin-bottom:14px;border:1px solid #e2e8f0;border-radius:12px;background:#fff}.warehouse-toolbar{justify-content:flex-start}.warehouse-search{position:relative;min-width:250px;flex:1;max-width:560px}.warehouse-search i{position:absolute;top:12px;left:12px;color:#8290a5}.warehouse-search input{width:100%;height:42px;padding:8px 12px 8px 36px;border:1px solid #dce3ed;border-radius:9px;outline:0}.warehouse-filter{height:40px;min-width:160px;padding:0 11px;border:1px solid #dce3ed;border-radius:9px;background:#fff;color:#40516a}.warehouse-panel{overflow:hidden;border:1px solid #e2e8f0;border-radius:13px;background:#fff;margin-bottom:18px}.warehouse-panel-title{padding:15px 17px;border-bottom:1px solid #edf0f5;display:flex;align-items:center;justify-content:space-between}.warehouse-panel-title h3{font-size:16px;font-weight:700;margin:0}.warehouse-table-wrap{overflow:auto}.warehouse-table{width:100%;min-width:850px;border-collapse:collapse}.warehouse-table th{padding:13px 12px;background:#f5f8fb;color:#65748b;text-align:left;font-size:12px;white-space:nowrap}.warehouse-table td{padding:11px 12px;border-top:1px solid #edf0f5;vertical-align:middle;font-size:13px}.warehouse-table tr:hover td{background:#fafcff}.warehouse-item{display:flex;align-items:center;gap:10px}.warehouse-image{width:43px;height:43px;object-fit:cover;border-radius:9px;border:1px solid #e5e9ef;background:#f5f7fa}.warehouse-empty-image{display:grid;place-items:center;color:#8b98a9;font-size:18px}.warehouse-code{display:block;color:#198754;font-size:11px;font-weight:700}.warehouse-name{font-weight:650}.warehouse-muted{display:block;margin-top:2px;color:#8290a5;font-size:11px}.warehouse-stock{font-weight:700}.warehouse-stock.low{color:#c47608}.warehouse-stock.out{color:#c03939}.warehouse-pill{display:inline-block;padding:4px 8px;border:1px solid #d5dee8;border-radius:7px;color:#496176;font-size:11px}.warehouse-pill.active{border-color:#9bd9af;background:#f1fbf4;color:#198754}.warehouse-footer{display:flex;justify-content:space-between;padding:11px 14px;color:#748198;font-size:12px;border-top:1px solid #edf0f5}.warehouse-receipt{padding:13px 17px;border-top:1px solid #edf0f5}.warehouse-receipt-head strong{color:#198754}.warehouse-receipt-head span{color:#738198;font-size:12px}.warehouse-receipt-lines{display:flex;flex-wrap:wrap;gap:7px;margin-top:9px}.warehouse-line-chip{padding:6px 9px;border-radius:7px;background:#f5f8fb;color:#526174;font-size:12px}.warehouse-success{margin-bottom:12px}@@media(max-width:800px){.warehouse-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.warehouse-head{align-items:flex-start}.warehouse-actions{width:100%;justify-content:flex-start}.warehouse-search{max-width:none}.warehouse-filter{flex:1}}
</style>
<div class="warehouse-page">
    <div class="warehouse-head"><div><h2>Quản lý kho</h2><p>Theo dõi tồn kho sản phẩm và lịch sử nhập hàng</p></div><div class="warehouse-actions"><a asp-controller="DichVu" asp-action="Index" class="warehouse-btn light"><i class="bi bi-box-seam"></i> Hàng hóa và dịch vụ</a><a asp-action="NhapHang" class="warehouse-btn"><i class="bi bi-box-arrow-in-down"></i> Nhập hàng</a></div></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success warehouse-success">@success</div> }
    <div class="warehouse-summary"><div class="warehouse-card"><span>Sản phẩm quản lý tồn</span><strong>@ViewBag.ProductCount</strong><i class="bi bi-box-seam"></i></div><div class="warehouse-card"><span>Sắp hết hàng (≤ 10)</span><strong>@ViewBag.LowCount</strong><i class="bi bi-exclamation-triangle"></i></div><div class="warehouse-card"><span>Hết hàng</span><strong>@ViewBag.OutCount</strong><i class="bi bi-x-circle"></i></div><div class="warehouse-card"><span>Giá trị tồn theo giá vốn</span><strong>@(((decimal)ViewBag.StockValue).ToString("N0")) đ</strong><i class="bi bi-currency-exchange"></i></div></div>
    <div class="warehouse-tools"><form asp-action="Index" method="get" class="warehouse-toolbar"><label class="warehouse-search"><i class="bi bi-search"></i><input name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo mã, tên sản phẩm" /></label><select class="warehouse-filter" name="tonKho"><option value="">Mọi mức tồn kho</option><option value="low" selected="@(ViewBag.TonKhoFilter == "low")">Sắp hết hàng</option><option value="out" selected="@(ViewBag.TonKhoFilter == "out")">Hết hàng</option></select><button class="btn btn-success" type="submit"><i class="bi bi-funnel me-1"></i>Lọc</button><a asp-action="Index" class="btn btn-light border">Đặt lại</a></form></div>
    <section class="warehouse-panel"><div class="warehouse-panel-title"><h3>Tồn kho sản phẩm</h3><span class="warehouse-muted">@products.Count mặt hàng</span></div><div class="warehouse-table-wrap"><table class="warehouse-table"><thead><tr><th>Sản phẩm</th><th>Nhóm hàng</th><th>Tồn kho</th><th>Đơn vị</th><th>Giá vốn</th><th>Giá trị tồn</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach(var item in products){<tr><td><div class="warehouse-item">@if(!string.IsNullOrWhiteSpace(item.AnhUrl)){<img class="warehouse-image" src="@item.AnhUrl" alt="Ảnh @item.TenDichVu"/>}else{<span class="warehouse-image warehouse-empty-image"><i class="bi bi-image"></i></span>}<div><span class="warehouse-name">@item.TenDichVu</span><span class="warehouse-code">@item.MaHang</span></div></div></td><td>@item.NhomHang</td><td><span class="warehouse-stock @(item.TonKho==0?"out":item.TonKho<=10?"low":"")">@item.TonKho</span></td><td>@item.DonViTinh</td><td>@item.GiaVon.ToString("N0") đ</td><td>@((item.GiaVon*item.TonKho).ToString("N0")) đ</td><td><span class="warehouse-pill @(item.TrangThai?"active":"")">@(item.TrangThai?"Đang kinh doanh":"Ngừng kinh doanh")</span></td></tr>}
    @if(products.Count==0){<tr><td colspan="7" class="text-center text-muted py-5">Không tìm thấy sản phẩm phù hợp.</td></tr>}
    </tbody></table></div><div class="warehouse-footer"><span>Hiển thị <strong>@products.Count</strong> sản phẩm</span><span>Số lượng tồn được cập nhật từ phiếu nhập và sử dụng tại phòng.</span></div></section>
    <section class="warehouse-panel"><div class="warehouse-panel-title"><h3>Lịch sử nhập hàng</h3><a asp-action="NhapHang" class="btn btn-sm btn-outline-success">Tạo phiếu nhập</a></div>
    @if(receipts.Count==0){<div class="text-center text-muted py-5">Chưa có phiếu nhập hàng.</div>}else{foreach(var receipt in receipts){<article class="warehouse-receipt"><div class="warehouse-receipt-head"><strong>@receipt.MaPhieu</strong><span>@receipt.NgayNhap.ToString("dd/MM/yyyy HH:mm") · @(receipt.NhaCungCap??"Chưa ghi nhà cung cấp") · @receipt.ChiTietNhapKhos.Sum(x=>x.SoLuong) đơn vị · @receipt.TongTien.ToString("N0") đ</span></div><div class="warehouse-receipt-lines">@foreach(var line in receipt.ChiTietNhapKhos){<span class="warehouse-line-chip">@(line.DichVu?.TenDichVu??"Sản phẩm đã xóa") · +@line.SoLuong · @line.ThanhTien.ToString("N0") đ</span>}</div>@if(!string.IsNullOrWhiteSpace(receipt.GhiChu)){<span class="warehouse-muted">@receipt.GhiChu</span>}</article>}}
    </section>
</div>
