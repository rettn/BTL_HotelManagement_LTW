@model HotelManagement.ViewModels.QuanTriEditViewModel
@{
    ViewData["Title"] = "Sửa tài khoản"; Layout = "_AdminLayout";
}

<div class="card" style="max-width:640px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Email đăng nhập</label>
                <input class="form-control" value="@Model.Email" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VaiTro" class="form-label">Vai trò (phân quyền)</label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="NhanVien">Nhân viên</option>
                    <option value="Admin">Quản trị viên (Admin)</option>
                </select>
                <span asp-validation-for="VaiTro" class="text-danger"></span>
            </div>
            <button class="btn btn-primary">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}