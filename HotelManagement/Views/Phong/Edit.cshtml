@model HotelManagement.Models.Phong
@using HotelManagement.Models

@{
    ViewData["Title"] = "Chỉnh sửa phòng";
    var danhSachLoaiPhong = ViewBag.DanhSachLoaiPhong as List<LoaiPhong> ?? new List<LoaiPhong>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/room-map.css" asp-append-version="true" />
}

<div class="room-map-page">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; background-color: #fff;">
        <div class="card-body p-5">

            <div class="mb-4 pb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-1">Chỉnh sửa phòng @Model.SoPhong</h5>
                <p class="text-muted small mb-0">Cập nhật thông tin số phòng, loại phòng, trạng thái và ghi chú.</p>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaPhong" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row mb-4">
                    <!-- so phong -->
                    <div class="col-md-4">
                        <label asp-for="SoPhong" class="form-label fw-bold text-dark mb-2">Số phòng</label>
                        <input asp-for="SoPhong" class="form-control py-2" style="border-radius: 8px;" placeholder="Ví dụ: 101, 201..." required />
                        <span asp-validation-for="SoPhong" class="text-danger small"></span>
                    </div>

                    <!-- loai phong -->
                    <div class="col-md-4">
                        <label asp-for="MaLoaiPhong" class="form-label fw-bold text-dark mb-2">Loại phòng</label>
                        <select asp-for="MaLoaiPhong" class="form-select py-2" style="border-radius: 8px;" required>
                            <option value="">-- Chọn loại phòng --</option>
                            @foreach (var loai in danhSachLoaiPhong)
                            {
                                <option value="@loai.MaLoaiPhong">
                                    @loai.TenLoaiPhong - @loai.GiaTheoDem.ToString("N0") đ/đêm
                                </option>
                            }
                        </select>
                        <span asp-validation-for="MaLoaiPhong" class="text-danger small"></span>

                        @if (!danhSachLoaiPhong.Any())
                        {
                            <div class="text-danger mt-1 small">Chưa có loại phòng. Vui lòng thêm loại phòng trước.</div>
                        }
                    </div>

                    <!-- Trạng thái -->
                    <div class="col-md-4">
                        <label asp-for="TrangThai" class="form-label fw-bold text-dark mb-2">Trạng thái</label>
                        <select asp-for="TrangThai" class="form-select py-2" style="border-radius: 8px;">
                            <option value="Trống">Phòng trống</option>
                            <option value="Đã đặt">Đã đặt</option>
                            <option value="Đang sử dụng">Đang sử dụng</option>
                            <option value="Đang dọn dẹp">Đang dọn dẹp</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Ghi chú -->
                <div class="mb-5">
                    <label asp-for="GhiChu" class="form-label fw-bold text-dark mb-2">Ghi chú</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Thông tin bổ sung (nếu có)..."></textarea>
                    <span asp-validation-for="GhiChu" class="text-danger small"></span>
                </div>

                <!-- Nut dieu huong -->
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-3 py-2 border fw-normal text-secondary" style="border-radius: 8px; font-size: 0.9rem;">
                        Hủy
                    </a>
                    <button type="submit" class="btn text-white px-3 py-2 custom-save-btn" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<style>
    .custom-save-btn {
        background-color: #198754 !important; 
        border: none !important;
        transition: background-color 0.2s ease-in-out;
    }

        .custom-save-btn:hover {
            background-color: #157347 !important;
            color: #fff !important;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}