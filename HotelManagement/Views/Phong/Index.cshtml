
@model List<HotelManagement.Models.Phong>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@{
    ViewData["Title"] = "Sơ đồ phòng";
    var thoiGianNhan = ViewBag.ThoiGianNhan as Dictionary<int, DateTime> ?? new Dictionary<int, DateTime>();
    int LayTang(string soPhong)
    {
        if (int.TryParse(soPhong, out int so)) return so / 100;
        return 0;
    }

    string MauTrangThai(string? trangThai)
    {
        var cleanStatus = trangThai?.Trim().ToLowerInvariant() ?? "";
        if (cleanStatus.Contains("trong") || cleanStatus.Contains("trống")) return "room-empty";
        if (cleanStatus.Contains("dadat") || cleanStatus.Contains("đã đặt")) return "room-booked";
        if (cleanStatus.Contains("dangsudung") || cleanStatus.Contains("đang sử dụng")) return "room-occupied";
        if (cleanStatus.Contains("dangdon") || cleanStatus.Contains("đang dọn dẹp")) return "room-cleaning";
        return "room-other";
    }

    string TenTrangThai(string? trangThai)
    {
        var cleanStatus = trangThai?.Trim().ToLowerInvariant() ?? "";
        if (cleanStatus.Contains("trong") || cleanStatus.Contains("trống")) return "Phòng trống";
        if (cleanStatus.Contains("dadat") || cleanStatus.Contains("đã đặt")) return "Đã đặt";
        if (cleanStatus.Contains("dangsudung") || cleanStatus.Contains("đang sử dụng")) return "Đang sử dụng";
        if (cleanStatus.Contains("dangdon") || cleanStatus.Contains("đang dọn dẹp")) return "Đang dọn dẹp";
        return trangThai ?? "Chưa xác định";
    }
    string IconTrangThai(string? trangThai)
    {
        var s = trangThai?.Trim().ToLowerInvariant() ?? "";
        if (s.Contains("trong") || s.Contains("trống")) return "bi-stars";
        if (s.Contains("dadat") || s.Contains("đã đặt")) return "bi-calendar-check";
        if (s.Contains("dangsudung") || s.Contains("đang sử dụng")) return "bi-person-check";
        if (s.Contains("dangdon") || s.Contains("đang dọn dẹp")) return "bi-brush";
        return "bi-info-circle";
    }

    var cacTang = Model.GroupBy(p => LayTang(p.SoPhong)).OrderBy(g => g.Key).ToList();
    var soPhongTrong = Model.Count(p => p.TrangThai != null && (p.TrangThai.ToLower().Contains("trong") || p.TrangThai.ToLower().Contains("trống")));
}

@section Styles {
    <link rel="stylesheet" href="~/css/room-map.css" asp-append-version="true" />
}

<div class="room-map-page">
    @Html.AntiForgeryToken()
    <div class="room-toolbar">
        <div>
            <h2>Quản lý phòng</h2>
           
        </div>
        <div class="room-toolbar-actions">
            <button type="button" class="room-manage-type-button" id="openLoaiPhongModal">
                <i class="bi bi-tags"></i> Quản lý loại phòng
            </button>
            <a asp-controller="Phong" asp-action="Create" class="room-add-button">
                <i class="bi bi-plus-lg"></i> Thêm phòng
            </a>
        </div>
    </div>

    <div class="room-summary">
        <div class="room-summary-card">
            <span>Tổng số phòng</span>
            <strong>@Model.Count</strong>
            <i class="bi bi-door-closed"></i>
        </div>
        <div class="room-summary-card">
            <span>Phòng trống</span>
            <strong>@soPhongTrong</strong>
            <i class="bi bi-check-circle"></i>
        </div>
        <div class="room-summary-card">
            <span>Số tầng</span>
            <strong>@cacTang.Count</strong>
            <i class="bi bi-building"></i>
        </div>
    </div>
    
    <form method="get" asp-controller="Phong" asp-action="Index" class="room-filter-panel mb-4" id="filterForm" style="display: flex; gap: 12px; width: 100%; background: #fff; padding: 16px; border-radius: 8px; border: 1px solid #e0e0e0; box-sizing: border-box;">

        <div style="flex: 1; position: relative; display: flex; align-items: center; border: 1px solid #dee2e6; border-radius: 6px; background: #fff; height: 42px; overflow: hidden;">
            <i class="bi bi-search" style="position: absolute; left: 14px; color: #8b92a1;"></i>
            <input id="roomSearch" type="search" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm số phòng..." style="width: 100%; height: 100%; padding: 10px 14px 10px 40px; border: none; outline: none; background: transparent; box-sizing: border-box;" />
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn text-white fw-semibold px-4 exact-search-btn" style="border-radius: 6px; height: 42px; display: flex; align-items: center;">
                <i class="bi bi-search me-1"></i> Tìm kiếm
            </button>
            <a asp-action="Index" class="btn btn-light px-3 border text-secondary" style="border-radius: 6px; height: 42px; display: flex; align-items: center; background: #f8f9fa;">
                Khôi phục
            </a>
        </div>

    </form>

    <div class="room-legend" id="roomLegend">
        <button type="button" class="room-filter-chip active" data-filter="all">
            <i class="legend-dot room-all"></i> Tất cả <em>@Model.Count</em>
        </button>
        <button type="button" class="room-filter-chip" data-filter="room-empty">
            <i class="legend-dot room-empty"></i> Phòng trống <em>@Model.Count(p => MauTrangThai(p.TrangThai) == "room-empty")</em>
        </button>
        <button type="button" class="room-filter-chip" data-filter="room-booked">
            <i class="legend-dot room-booked"></i> Đã đặt <em>@Model.Count(p => MauTrangThai(p.TrangThai) == "room-booked")</em>
        </button>
        <button type="button" class="room-filter-chip" data-filter="room-occupied">
            <i class="legend-dot room-occupied"></i> Đang sử dụng <em>@Model.Count(p => MauTrangThai(p.TrangThai) == "room-occupied")</em>
        </button>
        <button type="button" class="room-filter-chip" data-filter="room-cleaning">
            <i class="legend-dot room-cleaning"></i> Đang dọn dẹp <em>@Model.Count(p => MauTrangThai(p.TrangThai) == "room-cleaning")</em>
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="room-empty-state">
            <i class="bi bi-building"></i>
            <h3>Chưa có phòng nào</h3>
            <a asp-action="Create" class="room-add-button">Thêm phòng đầu tiên</a>
        </div>
    }
    else
    {
        @foreach (var tang in cacTang)
        {
            <section class="room-floor" data-floor="@tang.Key">
                <div class="room-floor-heading">
                    <div>
                        <h3>@(tang.Key > 0 ? $"Tầng {tang.Key}" : "Chưa xác định tầng")</h3>
                        <span>@tang.Count() phòng</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </div>

                <div class="room-grid">
                    @foreach (var phong in tang.OrderBy(p => p.SoPhong))
                    {
                        <div class="room-card @MauTrangThai(phong.TrangThai) room-card-trigger"
                             data-room-id="@phong.MaPhong"
                             title="Xem chi tiết phòng @phong.SoPhong">
                            <div class="room-card-top">
                                <span class="room-status-label"><i class="bi @IconTrangThai(phong.TrangThai)"></i>@TenTrangThai(phong.TrangThai)</span>
                                <i class="bi bi-three-dots-vertical room-card-more"></i>
                            </div>
                            <strong class="room-card-number">@phong.SoPhong</strong>
                            <div class="room-card-type">@(phong.LoaiPhong?.TenLoaiPhong ?? "Chưa phân loại")</div>
                            <div class="room-card-price"><i class="bi bi-cash-coin"></i>@(phong.LoaiPhong?.GiaTheoDem.ToString("N0") ?? "0")</div>
                            @if (MauTrangThai(phong.TrangThai) == "room-occupied" && thoiGianNhan.TryGetValue(phong.MaPhong, out var tgNhan))
                            {
                                <div class="room-card-stay" data-checkin="@tgNhan.ToString("yyyy-MM-ddTHH:mm:ss")">
                                    <span class="room-stay-pill"><i class="bi bi-clock"></i> <b class="room-stay-text">--</b></span>
                                    <span class="room-stay-from">Nhận @tgNhan.ToString("HH:mm dd/MM")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    }

    <!-- MODAL CHI TIẾT PHÒNG (header + nút đóng nằm trong partial _QuanLyThePhong) -->
    <div id="roomDetailModal" class="type-modal room-detail-modal" aria-hidden="true">
        <div class="type-modal-backdrop" id="closeRoomModalBackdrop"></div>
        <section class="type-modal-dialog" role="dialog" aria-modal="true">
            <div id="roomModalContent">
                <div class="type-loading"><i class="bi bi-arrow-repeat"></i> Đang tải thông tin phòng...</div>
            </div>
        </section>
    </div>

    <div id="dichVuModal" class="type-modal" aria-hidden="true">
        <div class="type-modal-backdrop" onclick="dongDichVu()"></div>
        <section class="type-modal-dialog" role="dialog" aria-modal="true">
            <div id="dichVuContent"></div>
        </section>
    </div>

    <div id="loaiPhongModal" class="type-modal" aria-hidden="true">
        <div class="type-modal-backdrop" data-close-type-modal></div>
        <section class="type-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="loaiPhongModalTitle">
            <header class="type-modal-header">
                <div><h2 id="loaiPhongModalTitle">Quản lý loại phòng</h2><p>Quản lý hạng phòng và giá lưu trú</p></div>
                <button type="button" class="type-modal-close" data-close-type-modal aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="type-modal-content" id="loaiPhongModalContent">
                <div class="type-loading"><i class="bi bi-arrow-repeat"></i> Đang tải danh sách loại phòng...</div>
            </div>
        </section>
    </div>

    <div id="checkoutConfirmModal" class="type-modal checkout-confirm-modal" aria-hidden="true">
        <div class="type-modal-backdrop" data-close-checkout></div>
        <section class="checkout-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="checkoutConfirmTitle">
            <header class="checkout-confirm-header">
                <div><h2 id="checkoutConfirmTitle">Xác nhận trả phòng</h2><p id="checkoutConfirmGuest"></p></div>
                <button type="button" class="type-modal-close" data-close-checkout aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
            </header>
            <div class="checkout-confirm-table-wrap">
                <table class="checkout-confirm-table">
                    <thead><tr><th></th><th>Hạng phòng</th><th>Phòng</th><th>Nhận phòng</th><th>Trả phòng</th><th>Trạng thái</th></tr></thead>
                    <tbody id="checkoutConfirmRooms"></tbody>
                </table>
            </div>
            <footer class="checkout-confirm-footer">
                <button type="button" class="btn btn-light border" data-close-checkout>Đóng</button>
                <button type="button" id="confirmRoomCheckout" class="btn btn-success"><i class="bi bi-box-arrow-right me-1"></i>Trả phòng đã chọn</button>
                <button type="button" id="confirmRoomCheckoutPay" class="btn btn-success"><i class="bi bi-receipt me-1"></i>Trả phòng và thanh toán</button>
            </footer>
        </section>
    </div>
</div>

<style>
    /* ===== Chung ===== */
    .room-map-page {
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .swal2-container {
        z-index: 99999 !important;
        font-family: inherit !important;
    }

    .exact-search-btn {
        background-color: #198754 !important;
        border: none !important;
        transition: background-color .2s ease-in-out;
    }

        .exact-search-btn:hover {
            background-color: #157347 !important;
            color: #fff !important;
        }

    /* ===== Tầng ===== */
    .room-map-page .room-floor {
        margin: 0 0 22px;
    }

    .room-map-page .room-floor-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 0 !important;
        padding: 0 !important;
        margin: 0 0 10px;
        cursor: default;
    }

        .room-map-page .room-floor-heading > div {
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .room-map-page .room-floor-heading h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: #111827;
        }

        .room-map-page .room-floor-heading span {
            font-size: 13px;
            font-weight: 500;
            color: #6b7280;
        }

        .room-map-page .room-floor-heading::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }

        .room-map-page .room-floor-heading > i {
            display: none;
        }

    /* ===== Lưới ===== */
    .room-map-page .room-grid {
        display: flex !important;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* ===== Thẻ phòng ===== */
    .room-map-page .room-card {
        position: relative;
        cursor: pointer;
        box-sizing: border-box;
        width: 176px !important;
        height: 132px;
        min-height: 0;
        padding: 11px 13px;
        display: flex;
        flex-direction: column;
        color: #fff;
        border: 0 !important;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.12);
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .room-map-page .room-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0,0,0,.18);
        }

    .room-map-page .room-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 6px;
        min-height: 22px;
    }

    .room-map-page .room-card-more {
        font-size: 15px;
        color: #fff;
        opacity: .9;
    }

    /* Nhãn trạng thái: pill trắng */
    .room-map-page .room-status-label {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        line-height: 17px;
        white-space: nowrap;
        background: #fff;
        color: #374151;
    }

        .room-map-page .room-status-label i {
            font-size: 11px;
        }

    .room-map-page .room-card-number {
        display: block;
        font-size: 22px;
        line-height: 1.25;
        font-weight: 700;
        letter-spacing: -.2px;
        color: #fff;
    }

    .room-map-page .room-card-type {
        margin-top: 8px;
        font-size: 12.5px;
        font-weight: 600;
        line-height: 1.3;
        color: #fff;
    }

    .room-map-page .room-card-price {
        margin-top: 3px;
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 400;
        color: rgba(255,255,255,.88);
    }

        .room-map-page .room-card-price i {
            font-size: 12px;
        }

    /* ===== MÀU CẢ THẺ THEO TRẠNG THÁI ===== */
    .room-map-page .room-card.room-empty {
        background: linear-gradient(160deg, #2fa66a, #228a55);
    }

    .room-map-page .room-card.room-booked {
        background: linear-gradient(160deg, #f2a03d, #dd8a24);
    }

    .room-map-page .room-card.room-occupied {
        background: linear-gradient(160deg, #e2574c, #c9433a);
    }

    .room-map-page .room-card.room-cleaning {
        background: linear-gradient(160deg, #3f8fd9, #2f76bd);
    }

    .room-map-page .room-card.room-other {
        background: linear-gradient(160deg, #7b8391, #5b6270);
    }

    /* Chữ trên nhãn trạng thái (pill trắng) */
    .room-map-page .room-card.room-empty .room-status-label {
        color: #228a55;
    }

    .room-map-page .room-card.room-booked .room-status-label {
        color: #b86e12;
    }

    .room-map-page .room-card.room-occupied .room-status-label {
        color: #c9433a;
    }

    .room-map-page .room-card.room-cleaning .room-status-label {
        color: #2f76bd;
    }

    .room-map-page .room-card.room-other .room-status-label {
        color: #374151;
    }

    /* ===== Chú thích ===== */
    .room-map-page .room-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 4px 0 16px;
    }

        .room-map-page .room-legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 999px;
            background: #fff;
            border: 1px solid #e5e7eb;
            font-size: 12px;
            font-weight: 600;
            color: #374151;
        }

    .room-map-page .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        border: 0;
    }

        .room-map-page .legend-dot.room-empty {
            background: #2fa66a;
        }

        .room-map-page .legend-dot.room-booked {
            background: #f2a03d;
        }

        .room-map-page .legend-dot.room-occupied {
            background: #e2574c;
        }

        .room-map-page .legend-dot.room-cleaning {
            background: #3f8fd9;
        }

    .room-map-page .room-card {
        height: 150px;
    }

    .room-map-page .room-card-stay {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
    }

    .room-map-page .room-stay-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #fff;
        color: #c9433a;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .room-map-page .room-stay-pill b {
            font-weight: 600;
        }

    .room-map-page .room-stay-from {
        font-size: 10.5px;
        color: rgba(255,255,255,.9);
        white-space: nowrap;
    }
    /* ===== Nút lọc trạng thái ===== */
    .room-map-page .room-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 13px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #e5e7eb;
        font-size: 12px;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
        transition: background .15s, border-color .15s, color .15s;
    }

        .room-map-page .room-filter-chip em {
            font-style: normal;
            font-weight: 500;
            color: #6b7280;
        }

        .room-map-page .room-filter-chip:hover {
            background: #f3f4f6;
        }

        .room-map-page .room-filter-chip.active {
            background: #1f2937;
            border-color: #1f2937;
            color: #fff;
        }

            .room-map-page .room-filter-chip.active em {
                color: rgba(255,255,255,.8);
            }

    .room-map-page .legend-dot.room-all {
        background: #9ca3af;
    }
    /* ===== Popup chi tiết phòng ===== */
    .room-detail-modal .type-modal-dialog {
        width: min(980px, calc(100% - 32px)) !important;
        max-width: none !important;
        margin: 24px auto !important;
        min-height: 560px;
        display: flex;
        flex-direction: column;
    }

    .room-detail-modal #roomModalContent {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .room-detail-modal .rp-body {
        flex: 1;
    }

    /* ===== Popup xác nhận trả phòng ===== */
    .checkout-confirm-modal {
        z-index: 2200;
    }

        .checkout-confirm-modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

    .checkout-confirm-dialog {
        position: relative;
        z-index: 1;
        width: min(100%, 1100px);
        max-height: calc(100vh - 40px);
        overflow: auto;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 24px 70px rgba(0,0,0,.25);
    }

    .checkout-confirm-header, .checkout-confirm-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 24px;
    }

    .checkout-confirm-header {
        border-bottom: 1px solid #e8edf2;
    }

        .checkout-confirm-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }

        .checkout-confirm-header p {
            margin: 5px 0 0;
            color: #718096;
        }

    .checkout-confirm-table-wrap {
        padding: 8px 24px;
        overflow: auto;
    }

    .checkout-confirm-table {
        width: 100%;
        min-width: 760px;
        border-collapse: separate;
        border-spacing: 0 4px;
    }

        .checkout-confirm-table th {
            padding: 12px;
            background: #e7f5ed;
            font-weight: 650;
        }

        .checkout-confirm-table td {
            padding: 13px 12px;
            background: #f8fafc;
        }

        .checkout-confirm-table tr.is-active td {
            background: #fff;
        }

    .checkout-confirm-state {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 99px;
        background: #e4f8ed;
        color: #16804a;
        font-size: 12px;
    }

        .checkout-confirm-state.inactive {
            background: #fff3d6;
            color: #986500;
        }

    .checkout-confirm-footer {
        justify-content: flex-end;
        border-top: 1px solid #e8edf2;
    }

        .checkout-confirm-footer .btn-success {
            background: #209c60;
            border-color: #209c60;
        }

    @@media (max-width: 650px) {
        .checkout-confirm-footer {
            flex-wrap: wrap;
        }

            .checkout-confirm-footer button {
                flex: 1 1 100%;
            }
    }


</style>

<script>
    let checkoutBookingId = null;
    let checkoutActiveRoomIds = [];

    async function moModalTraPhong(maDatPhong, maPhongDangMo) {
        const modal = document.getElementById('checkoutConfirmModal');
        const tbody = document.getElementById('checkoutConfirmRooms');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Đang tải danh sách phòng...</td></tr>';
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('type-modal-open');
        try {
            const response = await fetch(`/DatPhong/GetThongTinTraPhong?id=${maDatPhong}&maPhong=${maPhongDangMo}`);
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.message || 'Không thể tải thông tin trả phòng.');
            checkoutBookingId = data.maDatPhong;
            document.getElementById('checkoutConfirmTitle').textContent = `Xác nhận trả phòng - DP${String(data.maDatPhong).padStart(6, '0')}`;
            document.getElementById('checkoutConfirmGuest').innerHTML = `<i class="bi bi-person me-2"></i>${escapeHtmlRoom(data.tenKhachHang)}`;
            checkoutActiveRoomIds = data.rooms.filter(r => r.dangLuuTru).map(r => r.maPhong);
            tbody.replaceChildren();
            data.rooms.forEach(room => {
                const tr = document.createElement('tr');
                tr.className = room.dangLuuTru ? 'is-active' : '';
                const checkCell = document.createElement('td');
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox'; checkbox.className = 'checkout-room-checkbox';
                checkbox.value = room.maPhong; checkbox.disabled = !room.dangLuuTru;
                checkbox.checked = room.maPhong === Number(maPhongDangMo) && room.dangLuuTru;
                checkCell.appendChild(checkbox); tr.appendChild(checkCell);
                [room.tenLoaiPhong, room.soPhong, room.ngayNhan, room.ngayTraDuKien].forEach(value => {
                    const td = document.createElement('td'); td.textContent = value || '—'; tr.appendChild(td);
                });
                const stateCell = document.createElement('td');
                const state = document.createElement('span');
                state.className = `checkout-confirm-state${room.dangLuuTru ? '' : ' inactive'}`;
                state.textContent = room.dangLuuTru ? 'Đang lưu trú' : room.daTra ? 'Đã trả phòng' : 'Chưa nhận phòng';
                stateCell.appendChild(state); tr.appendChild(stateCell);
                tbody.appendChild(tr);
            });
        } catch (error) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">${escapeHtmlRoom(error.message)}</td></tr>`;
        }
    }

    function escapeHtmlRoom(value) {
        const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML;
    }

    function closeCheckoutConfirm() {
        document.getElementById('checkoutConfirmModal').classList.remove('show');
        document.getElementById('checkoutConfirmModal').setAttribute('aria-hidden', 'true');
        if (!document.querySelector('.type-modal.show')) document.body.classList.remove('type-modal-open');
    }

    document.addEventListener('click', event => {
        if (event.target.closest('[data-close-checkout]')) closeCheckoutConfirm();
    });

    document.getElementById('confirmRoomCheckout').addEventListener('click', async function () {
        const roomIds = [...document.querySelectorAll('.checkout-room-checkbox:checked')].map(input => Number(input.value));
        if (!roomIds.length) { alert('Chọn ít nhất một phòng đang lưu trú để trả.'); return; }
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        this.disabled = true;
        try {
            for (const maPhong of roomIds) {
                const body = new URLSearchParams({ id: checkoutBookingId, maPhong, __RequestVerificationToken: token });
                const response = await fetch('/DatPhong/CheckOut', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Không thể trả phòng.');
            }
            location.reload();
        } catch (error) { alert(error.message); this.disabled = false; }
    });

    document.getElementById('confirmRoomCheckoutPay').addEventListener('click', () => {
        const selected = [...document.querySelectorAll('.checkout-room-checkbox:checked')].map(input => Number(input.value));
        if (!checkoutActiveRoomIds.length || selected.length !== checkoutActiveRoomIds.length || checkoutActiveRoomIds.some(id => !selected.includes(id))) {
            alert('Để trả phòng và thanh toán cùng lúc, hãy chọn tất cả phòng đang lưu trú.'); return;
        }
        window.location.href = `/DatPhong/Checkout/${checkoutBookingId}`;
    });

    // Nhận phòng / Hủy đặt phòng / Trả phòng trong popup phòng
    async function thucHienThaoTacPhong(url, maDatPhong, maPhong, thongBaoXacNhan) {
        if (!confirm(thongBaoXacNhan)) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (!token) {
            alert('Thiếu mã bảo mật (anti-forgery token). Hãy tải lại trang.');
            return;
        }

        const body = new URLSearchParams();
        body.append('id', maDatPhong);
        body.append('maPhong', maPhong);
        body.append('__RequestVerificationToken', token);

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body
            });

            let data = null;
            try { data = await response.json(); } catch { }

            if (!response.ok || !data || !data.success) {
                alert(data?.message ?? 'Thao tác thất bại. Vui lòng thử lại.');
                return;
            }

            alert(data.message);
            location.reload();
        } catch (err) {
            alert('Không thể kết nối đến máy chủ.');
        }
    }

    // Dịch vụ của phòng đang lưu trú
    let dichVuMaPhong = null;

    function moDichVu(maPhong) {
        dichVuMaPhong = maPhong;
        window.dvCart = {};
        const modal = document.getElementById('dichVuModal');
        const content = document.getElementById('dichVuContent');

        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('type-modal-open');
        content.innerHTML =
            '<div class="type-loading"><i class="bi bi-arrow-repeat"></i> Đang tải dịch vụ...</div>';

        fetch('/DatPhong/DichVuLuuTru?maPhong=' + maPhong)
            .then(r => { if (!r.ok) throw new Error(); return r.text(); })
            .then(html => {
                content.innerHTML = html;
                content.querySelectorAll('script').forEach(oldScript => {
                    const script = document.createElement('script');
                    script.textContent = oldScript.textContent;
                    oldScript.replaceWith(script);
                });
            })
            .catch(() => {
                content.innerHTML =
                    '<div class="type-empty"><p class="text-danger">Không thể tải danh sách dịch vụ.</p></div>';
            });
    }

    function dongDichVu() {
        const modal = document.getElementById('dichVuModal');
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
        if (!document.querySelector('.type-modal.show')) {
            document.body.classList.remove('type-modal-open');
        }
    }

    async function themDichVu(maLuuTru) {
        const rows = [...(document.querySelectorAll('#dvCartRows .dv-cart-row'))];
        if (!rows.length) { alert('Vui lòng chọn ít nhất một mặt hàng.'); return; }
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        try {
            for (const row of rows) {
                const body = new URLSearchParams({ maLuuTru, maDichVu: row.dataset.id, soLuong: row.querySelector('input').value, __RequestVerificationToken: token || '' });
                const response = await fetch('/DatPhong/ThemDichVu', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body });
                let data = null; try { data = await response.json(); } catch { }
                if (!response.ok || !data?.success) { alert(data?.message ?? 'Không thể thêm mặt hàng. Các mặt hàng đã lưu trước lỗi vẫn được ghi nhận.'); moDichVu(dichVuMaPhong); return; }
            }
            window.dvCart = {};
            moDichVu(dichVuMaPhong);
        } catch (err) {
            alert('Không thể kết nối đến máy chủ.');
        }
    }
        // Gọi API sửa/xóa dịch vụ rồi tải lại popup dịch vụ
    async function guiDichVu(url, params) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const body = new URLSearchParams(params);
        body.append('__RequestVerificationToken', token);

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body
            });

            let data = null;
            try { data = await response.json(); } catch { }

            if (!response.ok || !data || !data.success) {
                alert(data?.message ?? 'Thao tác thất bại. Vui lòng thử lại.');
                return;
            }

            moDichVu(dichVuMaPhong);
        } catch (err) {
            alert('Không thể kết nối đến máy chủ.');
        }
    }

    function batDauSuaDichVu(id) {
        document.getElementById('dv-row-' + id).style.display = 'none';
        document.getElementById('dv-edit-' + id).style.display = '';
    }

    function huySuaDichVu(id) {
        document.getElementById('dv-edit-' + id).style.display = 'none';
        document.getElementById('dv-row-' + id).style.display = '';
    }

    function luuSuaDichVu(id) {
        const maDichVu = document.getElementById('dvSuaChon-' + id).value;
        const soLuong = document.getElementById('dvSuaSoLuong-' + id).value;

        guiDichVu('/DatPhong/SuaDichVu', {
            maChiTietDichVu: id,
            maDichVu: maDichVu,
            soLuong: soLuong
        });
    }

    function xoaDichVu(id, tenDichVu) {
        if (!confirm('Xóa dịch vụ "' + tenDichVu + '" khỏi phòng này?')) return;
        guiDichVu('/DatPhong/XoaDichVu', { maChiTietDichVu: id });
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        function showModal(modal) {
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('type-modal-open');
        }

        function hideModal(modal) {
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            if (!document.querySelector('.type-modal.show')) {
                document.body.classList.remove('type-modal-open');
            }
        }

        const loadingHtml = text =>
            '<div class="type-loading"><i class="bi bi-arrow-repeat"></i> ' + text + '</div>';

        // chi tiet phong
        const roomModal = document.getElementById('roomDetailModal');
        const roomContent = document.getElementById('roomModalContent');

        if (roomModal) {
            roomModal.addEventListener('click', function (e) {
                if (e.target.closest('#closeRoomModalBackdrop, #closeRoomModalBtn, #closeRoomModalFooterBtn')) {
                    hideModal(roomModal);
                }
            });

            document.querySelectorAll('.room-card-trigger').forEach(card => {
                card.addEventListener('click', function () {
                    const roomId = this.getAttribute('data-room-id');
                    if (!roomId) return;

                    showModal(roomModal);
                    roomContent.innerHTML = loadingHtml('Đang tải thông tin phòng...');

                    fetch('/Phong/Popup/' + roomId)
                        .then(response => {
                            if (!response.ok) throw new Error('Lỗi tải dữ liệu từ server.');
                            return response.text();
                        })
                        .then(html => { roomContent.innerHTML = html; })
                        .catch(() => {
                            roomContent.innerHTML = '<div class="type-empty"><p class="text-danger">Không thể tải chi tiết phòng.</p></div>';
                        });
                });
            });
        }

        const typeModal = document.getElementById('loaiPhongModal');
        const typeContent = document.getElementById('loaiPhongModalContent');
        const openTypeBtn = document.getElementById('openLoaiPhongModal');

        function loadLoaiPhong(url) {
            typeContent.innerHTML = loadingHtml('Đang tải danh sách loại phòng...');
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Lỗi tải dữ liệu từ server.');
                    return response.text();
                })
                .then(html => { typeContent.innerHTML = html; })
                .catch(() => {
                    typeContent.innerHTML = '<div class="type-empty"><p class="text-danger">Không thể tải danh sách loại phòng.</p></div>';
                });
        }

        if (typeModal && openTypeBtn) {
            openTypeBtn.addEventListener('click', function () {
                showModal(typeModal);
                loadLoaiPhong('/LoaiPhong/Popup');
            });

            typeModal.addEventListener('click', function (e) {
                if (e.target.closest('[data-close-type-modal]')) {
                    hideModal(typeModal);
                }
            });

            typeContent.addEventListener('submit', function (e) {
                const form = e.target.closest('form[data-type-search]');
                if (!form) return;
                e.preventDefault();
                const query = new URLSearchParams(new FormData(form)).toString();
                loadLoaiPhong('/LoaiPhong/Popup?' + query);
            });
        }

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            document.querySelectorAll('.type-modal.show').forEach(hideModal);
        });
    });
</script>
<script>
    (function () {
        function dinhDang(ms) {
            if (ms < 0) ms = 0;
            const tongPhut = Math.floor(ms / 60000);
            const ngay = Math.floor(tongPhut / 1440);
            const gio = Math.floor((tongPhut % 1440) / 60);
            const phut = tongPhut % 60;
            if (ngay > 0) return ngay + ' ngày ' + gio + ' giờ';
            if (gio > 0) return gio + ' giờ ' + String(phut).padStart(2, '0') + ' phút';
            return phut + ' phút';
        }
        function capNhat() {
            const now = Date.now();
            document.querySelectorAll('.room-card-stay').forEach(el => {
                const t = new Date(el.dataset.checkin).getTime();
                if (isNaN(t)) return;
                el.querySelector('.room-stay-text').textContent = dinhDang(now - t);
            });
        }
        capNhat();
        setInterval(capNhat, 30000); // cập nhật mỗi 30 giây
    })();
</script>
<script>
    (function () {
        const chips = document.querySelectorAll('#roomLegend .room-filter-chip');
        const cards = document.querySelectorAll('.room-card');
        const floors = document.querySelectorAll('.room-floor');

        function locPhong(filter) {
            cards.forEach(card => {
                const hien = filter === 'all' || card.classList.contains(filter);
                card.style.display = hien ? '' : 'none';
            });

            floors.forEach(floor => {
                const soPhong = [...floor.querySelectorAll('.room-card')]
                    .filter(c => c.style.display !== 'none').length;
                floor.style.display = soPhong > 0 ? '' : 'none';
                const dem = floor.querySelector('.room-floor-heading span');
                if (dem) dem.textContent = soPhong + ' phòng';
            });
        }

        chips.forEach(chip => {
            chip.addEventListener('click', function () {
                chips.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                locPhong(this.dataset.filter);
            });
        });
    })();
</script>