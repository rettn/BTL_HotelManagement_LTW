@model HotelManagement.Models.Phong

@{
    var tt = Model.TrangThai?.Trim() ?? "";

    bool laTrong = tt == "Trong" || tt == "Trống";
    bool daDat = tt == "DaDat" || tt == "Đã đặt";
    bool dangSuDung = tt == "DangSuDung" || tt == "Đang sử dụng";
    bool dangDon = tt == "DangDon" || tt == "Đang dọn dẹp";

    var chiTiet = ViewBag.ChiTietDatPhong
        as HotelManagement.Models.ChiTietDatPhong;

    var datPhong = chiTiet?.DatPhong;
    var khachHang = ViewBag.KhachHang
        as HotelManagement.Models.KhachHang;

    var luuTru = ViewBag.LuuTru
        as HotelManagement.Models.LuuTru;

    var ngayNhan = chiTiet?.NgayNhan;
    var ngayTra = chiTiet?.NgayTra;

    var soDem = ngayNhan.HasValue && ngayTra.HasValue
        ? Math.Max(0, (ngayTra.Value.Date - ngayNhan.Value.Date).Days)
        : 0;

    string tenTrangThai = tt switch
    {
        "Trong" or "Trống" => "Phòng trống",
        "DaDat" or "Đã đặt" => "Đã đặt trước",
        "DangSuDung" or "Đang sử dụng" => "Đang sử dụng",
        "DangDon" or "Đang dọn dẹp" => "Đang dọn dẹp",
        "" => "Chưa xác định",
        _ => tt
    };

    string lopTrangThai = tt switch
    {
        "Trong" or "Trống" => "rp-badge-empty",
        "DaDat" or "Đã đặt" => "rp-badge-booked",
        "DangSuDung" or "Đang sử dụng" => "rp-badge-occupied",
        "DangDon" or "Đang dọn dẹp" => "rp-badge-cleaning",
        _ => "rp-badge-other"
    };
}

<div class="rp-header">
    <div class="rp-title">
        <h2>Phòng @Model.SoPhong</h2>
        <span class="rp-badge @lopTrangThai">@tenTrangThai</span>
    </div>
    <div class="rp-header-actions">
        <a asp-controller="Phong" asp-action="Edit" asp-route-id="@Model.MaPhong" class="rp-text-btn">
            <i class="bi bi-pencil"></i> Chỉnh sửa
        </a>
        <a asp-controller="Phong" asp-action="Delete" asp-route-id="@Model.MaPhong" class="rp-text-btn rp-text-danger">
            <i class="bi bi-trash"></i> Xóa
        </a>
        <button type="button" class="rp-close-btn" id="closeRoomModalBtn" aria-label="Đóng">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>

<div class="rp-body">
    <div class="rp-info-grid">
        <div class="rp-info-card">
            <div class="rp-info-label"><i class="bi bi-door-open"></i> Loại phòng</div>
            <div class="rp-info-value">@(Model.LoaiPhong?.TenLoaiPhong ?? "Chưa phân loại")</div>
        </div>
        <div class="rp-info-card">
            <div class="rp-info-label"><i class="bi bi-people"></i> Sức chứa tối đa</div>
            <div class="rp-info-value">@(Model.LoaiPhong?.SoNguoiToiDa ?? 2) người</div>
        </div>
        <div class="rp-info-card">
            <div class="rp-info-label"><i class="bi bi-cash-coin"></i> Giá theo đêm</div>
            <div class="rp-info-value rp-price">@(Model.LoaiPhong?.GiaTheoDem.ToString("N0") ?? "0") đ / đêm</div>
        </div>
    </div>

    @if (chiTiet != null && datPhong != null)
    {
        <div class="rp-booking-info">
            <div class="rp-booking-heading">
                <i class="bi bi-calendar-check"></i>
                Thông tin đặt phòng
            </div>

            <div class="rp-booking-row">
                <div class="rp-booking-icon">
                    <i class="bi bi-clock"></i>
                </div>

                <div class="rp-booking-content">
                    <div class="rp-booking-label">Thời gian lưu trú dự kiến</div>

                    <div class="rp-booking-dates">
                        @chiTiet.NgayNhan.ToString("dd/MM/yyyy")
                        <i class="bi bi-arrow-right"></i>
                        @chiTiet.NgayTra.ToString("dd/MM/yyyy")
                    </div>

                    <div class="rp-booking-nights">
                        <i class="bi bi-moon-stars"></i>
                        @soDem đêm
                    </div>
                </div>
            </div>

            <div class="rp-booking-row">
                <div class="rp-booking-icon">
                    <i class="bi bi-person"></i>
                </div>

                <div class="rp-booking-content">
                    <div class="rp-booking-label">Khách hàng</div>

                    <div class="rp-booking-value">
                        @(khachHang?.HoTen ?? "Chưa có thông tin khách hàng")
                    </div>

                    <div class="rp-booking-sub">
                        <i class="bi bi-telephone"></i>
                        @(string.IsNullOrWhiteSpace(khachHang?.SoDienThoai)
                            ? "Chưa có số điện thoại"
                            : khachHang.SoDienThoai)
                    </div>
                </div>
            </div>

            <div class="rp-booking-row">
                <div class="rp-booking-icon">
                    <i class="bi bi-journal-text"></i>
                </div>

                <div class="rp-booking-content">
                    <div class="rp-booking-label">Ghi chú đặt phòng</div>

                    @if (string.IsNullOrWhiteSpace(datPhong.GhiChu))
                    {
                        <div class="rp-muted">Không có ghi chú</div>
                    }
                    else
                    {
                        <div class="rp-booking-value">@datPhong.GhiChu</div>
                    }
                </div>
            </div>

            @if (dangSuDung && luuTru != null)
            {
                <div class="rp-stay-status">
                    <i class="bi bi-check-circle-fill"></i>
                    Đã nhận phòng lúc
                    @(luuTru.ThoiGianNhanPhong?.ToString("HH:mm dd/MM/yyyy")
                        ?? "Chưa xác định")
                </div>
            }
        </div>
    }
    else if (laTrong)
    {
        <div class="rp-no-booking">
            <i class="bi bi-calendar-plus"></i>
            Phòng hiện chưa có thông tin đặt phòng.
        </div>
    }

    <div class="rp-note">
        <div class="rp-info-label"><i class="bi bi-journal-text"></i> Ghi chú phòng</div>
        @if (string.IsNullOrWhiteSpace(Model.GhiChu))
        {
            <div class="rp-muted">Chưa có ghi chú</div>
        }
        else
        {
            <div>@Model.GhiChu</div>
        }
    </div>
</div>

<div class="rp-footer">
    <button type="button"
            class="rp-secondary-btn"
            id="closeRoomModalFooterBtn">
        Đóng
    </button>

    @if (laTrong)
    {
        <a asp-controller="DatPhong"
           asp-action="Create"
           asp-route-maPhong="@Model.MaPhong"
           class="rp-main-btn">
            <i class="bi bi-calendar-plus"></i>
            Đặt phòng
        </a>
    }
    else if (daDat && datPhong != null)
    {
        <button type="button"
                class="rp-main-btn"
                onclick="thucHienThaoTacPhong(
                    '@Url.Action("CheckIn", "DatPhong")',
                    @datPhong.MaDatPhong,
                    @Model.MaPhong,
                    'Xác nhận nhận phòng cho khách?')">
            <i class="bi bi-box-arrow-in-right"></i>
            Nhận phòng
        </button>

        <button type="button"
                class="rp-danger-btn"
                onclick="thucHienThaoTacPhong(
                    '@Url.Action("Cancel", "DatPhong")',
                    @datPhong.MaDatPhong,
                    @Model.MaPhong,
                    'Bạn có chắc chắn muốn hủy phiếu đặt phòng này?')">
            <i class="bi bi-calendar-x"></i>
            Hủy đặt phòng
        </button>
    }
    else if (dangSuDung)
    {
        <span class="rp-stay-label">
            <i class="bi bi-person-check"></i>
            Khách đang lưu trú
        </span>

        <button type="button"
                class="rp-main-btn"
                onclick="moDichVu(@Model.MaPhong)">
            <i class="bi bi-cup-hot"></i>
            Dịch vụ
        </button>

        @if (datPhong != null)
        {
            <button type="button"
                    class="rp-main-btn"
                    onclick="thucHienThaoTacPhong(
                            '@Url.Action("CheckOut", "DatPhong")',
                            @datPhong.MaDatPhong,
                            @Model.MaPhong,
                            'Xác nhận trả phòng? Phòng sẽ chuyển sang trạng thái đang dọn dẹp.')">
                <i class="bi bi-box-arrow-right"></i>
                Trả phòng
            </button>
        }
    }
    else if (dangDon)
    {
        <button type="button"
                class="rp-main-btn"
                onclick="thucHienThaoTacPhong(
                    '@Url.Action("DonDepXong", "DatPhong")',
                    0,
                    @Model.MaPhong,
                    'Xác nhận phòng đã dọn dẹp xong? Phòng sẽ chuyển về trạng thái trống.')">
            <i class="bi bi-check2-circle"></i>
            Dọn dẹp xong
        </button>
    }
</div>

<style>
    .rp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 22px 28px;
        border-bottom: 1px solid #e5e7eb;
    }

    .rp-title {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .rp-title h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #1f2937;
        }

    .rp-badge {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .rp-badge-empty {
        background: #e7f7ed;
        color: #21834d;
    }

    .rp-badge-booked {
        background: #fff3dc;
        color: #b87508;
    }

    .rp-badge-occupied {
        background: #fdeaea;
        color: #bd3535;
    }

    .rp-badge-cleaning {
        background: #e9f2ff;
        color: #2563b7;
    }

    .rp-badge-other {
        background: #eef0f4;
        color: #626d7e;
    }

    .rp-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rp-text-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 9px;
        background: #f1f5f9;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, color .2s;
    }

        .rp-text-btn:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .rp-text-danger:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .rp-close-btn {
        display: inline-flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 9px;
        background: #f1f5f9;
        color: #475569;
        cursor: pointer;
    }

        .rp-close-btn:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    .rp-body {
        padding: 24px 28px;
    }

    .rp-info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 16px;
    }

    .rp-info-card,
    .rp-note {
        padding: 16px 18px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f8fafc;
        color: #374151;
        font-size: 15px;
    }

    .rp-info-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    .rp-info-value {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .rp-price {
        color: #15803d;
    }

    .rp-muted {
        color: #8b94a3;
    }

    .rp-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 28px 22px;
        border-top: 1px solid #e5e7eb;
    }

    .rp-secondary-btn {
        padding: 12px 24px;
        border: 0;
        border-radius: 8px;
        background: #eef2f7;
        color: #374151;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

        .rp-secondary-btn:hover {
            background: #e2e8f0;
        }

    .rp-main-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 28px;
        border-radius: 8px;
        background: #198754;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s;
    }

        .rp-main-btn:hover {
            background: #157347;
            color: #fff;
        }
    
    .rp-booking-info {
        margin-bottom: 16px;
        padding: 20px;
        border: 1px solid #dcefe3;
        border-radius: 12px;
        background: #fbfefc;
    }

    .rp-booking-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #166534;
        font-size: 16px;
        font-weight: 700;
    }

    .rp-booking-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
        border-top: 1px solid #e5eee8;
    }

    .rp-booking-icon {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #e7f7ed;
        color: #15803d;
        font-size: 18px;
    }

    .rp-booking-content {
        min-width: 0;
        flex: 1;
    }

    .rp-booking-label {
        margin-bottom: 5px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .rp-booking-dates {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        color: #1f2937;
        font-weight: 700;
    }

    .rp-booking-dates i {
        color: #94a3b8;
    }

    .rp-booking-nights {
        margin-top: 7px;
        color: #15803d;
        font-size: 14px;
        font-weight: 700;
    }

    .rp-booking-value {
        color: #1f2937;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .rp-booking-sub {
        margin-top: 5px;
        color: #64748b;
        font-size: 14px;
    }

    .rp-booking-sub i {
        margin-right: 5px;
    }

    .rp-no-booking {
        margin-bottom: 16px;
        padding: 18px;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        color: #64748b;
        text-align: center;
    }

    .rp-stay-status,
    .rp-stay-label {
        color: #15803d;
        font-size: 14px;
        font-weight: 600;
    }

    .rp-footer .rp-stay-label {
        order: -1;
        margin-right: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .rp-inline-form {
        display: inline-flex;
        margin: 0;
    }

    .rp-danger-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border: 0;
        border-radius: 8px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }

    .rp-danger-btn:hover {
        background: #fecaca;
    }

    @@media (max-width: 800px) {
        .rp-info-grid {
            grid-template-columns: 1fr;
        }

        .rp-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>