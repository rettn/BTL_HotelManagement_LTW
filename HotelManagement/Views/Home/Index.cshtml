@inject HotelManagement.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Trang chủ khách sạn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var caiDat = DbContext.CaiDatHeThongs.FirstOrDefault();
    var hotelName = !string.IsNullOrWhiteSpace(caiDat?.TenKhachSan) ? caiDat.TenKhachSan : "HOTEL MANAGEMENT";
    var hotelLogo = !string.IsNullOrWhiteSpace(caiDat?.HinhAnh) ? caiDat.HinhAnh : Url.Content("~/images/logo2.webp");
}
<main class="hotel-home">

    <!-- BANNER CHÍNH -->
    <section class="hero" id="hero">
        <div class="hero-image" id="heroImage"></div>
        <div class="hero-overlay"></div>

        <!-- Thanh đầu banner -->
        <div class="hero-top">
            <a class="hotel-logo" asp-controller="Home" asp-action="Index">
                <img src="@hotelLogo" alt="@hotelName" style="width: 43px; height: 43px; object-fit: contain; border-radius: 8px;" />
                <span class="hotel-name">@hotelName.ToUpperInvariant()</span>
            </a>

            <div class="hero-actions">
                <button id="themeToggle"
                        class="theme-toggle"
                        type="button"
                        aria-label="Chuyển giao diện sáng tối"
                        title="Chuyển giao diện sáng tối">
                    <span id="themeIcon">☾</span>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="login-button book-btn-highlight"
                       asp-controller="DatPhongKhachHang"
                       asp-action="Index">
                        <i class="fa-solid fa-calendar-plus me-1"></i> ĐẶT PHÒNG
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                    {
                        <a class="login-button"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            QUẢN TRỊ
                        </a>
                    }
                    else
                    {
                        <a class="login-button"
                           asp-controller="Account"
                           asp-action="Profile"
                           title="Tài khoản cá nhân">
                            <i class="fa-solid fa-user me-1"></i> TÀI KHOẢN
                        </a>
                    }

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-btn-header" title="Đăng xuất">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a class="login-button book-btn-highlight"
                       asp-controller="DatPhongKhachHang"
                       asp-action="Index">
                        <i class="fa-solid fa-calendar-plus me-1"></i> ĐẶT PHÒNG
                    </a>
                    <a class="login-button"
                       asp-controller="Account"
                       asp-action="Login">
                        ĐĂNG NHẬP
                    </a>
                }
            </div>
        </div>

        <!-- Nội dung giới thiệu -->
        <div class="hero-content" id="heroContent">
            <p class="hero-eyebrow" id="heroEyebrow">
                WELCOME TO OUR HOTEL
            </p>

            <h1 id="heroTitle">
                TRẢI NGHIỆM NGHỈ DƯỠNG ĐẲNG CẤP
            </h1>

            <p class="hero-description" id="heroDescription">
                Không gian tinh tế, dịch vụ tận tâm, trải nghiệm khác biệt.
            </p>

            <div class="hero-buttons-group">
                <a class="hero-button booking-cta" asp-controller="DatPhongKhachHang" asp-action="Index">
                    <i class="fa-solid fa-calendar-check me-2"></i> ĐẶT PHÒNG NGAY
                </a>
                <a class="hero-button hero-button-secondary" href="#discover">
                    KHÁM PHÁ KHÁCH SẠN
                    <span>↗</span>
                </a>
            </div>
        </div>

        <!-- Chuyển banner -->
        <div class="hero-controls">
            <div class="hero-tabs" role="group" aria-label="Chọn nội dung giới thiệu">
                <button type="button" class="hero-tab active"
                        data-slide="0" aria-label="Giới thiệu khách sạn">
                     Khách sạn
                </button>
                <button type="button" class="hero-tab"
                        data-slide="1" aria-label="Giới thiệu phòng nghỉ">
                     Phòng nghỉ
                </button>
                <button type="button" class="hero-tab"
                        data-slide="2" aria-label="Giới thiệu dịch vụ">
                     Dịch vụ
                </button>
            </div>

            <div class="hero-arrows">
                <button type="button" id="prevSlide" aria-label="Banner trước">←</button>
                <button type="button" id="nextSlide" aria-label="Banner tiếp theo">→</button>
            </div>
        </div>

        <div class="hero-counter">
            <span id="currentSlide">01</span>
            <span class="counter-line"></span>
            <span>03</span>
        </div>
    </section>

    <!-- THANH ĐIỀU HƯỚNG -->
    <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">
            HOTEL
        </a>

        <div class="nav-links">
            <a href="#discover">Trang chủ</a>
            <a asp-controller="DatPhongKhachHang" asp-action="Index">Đặt phòng</a>
            <a href="#rooms">Phòng nghỉ</a>
            <a href="#services">Dịch vụ</a>
            <a href="#dining">Ẩm thực</a>
            <a href="#about">Giới thiệu</a>
            <a href="#contact">Liên hệ</a>
        </div>

        <button type="button" class="mobile-menu"
                id="mobileMenu" aria-label="Mở menu">
            ☰
        </button>
    </nav>

    <!-- GIỚI THIỆU -->
    <section class="intro-section" id="discover">
        <p class="section-eyebrow reveal">DISCOVER OUR HOTEL</p>
        <h2 class="section-title reveal">
            NƠI MỖI KHOẢNH KHẮC<br />
            ĐỀU TRỞ THÀNH TRẢI NGHIỆM
        </h2>
        <p class="section-description reveal">
            Khám phá không gian nghỉ dưỡng, tiện nghi hiện đại
            và những dịch vụ được thiết kế dành riêng cho bạn.
        </p>

        <div class="feature-grid">
            <a class="feature-card reveal" id="rooms" href="#contact">
                <div class="feature-image image-room"></div>
                <div class="feature-info">
                    <span>01 / ACCOMMODATION</span>
                    <h3>Phòng nghỉ</h3>
                    <p>Không gian riêng tư và tiện nghi.</p>
                    <span class="feature-arrow">↗</span>
                </div>
            </a>

            <a class="feature-card reveal" id="dining" href="#contact">
                <div class="feature-image image-dining"></div>
                <div class="feature-info">
                    <span>02 / DINING</span>
                    <h3>Ẩm thực</h3>
                    <p>Khám phá những trải nghiệm vị giác.</p>
                    <span class="feature-arrow">↗</span>
                </div>
            </a>

            <a class="feature-card reveal" id="services" href="#contact">
                <div class="feature-image image-service"></div>
                <div class="feature-info">
                    <span>03 / EXPERIENCE</span>
                    <h3>Dịch vụ</h3>
                    <p>Tận hưởng kỳ nghỉ theo cách riêng.</p>
                    <span class="feature-arrow">↗</span>
                </div>
            </a>
        </div>
    </section>

    <!-- PHẦN CUỐI TRANG -->
    <footer class="hotel-footer" id="contact">
        <div>
            <span class="footer-logo">HOTEL MANAGEMENT</span>
            <p>Không gian nghỉ dưỡng dành cho bạn.</p>
        </div>
        <div class="footer-right" id="about">
            <span>Địa chỉ: Số 3 Cầu Giấy, Hà Nội</span>
            <span>Điện thoại: 0379 868 686</span>
            <span>Email: thetoan.official@gmail.com</span>
        </div>
    </footer>

</main>

@section Styles {
    <style>
        .book-btn-highlight {
            background: #b99a7e !important;
            border-color: #b99a7e !important;
            color: #ffffff !important;
            font-weight: 600;
        }

        .book-btn-highlight:hover {
            background: #9d7d60 !important;
            color: #ffffff !important;
        }

        .logout-btn-header {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .logout-btn-header:hover {
            background: rgba(220, 53, 69, 0.85);
            border-color: #dc3545;
            color: #ffffff;
        }

        .hero-buttons-group {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .booking-cta {
            background: #b99a7e !important;
            color: #ffffff !important;
            border: 1px solid #b99a7e !important;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(185, 154, 126, 0.4);
        }

        .booking-cta:hover {
            background: #9d7d60 !important;
            border-color: #9d7d60 !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(157, 125, 96, 0.55);
        }

        .hero-button-secondary {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.6);
            color: #ffffff;
        }
    </style>
}

@section Scripts {
    <script src="~/js/hotel-home.js" asp-append-version="true"></script>
}
