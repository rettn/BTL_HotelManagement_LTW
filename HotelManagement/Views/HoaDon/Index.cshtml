@model HotelManagement.ViewModels.HoaDonIndexViewModel

@{
    ViewData["Title"] = "Hóa đơn & thanh toán";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-0">
    <!-- Tiêu đề & Thống kê nhanh -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                Quản lý hóa đơn
            </h3>
            <p class="text-muted small mb-0">Theo dõi, tìm kiếm và tra cứu lịch sử thanh toán hóa đơn khách sạn</p>
        </div>
        <div class="d-flex gap-3">
            <div class="bg-white border rounded px-3 py-2 shadow-sm text-end">
                <small class="text-muted d-block">Tổng số hóa đơn</small>
                <strong class="text-primary fs-6">@Model.TongSoHoaDon</strong>
            </div>
            <div class="bg-white border rounded px-3 py-2 shadow-sm text-end">
                <small class="text-muted d-block">Đã thu thành công</small>
                <strong class="text-success fs-6">@Model.TongTienDaThu.ToString("N0") đ</strong>
            </div>
        </div>
    </div>

    <!-- Thanh tìm kiếm & Bộ lọc -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control border-start-0 ps-0" 
                               placeholder="Mã HD, tên khách, SĐT..." />
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="TatCa" selected="@(string.IsNullOrEmpty(Model.TrangThai) || Model.TrangThai == "TatCa")">-- Tất cả --</option>
                        <option value="DaThanhToan" selected="@(Model.TrangThai == "DaThanhToan")">Đã thanh toán</option>
                        <option value="ChuaThanhToan" selected="@(Model.TrangThai == "ChuaThanhToan")">Chưa thanh toán</option>
                        <option value="DaHuy" selected="@(Model.TrangThai == "DaHuy")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Đến ngày</label>
                    <input type="date" name="denNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>

                <div class="col-lg-3 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel-fill me-1"></i>Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-50" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách Hóa đơn -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary text-uppercase fs-7 fw-bold">
                    <tr>
                        <th class="ps-3" style="width: 100px;">Mã HD</th>
                        <th>Khách hàng</th>
                        <th>Phòng</th>
                        <th>Ngày lập</th>
                        <th class="text-end">Tiền phòng</th>
                        <th class="text-end">Tiền dịch vụ</th>
                        <th class="text-end">Tổng cộng</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-3" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSachHoaDon.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy hóa đơn nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DanhSachHoaDon)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">#HD@(item.MaDatPhong)@(item.NgayLap.ToString("yyyyMMdd"))</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.TenKhachHang</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(string.IsNullOrEmpty(item.SoDienThoai) ? "N/A" : item.SoDienThoai)</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-door-closed me-1"></i>@(string.IsNullOrEmpty(item.DanhSachPhong) ? "P.N/A" : item.DanhSachPhong)
                                    </span>
                                </td>
                                <td>
                                    <div>@item.NgayLap.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.NgayLap.ToString("HH:mm")</small>
                                </td>
                                <td class="text-end text-muted">@item.TienPhong.ToString("N0") đ</td>
                                <td class="text-end text-muted">@item.TienDichVu.ToString("N0") đ</td>
                                <td class="text-end fw-bold text-danger">@item.TongTien.ToString("N0") đ</td>
                                <td class="text-center">
                                    @switch (item.TrangThai)
                                    {
                                        case "DaThanhToan":
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                            </span>
                                            break;
                                        case "ChuaThanhToan":
                                            <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3 py-1">
                                                <i class="bi bi-clock-history me-1"></i>Chưa thanh toán
                                            </span>
                                            break;
                                        case "DaHuy":
                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge rounded-pill bg-secondary px-3 py-1">@item.TrangThai</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/HoaDon/Details/@item.MaHD" class="btn btn-outline-primary" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang Bootstrap 5 -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    Hiển thị <strong>@((Model.PageIndex - 1) * Model.PageSize + 1)</strong> đến 
                    <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems))</strong> trong tổng số 
                    <strong>@Model.TotalItems</strong> hóa đơn
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.PageIndex - 1)" 
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                                   asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.PageIndex + 1)" 
                               asp-route-tuKhoa="@Model.TuKhoa"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

