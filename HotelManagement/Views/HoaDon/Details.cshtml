@model HotelManagement.ViewModels.HoaDonCheckoutViewModel

@{
    ViewData["Title"] = $"Chi tiết Hóa đơn #{ViewBag.MaHoaDon}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var ngayLap = ViewBag.NgayLap != null ? (DateTime)ViewBag.NgayLap : DateTime.Now;
    var trangThai = ViewBag.TrangThai as string ?? "DaThanhToan";
    var phuongThuc = ViewBag.PhuongThucThanhToan as string ?? "TienMat";

    // Cấu hình hiển thị tem trạng thái động
    string stampText = "Đã thanh toán";
    string stampSubText = "Giao dịch thành công";
    string stampStyle = "border: 2px dashed #16804a; color: #16804a; background: #e4f8ed;";
    string totalLabelText = "TỔNG TIỀN ĐÃ THANH TOÁN:";

    if (trangThai == "DaHuy")
    {
        stampText = "ĐÃ HỦY";
        stampSubText = "Đơn đã bị hủy";
        stampStyle = "border: 2px dashed #c03939; color: #c03939; background: #ffe8e8;";
        totalLabelText = "TỔNG TIỀN HỦY / HOÀN CỌC:";
    }
    else if (trangThai == "DaCoc")
    {
        stampText = "ĐÃ ĐẶT CỌC";
        stampSubText = "Thanh toán tiền cọc";
        stampStyle = "border: 2px dashed #986500; color: #986500; background: #fff3d6;";
        totalLabelText = "TỔNG TIỀN CỌC:";
    }
}

<style>
    .invoice-detail-wrapper {
        max-width: 820px;
        margin: 20px auto;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        padding: 40px;
        color: #263449;
    }

    .invoice-card {
        background: #fcfbfa;
        border: 1px solid #e9e3dc;
        border-radius: 12px;
        padding: 30px;
        text-align: left;
        position: relative;
        margin-bottom: 25px;
    }

    .invoice-code-label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .invoice-code-val {
        font-size: 18px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
    }

    .status-stamp-right {
        position: absolute;
        top: 25px;
        right: 25px;
        padding: 5px 12px;
        font-weight: 700;
        font-size: 13px;
        border-radius: 8px;
        transform: rotate(6deg);
        text-transform: uppercase;
        text-align: center;
    }

    .status-stamp-sub {
        font-size: 9px;
        display: block;
        font-weight: 500;
        letter-spacing: -0.2px;
    }

    .info-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 24px;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9e3dc;
    }

    .info-item-box label {
        font-size: 12px;
        color: #64748b;
        display: block;
        margin-bottom: 2px;
    }

    .info-item-box span {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
    }

    .section-subtitle {
        font-weight: 700;
        font-size: 14px;
        color: #334155;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .table-details {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .table-details th {
            background: #f4efe6;
            color: #475569;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            padding: 10px 12px;
            text-align: left;
        }

        .table-details td {
            padding: 12px;
            border-bottom: 1px solid #e9e3dc;
            font-size: 13px;
            color: #1e293b;
            vertical-align: middle;
        }

    .calculation-box {
        background: #fff;
        border: 1px solid #e9e3dc;
        border-radius: 8px;
        padding: 16px 20px;
    }

    .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 13px;
        color: #64748b;
    }

    .calc-total-row {
        display: flex;
        justify-content: space-between;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 2px solid #cbd5e1;
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
    }

    @@media print {
        .d-print-none,
        nav,
        footer,
        aside,
        .sidebar,
        .navbar,
        header,
        .main-sidebar,
        .main-header {
            display: none !important;
        }

        body {
            background-color: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .invoice-detail-wrapper {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="bi bi-printer me-1"></i>In Hóa Đơn
        </button>
    </div>

    <div class="invoice-detail-wrapper">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-1">HÓA ĐƠN CHI TIẾT</h3>
            <p class="text-muted small">Thông tin quyết toán và lịch sử thanh toán dịch vụ lưu trú khách sạn</p>
        </div>

        <div class="invoice-card">
            <!-- Tem trạng thái động theo cơ sở dữ liệu -->
            <div class="status-stamp-right" style="@stampStyle">
                @stampText
                <span class="status-stamp-sub">@stampSubText</span>
            </div>

            <div class="invoice-code-label">Mã hóa đơn dịch vụ</div>
            <div class="invoice-code-val">#@(ViewBag.MaHoaDon)</div>

            <div class="info-grid-2">
                <div class="info-item-box">
                    <label>Khách hàng:</label>
                    <span>@Model.TenKhachHang</span>
                </div>
                <div class="info-item-box">
                    <label>Số điện thoại:</label>
                    <span>@(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa có" : Model.SoDienThoai)</span>
                </div>
                <div class="info-item-box">
                    <label>Phòng nghỉ:</label>
                    <span>Phòng @Model.SoPhong (@Model.TenLoaiPhong)</span>
                </div>
                <div class="info-item-box">
                    <label>Thời gian lưu trú:</label>
                    <span>@Model.SoDem đêm (@Model.NgayNhan.ToString("dd/MM/yyyy") → @Model.NgayTraThucTe.ToString("dd/MM/yyyy"))</span>
                </div>
                <div class="info-item-box">
                    <label>Hình thức thanh toán:</label>
                    <span class="text-success">
                        @if (phuongThuc == "ChuyenKhoan")
                        {
                            <text><i class="bi bi-qr-code"></i> Chuyển khoản VietQR</text>
                        }
                        else
                        {
                            <text><i class="bi bi-wallet2"></i> Tiền mặt tại quầy</text>
                        }
                    </span>
                </div>
                <div class="info-item-box">
                    <label>Ngày lập hóa đơn:</label>
                    <span>@ngayLap.ToString("HH:mm - dd/MM/yyyy")</span>
                </div>
            </div>

            <div class="section-subtitle">
                <i class="bi bi-list-check text-warning"></i> Chi tiết các khoản thanh toán:
            </div>

            <table class="table-details">
                <thead>
                    <tr>
                        <th>Khoản mục</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Tiền phòng (@Model.TenLoaiPhong)</strong><br /><small class="text-muted">Phòng @Model.SoPhong</small></td>
                        <td class="text-center">@Model.SoDem đêm</td>
                        <td class="text-end">@Model.GiaTheoDem.ToString("N0") đ</td>
                        <td class="text-end">@Model.TienPhong.ToString("N0") đ</td>
                    </tr>
                    @if (Model.DanhSachDichVu != null && Model.DanhSachDichVu.Any())
                    {
                        foreach (var dv in Model.DanhSachDichVu)
                        {
                            <tr>
                                <td>Dịch vụ: @dv.TenDichVu</td>
                                <td class="text-center">@dv.SoLuong</td>
                                <td class="text-end">@dv.DonGia.ToString("N0") đ</td>
                                <td class="text-end">@dv.ThanhTien.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="calculation-box">
                <div class="calc-row">
                    <span>Tiền phòng:</span>
                    <span>@Model.TienPhong.ToString("N0") đ</span>
                </div>
                <div class="calc-row">
                    <span>Tiền dịch vụ phát sinh:</span>
                    <span>@Model.TongTienDichVu.ToString("N0") đ</span>
                </div>
                <div class="calc-row">
                    <span>Thuế VAT (@Model.TiLeThuePercent%):</span>
                    <span>+@Model.TienThue.ToString("N0") đ</span>
                </div>
                <div class="calc-total-row">
                    <span>@totalLabelText</span>
                    <span class="text-danger">@Model.TongThanhToan.ToString("N0") đ</span>
                </div>
            </div>
        </div>
    </div>
</div>