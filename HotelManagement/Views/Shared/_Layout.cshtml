
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar" id="sidebar">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <span class="brand-icon"><i class="bi bi-buildings-fill"></i></span>
                <span>Hotel<span class="brand-light">Manager</span></span>
            </a>

            <div class="sidebar-label">TỔNG QUAN</div>
            <a asp-controller="Home" asp-action="Index" class="nav-item-custom">
                <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
            </a>

            <div class="sidebar-label">QUẢN LÝ KHÁCH SẠN</div>
            <a asp-controller="Phong" asp-action="Index" class="nav-item-custom">
                <i class="bi bi-door-closed-fill"></i><span>Quản lý phòng</span>
            </a>
            <a asp-controller="LoaiPhong" asp-action="Index" class="nav-item-custom">
                <i class="bi bi-tags-fill"></i><span>Loại phòng</span>
            </a>
            <a href="#" class="nav-item-custom">
                <i class="bi bi-calendar2-check-fill"></i><span>Đặt phòng</span>
                <span class="nav-soon">Sắp có</span>
            </a>
            <a href="#" class="nav-item-custom">
                <i class="bi bi-people-fill"></i><span>Khách hàng</span>
            </a>
            <a href="#" class="nav-item-custom">
                <i class="bi bi-cup-hot-fill"></i><span>Dịch vụ</span>
            </a>

            <div class="sidebar-label">TÀI CHÍNH & HỆ THỐNG</div>
            <a href="#" class="nav-item-custom">
                <i class="bi bi-receipt"></i><span>Hóa đơn</span>
            </a>
            <a href="#" class="nav-item-custom">
                <i class="bi bi-person-badge-fill"></i><span>Nhân viên</span>
            </a>

            <div class="sidebar-bottom">
                <div class="sidebar-bottom-icon">
                    <i class="bi bi-headset"></i>
                </div>
                <div>
                    <div class="small fw-semibold">Cần hỗ trợ?</div>
                    <div class="small text-white-50">Liên hệ quản trị viên</div>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <button class="btn btn-light sidebar-toggle d-lg-none"
                        type="button" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="topbar-heading">
                    <div class="small text-secondary">HOTEL MANAGEMENT SYSTEM</div>
                    <div class="fw-semibold">Hệ thống quản lý khách sạn</div>
                </div>

                <div class="topbar-right ms-auto">
                    <span class="topbar-date d-none d-md-inline">
                        <i class="bi bi-calendar3 me-2"></i>Trang quản trị
                    </span>
                    <div class="avatar">AD</div>
                    <div class="d-none d-sm-block">
                        <div class="small fw-semibold">Quản trị viên</div>
                        <div class="small text-secondary">Administrator</div>
                    </div>
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>

            <footer class="page-footer">
                <span>© @DateTime.Now.Year HotelManager</span>
                <span>Hệ thống quản lý khách sạn</span>
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('sidebar-open');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
