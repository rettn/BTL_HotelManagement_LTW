                </header>

                <main class="admin-content">

                    @{
                        var pageBody = RenderBody();
                        using var pageBodyWriter = new System.IO.StringWriter();
                        pageBody.WriteTo(pageBodyWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
                        var pageBodyHtml = pageBodyWriter.ToString();
                        var successFlash = TempData["Success"] as string;
                        var errorFlash = TempData["Error"] as string;
                        var successAlreadyRendered = !string.IsNullOrWhiteSpace(successFlash)
                            && pageBodyHtml.Contains(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(successFlash), StringComparison.Ordinal);
                        var errorAlreadyRendered = !string.IsNullOrWhiteSpace(errorFlash)
                            && pageBodyHtml.Contains(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(errorFlash), StringComparison.Ordinal);
                    }
                    @if (!string.IsNullOrWhiteSpace(successFlash) && !successAlreadyRendered)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            @successFlash
                            <button type="button" class="btn-close" data-coreui-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorFlash) && !errorAlreadyRendered)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            @errorFlash
                            <button type="button" class="btn-close" data-coreui-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }

                    <div class="content-heading">
                        <div>
                            <h1>@ViewData["Title"]</h1>
                            <div class="breadcrumb-line">
                                <a asp-controller="Dashboard" asp-action="Index">Trang chủ</a>
                                <i class="bi bi-chevron-right"></i>
                                <span>@ViewData["Title"]</span>
                            </div>
                        </div>
                        <div class="content-date">
                            <i class="bi bi-calendar3"></i>@DateTime.Now.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    @pageBody
                </main>

                <footer class="admin-footer">
                    <span>© @DateTime.Now.Year @hotelName</span>
                    <span>Hệ thống quản lý khách sạn</span>
                </footer>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/@@coreui/coreui@5.4.3/dist/js/coreui.bundle.min.js"></script>
        <script>
            (() => {
                const shell = document.getElementById('adminShell');
                const overlay = document.getElementById('sidebarOverlay');
                const mobileButton = document.getElementById('mobileMenuButton');
                const collapseButton = document.getElementById('sidebarCollapse');
                const profileMenu = document.getElementById('profileMenu');
                const profileMenuButton = document.getElementById('profileMenuButton');
                const resizeHandle = document.getElementById('sidebarResizeHandle');
                const themeToggle = document.getElementById('themeToggle');
                const notificationRoot = document.getElementById('notificationMenuRoot');
                const notificationToggle = document.getElementById('notificationToggle');
                const notificationPopover = document.getElementById('notificationPopover');
                const notificationItems = document.getElementById('notificationItems');
                const notificationCount = document.getElementById('notificationCount');
                const markAllNotificationsRead = document.getElementById('markAllNotificationsRead');
                const themePicker = document.querySelector('.theme-picker');
                const themePickerToggle = document.getElementById('themePickerToggle');
                const themePickerMenu = document.getElementById('themePickerMenu');
                const accentOptions = document.querySelectorAll('[data-accent-choice]');
                const customColorInput = document.getElementById('themeCustomColor');
                const minSidebarWidth = 200;
                const maxSidebarWidth = 420;

                const syncThemeButton = () => {
                    const isDark = document.documentElement.dataset.theme === 'dark';
                    themeToggle?.setAttribute('aria-pressed', String(isDark));
                    themeToggle?.setAttribute('aria-label', isDark ? 'Bật giao diện sáng' : 'Bật giao diện tối');
                    themeToggle?.setAttribute('title', isDark ? 'Bật giao diện sáng' : 'Bật giao diện tối');
                    const icon = themeToggle?.querySelector('i');
                    if (icon) icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon-stars';
                };
                syncThemeButton();
                themeToggle?.addEventListener('click', () => {
                    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
                    if (nextTheme === 'dark') document.documentElement.dataset.theme = 'dark';
                    else document.documentElement.removeAttribute('data-theme');
                    try { localStorage.setItem('hotel-admin-theme', nextTheme); } catch { }
                    syncThemeButton();
                });

                const syncAccentOptions = () => {
                    const selectedAccent = document.documentElement.dataset.accent || 'green';
                    accentOptions.forEach(option => {
                        const selected = option.dataset.accentChoice === selectedAccent;
                        option.classList.toggle('is-selected', selected);
                        option.setAttribute('aria-pressed', String(selected));
                    });
                    document.querySelector('.theme-custom-option')?.classList.toggle('is-selected', selectedAccent === 'custom');
                };
                syncAccentOptions();
                if (document.documentElement.dataset.accent === 'custom') {
                    customColorInput.value = localStorage.getItem('hotel-admin-accent') || '#209c60';
                }
                themePickerToggle?.addEventListener('click', () => {
                    const isOpen = !themePickerMenu.hidden;
                    themePickerMenu.hidden = isOpen;
                    themePickerToggle.setAttribute('aria-expanded', String(!isOpen));
                });
                accentOptions.forEach(option => option.addEventListener('click', () => {
                    const accent = option.dataset.accentChoice;
                    if (!accent) return;
                    ['--admin-accent', '--theme-primary', '--theme-primary-hover', '--theme-primary-rgb', '--theme-on-primary']
                        .forEach(property => document.documentElement.style.removeProperty(property));
                    document.documentElement.dataset.accent = accent;
                    try { localStorage.setItem('hotel-admin-accent', accent); } catch { }
                    syncAccentOptions();
                }));
                customColorInput?.addEventListener('input', () => {
                    const color = customColorInput.value;
                    document.documentElement.dataset.accent = 'custom';
                    window.applyHotelAccentColor(color);
                    try { localStorage.setItem('hotel-admin-accent', color); } catch { }
                    syncAccentOptions();
                });
                document.addEventListener('click', event => {
                    if (themePicker && !themePicker.contains(event.target)) {
                        themePickerMenu.hidden = true;
                        themePickerToggle?.setAttribute('aria-expanded', 'false');
                    }
                });
                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape' && themePickerMenu && !themePickerMenu.hidden) {
                        themePickerMenu.hidden = true;
                        themePickerToggle?.setAttribute('aria-expanded', 'false');
                        themePickerToggle?.focus();
                    }
                });

                const notificationRecentUrl = '@Url.Action("Recent", "ThongBao")';
                const notificationToken = () => document.querySelector('#notificationTokenForm input[name="__RequestVerificationToken"]')?.value;
                const notificationDate = value => {
                    const date = new Date(value);
                    return Number.isNaN(date.getTime()) ? '' : new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }).format(date);
                };
                const renderNotifications = items => {
                    notificationItems.replaceChildren();
                    if (!items.length) {
                        const empty = document.createElement('div');
                        empty.className = 'notification-empty';
                        empty.textContent = 'Chưa có thông báo.';
                        notificationItems.appendChild(empty);
                        return;
                    }
                    items.forEach(item => {
                        const link = document.createElement('a');
                        link.className = `notification-item${item.daDoc ? '' : ' is-unread'}`;
                        link.href = item.url || '@Url.Action("Index", "ThongBao")';
                        link.dataset.notificationId = item.id;
                        const icon = document.createElement('span');
                        icon.className = 'notification-item-icon';
                        const iconElement = document.createElement('i');
                        iconElement.className = item.loaiThongBao?.startsWith('SapHetKho') ? 'bi bi-box-seam' : 'bi bi-calendar-check';
                        icon.appendChild(iconElement);
                        const content = document.createElement('span');
                        content.className = 'notification-item-content';
                        const title = document.createElement('strong');
                        title.textContent = item.tieuDe;
                        const body = document.createElement('span');
                        body.textContent = item.noiDung;
                        const date = document.createElement('small');
                        date.textContent = notificationDate(item.ngayTao);
                        content.append(title, body, date);
                        link.append(icon, content);
                        if (!item.daDoc) {
                            const unread = document.createElement('span');
                            unread.className = 'notification-item-unread';
                            unread.setAttribute('aria-label', 'Chưa đọc');
                            link.appendChild(unread);
                        }
                        link.addEventListener('click', async event => {
                            event.preventDefault();
                            if (!item.daDoc) await postNotificationAction('MarkRead', { id: item.id });
                            window.location.assign(link.href);
                        });
                        notificationItems.appendChild(link);
                    });
                };
                const loadNotifications = async () => {
                    if (!notificationItems) return;
                    try {
                        const response = await fetch(notificationRecentUrl, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
                        if (!response.ok) return;
                        const data = await response.json();
                        const unread = Number(data.unreadCount || 0);
                        notificationCount.hidden = unread === 0;
                        notificationCount.textContent = unread > 99 ? '99+' : String(unread);
                        notificationToggle?.setAttribute('aria-label', unread ? `Thông báo, ${unread} chưa đọc` : 'Thông báo');
                        markAllNotificationsRead.disabled = unread === 0;
                        renderNotifications(data.items || []);
                    } catch { }
                };
                async function postNotificationAction(action, values = {}) {
                    const body = new URLSearchParams(values);
                    const token = notificationToken();
                    if (token) body.set('__RequestVerificationToken', token);
                    const response = await fetch(`/ThongBao/${action}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'RequestVerificationToken': token || '', 'Accept': 'application/json' },
                        body
                    });
                    return response.ok;
                }
                notificationToggle?.addEventListener('click', async () => {
                    const open = notificationPopover.hidden;
                    notificationPopover.hidden = !open;
                    notificationToggle.setAttribute('aria-expanded', String(open));
                    if (open) await loadNotifications();
                });
                markAllNotificationsRead?.addEventListener('click', async () => {
                    if (await postNotificationAction('MarkAllRead')) await loadNotifications();
                });
                document.addEventListener('click', event => {
                    if (notificationRoot && !notificationRoot.contains(event.target)) {
                        notificationPopover.hidden = true;
                        notificationToggle?.setAttribute('aria-expanded', 'false');
                    }
                });
                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape' && notificationPopover && !notificationPopover.hidden) {
                        notificationPopover.hidden = true;
                        notificationToggle?.setAttribute('aria-expanded', 'false');
                        notificationToggle?.focus();
                    }
                });
                loadNotifications();
                window.setInterval(loadNotifications, 60000);

                try {
                    const savedWidth = Number(localStorage.getItem('hotel-admin-sidebar-width'));
                    if (Number.isFinite(savedWidth) && savedWidth >= minSidebarWidth && savedWidth <= maxSidebarWidth) {
                        shell.style.setProperty('--admin-sidebar-width', `${savedWidth}px`);
                    }
                } catch { }

                resizeHandle?.addEventListener('pointerdown', event => {
                    if (window.matchMedia('(max-width: 767.98px)').matches || shell.classList.contains('sidebar-collapsed')) return;
                    event.preventDefault();
                    resizeHandle.setPointerCapture(event.pointerId);
                    document.body.classList.add('sidebar-resizing');
                });

                resizeHandle?.addEventListener('pointermove', event => {
                    if (!resizeHandle.hasPointerCapture(event.pointerId)) return;
                    const width = Math.min(maxSidebarWidth, Math.max(minSidebarWidth, event.clientX));
                    shell.style.setProperty('--admin-sidebar-width', `${width}px`);
                });

                const stopSidebarResize = event => {
                    if (!resizeHandle?.hasPointerCapture(event.pointerId)) return;
                    resizeHandle.releasePointerCapture(event.pointerId);
                    document.body.classList.remove('sidebar-resizing');
                    try {
                        const width = parseFloat(getComputedStyle(shell).getPropertyValue('--admin-sidebar-width'));
                        localStorage.setItem('hotel-admin-sidebar-width', String(width));
                    } catch { }
                };
                resizeHandle?.addEventListener('pointerup', stopSidebarResize);
                resizeHandle?.addEventListener('pointercancel', stopSidebarResize);

                const closeProfileMenu = () => {
                    profileMenu?.classList.remove('is-open');
                    profileMenuButton?.setAttribute('aria-expanded', 'false');
                };

                // Bam nut tai khoan de mo/dong menu
                profileMenuButton?.addEventListener('click', event => {
                    event.stopPropagation();

                    const isOpen = profileMenu?.classList.toggle('is-open') ?? false;

                    profileMenuButton.setAttribute(
                        'aria-expanded',
                        isOpen ? 'true' : 'false'
                    );
                });

                // Bam ra ngoai thi dong menu
                document.addEventListener('click', event => {
                    if (profileMenu && !profileMenu.contains(event.target)) {
                        closeProfileMenu();
                    }
                });

                // Bam Escape thi dong menu
                document.addEventListener('keydown', event => {
                    if (event.key === 'Escape') {
                        closeProfileMenu();
                    }
                });

                document.querySelectorAll('[data-menu-toggle]').forEach(link => {
                    link.addEventListener('click', event => {
                        event.preventDefault();

                        const target = document.getElementById(link.dataset.menuToggle);
                        if (!target) return;

                        target.classList.toggle('show');
                        link.setAttribute(
                            'aria-expanded',
                            target.classList.contains('show') ? 'true' : 'false'
                        );
                    });
                });

                collapseButton?.addEventListener('click', () => {
                    shell.classList.toggle('sidebar-collapsed');
                });

                mobileButton?.addEventListener('click', () => {
                    shell.classList.toggle('mobile-sidebar-open');
                });

                overlay?.addEventListener('click', () => {
                    shell.classList.remove('mobile-sidebar-open');
                });

                document.addEventListener('keydown', event => {
                    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
                        event.preventDefault();
                        document.querySelector('.topbar-search input')?.focus();
                    }

                    if (event.key === 'Escape') {
                        shell.classList.remove('mobile-sidebar-open');
                    }
                });
            })();
        </script>
        <script>
            (() => {
                document.querySelectorAll('input[type="password"]').forEach(input => {

                    if (input.closest('.input-group')) return;

                    const wrap = document.createElement('div');
                    wrap.className = 'password-field';
                    input.parentNode.insertBefore(wrap, input);
                    wrap.appendChild(input);

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'password-toggle';
                    btn.setAttribute('aria-label', 'Hiện mật khẩu');
                    btn.innerHTML = '<i class="bi bi-eye"></i>';

                    btn.addEventListener('click', () => {
                        const show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.setAttribute('aria-label', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
                        btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    });

                    wrap.appendChild(btn);
                });
            })();
        </script>

        <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
<partial name="_ChatbotWidget" />
<script src="~/js/chatbot.js" asp-append-version="true"></script>
