@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject HotelManagement.Data.ApplicationDbContext DbContext
@{
    var hotelSettings = DbContext.CaiDatHeThongs.FirstOrDefault();
    var hotelName = !string.IsNullOrWhiteSpace(hotelSettings?.TenKhachSan) ? hotelSettings.TenKhachSan : "Hotel Manager";
    var hotelLogo = !string.IsNullOrWhiteSpace(hotelSettings?.HinhAnh) ? hotelSettings.HinhAnh : Url.Content("~/images/logo2.webp");

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isDashboardIndex = currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase)
    && (currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(currentAction));
    var isReportSection = currentController.Equals("Report", StringComparison.OrdinalIgnoreCase)
    || (currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("TaiChinh", StringComparison.OrdinalIgnoreCase));

    var isReservationSection = currentController.Equals("DatPhong", StringComparison.OrdinalIgnoreCase);
    var isFinanceSection = currentController.Equals("HoaDon", StringComparison.OrdinalIgnoreCase)
    || currentController.Equals("ThanhToan", StringComparison.OrdinalIgnoreCase);
    var isPayrollSection = new[] { "BangLuong", "Thuong", "PhuCap", "KhauTru" }.Contains(currentController, StringComparer.OrdinalIgnoreCase);
    var displayName = User.Identity?.IsAuthenticated == true
    ? (User.Identity?.Name ?? "Quản trị viên")
    : "Quản trị viên";
    var currentUser = User.Identity?.IsAuthenticated == true
    ? await UserManager.GetUserAsync(User)
    : null;
    var roles = currentUser is null
    ? Array.Empty<string>()
    : (await UserManager.GetRolesAsync(currentUser)).ToArray();
    var permittedModules = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    if (roles.Contains("Admin"))
    {
        foreach (var module in HotelManagement.Security.ModulePermissionCatalog.All)
            permittedModules.Add(module.Key);
    }
    else if (roles.Contains("NhanVien"))
    {
        var staffRole = await RoleManager.FindByNameAsync("NhanVien");
        if (staffRole != null)
            foreach (var claim in await RoleManager.GetClaimsAsync(staffRole))
                if (claim.Type == HotelManagement.Security.ModulePermissionCatalog.ClaimType)
                    permittedModules.Add(claim.Value);
    }
    bool CanAccess(string module) => permittedModules.Contains(module);
    var roleName = roles.FirstOrDefault() switch
    {
        "Admin" => "Quản trị viên",
        "NhanVien" => "Nhân viên",
        { Length: > 0 } role => role,
        _ => "Tài khoản"
    };
    var avatarInitial = displayName.Trim().Length > 0
    ? displayName.Trim()[0].ToString().ToUpperInvariant()
    : "A";
}
    <!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - @hotelName</title>

        <script>
            (() => {
                window.applyHotelAccentColor = hex => {
                    if (!/^#[0-9a-f]{6}$/i.test(hex)) return;
                    const root = document.documentElement;
                    const red = parseInt(hex.slice(1, 3), 16);
                    const green = parseInt(hex.slice(3, 5), 16);
                    const blue = parseInt(hex.slice(5, 7), 16);
                    const hover = [red, green, blue].map(value => Math.round(value * .78).toString(16).padStart(2, '0')).join('');
                    const luminance = (red * 299 + green * 587 + blue * 114) / 1000;
                    root.style.setProperty('--admin-accent', hex);
                    root.style.setProperty('--theme-primary', hex);
                    root.style.setProperty('--theme-primary-hover', `#${hover}`);
                    root.style.setProperty('--theme-primary-rgb', `${red}, ${green}, ${blue}`);
                    root.style.setProperty('--theme-on-primary', luminance > 165 ? '#263449' : '#fff');
                };
                try {
                    const theme = localStorage.getItem('hotel-admin-theme');
                    if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
                    const accent = localStorage.getItem('hotel-admin-accent') || 'green';
                    const customColor = /^#[0-9a-f]{6}$/i.test(accent);
                    document.documentElement.dataset.accent = customColor ? 'custom' : accent;
                    if (customColor) window.applyHotelAccentColor(accent);
                } catch { }
            })();
        </script>

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@coreui/coreui@5.4.3/dist/css/coreui.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />

        @await RenderSectionAsync("Styles", required: false)
    </head>
