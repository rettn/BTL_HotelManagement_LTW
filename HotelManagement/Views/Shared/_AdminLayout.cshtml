                                <button type="button" class="theme-color-option" data-accent-choice="amber" aria-label="Cam"><span class="theme-color-swatch theme-swatch-amber"></span><span>Cam</span><i class="bi bi-check2"></i></button>
                                <label class="theme-color-option theme-custom-option" for="themeCustomColor">
