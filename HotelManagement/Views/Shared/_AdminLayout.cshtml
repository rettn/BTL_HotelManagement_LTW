                                <button type="button" class="theme-color-option" data-accent-choice="green" aria-label="Xanh lá"><span class="theme-color-swatch theme-swatch-green"></span><span>Xanh lá</span><i class="bi bi-check2"></i></button>
                                <button type="button" class="theme-color-option" data-accent-choice="purple" aria-label="Tím"><span class="theme-color-swatch theme-swatch-purple"></span><span>Tím</span><i class="bi bi-check2"></i></button>
