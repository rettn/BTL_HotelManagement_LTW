@model HotelManagement.Models.CaiDatHeThong
@{
	ViewData["Title"] = "Cấu hình Chatbot AI";
	var configured = ViewBag.GeminiConfigured == true;
	var currentModel = string.IsNullOrWhiteSpace(Model.GeminiModel) ? "gemini-flash-latest" : Model.GeminiModel;
}

<div class="settings-container max-w-1000">
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
		<div class="d-flex align-items-center gap-3">
			<a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
				<i class="bi bi-arrow-left me-1"></i>Tổng quan cài đặt
			</a>
			<h3 class="mb-0 fw-bold fs-4">Cấu hình Chatbot AI</h3>
		</div>
	</div>

	<partial name="_CaiDatTabs" />

	@if (TempData["Success"] is string success)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-circle-fill me-2"></i>@success
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	}

	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card border-0 shadow-sm rounded-4">
				<div class="card-body p-4">
					<h6 class="fw-bold text-dark mb-4 pb-2 border-bottom">
						<i class="bi bi-stars text-success me-2"></i>Thông tin kết nối Gemini
					</h6>
					<form asp-action="Chatbot" method="post">
						@Html.AntiForgeryToken()
						<div class="mb-4">
							<label for="apiKey" class="form-label fw-bold">Gemini API key</label>
							<input id="apiKey" name="apiKey" type="password" class="form-control" autocomplete="new-password" placeholder="@(configured ? "Đã có API key — nhập key mới nếu muốn thay đổi" : "Nhập Gemini API key")" />
							<div class="form-text">API key được mã hóa trước khi lưu và không bao giờ hiển thị lại đầy đủ.</div>
						</div>
						<div class="mb-4">
							<label for="model" class="form-label fw-bold">Model Gemini</label>
							<div class="input-group">
								<input id="model" name="model" list="geminiModelOptions" class="form-control font-monospace" value="@currentModel" maxlength="100" placeholder="Chọn hoặc nhập tên model..." required />
								<button type="button" id="btnFetchModels" class="btn btn-outline-success">
									<i class="bi bi-arrow-clockwise me-1"></i>Tải danh sách từ Google
								</button>
							</div>
							<datalist id="geminiModelOptions">
								<option value="gemini-flash-latest">gemini-flash-latest (Khuyên dùng - Tự động bản Flash mới nhất)</option>
								<option value="gemini-pro-latest">gemini-pro-latest (Tự động bản Pro mới nhất)</option>
								<option value="gemini-2.5-flash">gemini-2.5-flash</option>
								<option value="gemini-2.5-pro">gemini-2.5-pro</option>
							</datalist>
							<div id="modelFetchStatus" class="form-text">
								Nên dùng <code>gemini-flash-latest</code> để tránh gián đoạn khi Google đổi tên phiên bản, hoặc nhấn <strong>Tải danh sách từ Google</strong> để cập nhật model mới.
							</div>
						</div>
						<div class="mb-4">
							<label for="timeoutSeconds" class="form-label fw-bold">Thời gian chờ API (giây)</label>
							<input id="timeoutSeconds" name="timeoutSeconds" type="number" min="5" max="120" class="form-control" value="@(Model.GeminiTimeoutSeconds <= 0 ? 30 : Model.GeminiTimeoutSeconds)" required />
						</div>
						<div class="d-flex flex-wrap justify-content-between gap-2 pt-3 border-top">
							@if (configured)
							{
								<button type="submit" name="clearApiKey" value="true" class="btn btn-outline-danger" formnovalidate onclick="return confirm('Xóa API key Gemini khỏi hệ thống?');">
									<i class="bi bi-trash me-1"></i>Xóa API key
								</button>
							}
							else
							{
								<span></span>
							}
							<button type="submit" class="btn btn-success px-4 fw-semibold">
								<i class="bi bi-save me-1"></i>Lưu cấu hình
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card border-0 shadow-sm rounded-4 bg-light">
				<div class="card-body p-4">
					<h6 class="fw-bold"><i class="bi bi-shield-lock text-primary me-2"></i>Trạng thái</h6>
					<p class="mb-2">API key: <strong class="text-@(configured ? "success" : "danger")">@(configured ? "Đã cấu hình" : "Chưa cấu hình")</strong></p>
					<p class="mb-3">Model đang dùng: <code class="text-dark fw-semibold">@currentModel</code></p>
					<p class="small text-muted mb-0">Chatbot khách hàng dùng dữ liệu công khai. Chatbot Admin/NhanVien dùng dữ liệu vận hành đã tổng hợp từ database.</p>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	document.getElementById('btnFetchModels')?.addEventListener('click', async function () {
		const btn = this;
		const statusEl = document.getElementById('modelFetchStatus');
		const dataList = document.getElementById('geminiModelOptions');
		const apiKey = document.getElementById('apiKey')?.value || '';

		btn.disabled = true;
		statusEl.className = 'form-text text-primary';
		statusEl.textContent = 'Đang kết nối Google AI để lấy danh sách model mới nhất...';

		try {
			const res = await fetch(`@Url.Action("LayDanhSachModelGemini", "CaiDat")?apiKey=${encodeURIComponent(apiKey)}`);
			const data = await res.json();

			if (!res.ok) {
				throw new Error(data.message || 'Không thể tải danh sách model.');
			}

			dataList.innerHTML = `
					<option value="gemini-flash-latest">gemini-flash-latest (Tự động bản Flash mới nhất)</option>
					<option value="gemini-pro-latest">gemini-pro-latest (Tự động bản Pro mới nhất)</option>
				`;

			data.forEach(m => {
				const opt = document.createElement('option');
				opt.value = m.id;
				opt.textContent = m.name;
				dataList.appendChild(opt);
			});

			statusEl.className = 'form-text text-success fw-semibold';
			statusEl.textContent = `Đã cập nhật ${data.length} model khả dụng. Xóa trắng ô nhập hoặc bấm mũi tên ở ô Model Gemini để chọn.`;
		} catch (err) {
			statusEl.className = 'form-text text-danger';
			statusEl.textContent = err.message;
		} finally {
			btn.disabled = false;
		}
	});
</script>