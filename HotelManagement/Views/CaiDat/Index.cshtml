@model HotelManagement.Models.PaymentSetting
@{
    ViewData["Title"] = "Cài đặt hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var banks = HotelManagement.Models.PaymentSetting.DanhSachNganHang;
}

<div class="settings-page">
    <div class="row g-4">
        
        <!-- CỘT TRÁI: CẤU HÌNH THANH TOÁN VIETQR & SEPAY -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary-subtle text-primary p-2 rounded-2">
                                <i class="bi bi-qr-code fs-5"></i>
                            </span>
                            <div>
                                <h5 class="mb-0 fw-bold text-dark">Cấu hình thanh toán VietQR & SePay</h5>
                                <small class="text-muted">Quản lý số tài khoản ngân hàng và API SePay để tự động xác nhận chuyển khoản</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="CaiDat" asp-action="LuuCaiDatThanhToan" method="post" id="formPaymentSettings">
                        @Html.AntiForgeryToken()

                        <!-- KHỐI 1: TÀI KHOẢN NGÂN HÀNG NHẬN TIỀN -->
                        <div class="settings-group mb-4 pb-3 border-bottom">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="bi bi-bank2 text-primary me-2"></i>1. Thông tin tài khoản ngân hàng (Tạo mã VietQR)
                            </h6>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="NganHangMa" class="form-label fw-semibold">Ngân hàng thụ hưởng <span class="text-danger">*</span></label>
                                    <select asp-for="NganHangMa" class="form-select" id="selectBank">
                                        @foreach (var b in banks)
                                        {
                                            <option value="@b.Ma" data-name="@b.Ten">@b.Ma - @b.Ten</option>
                                        }
                                    </select>
                                    <input type="hidden" asp-for="TenNganHang" id="inputTenNganHang" />
                                    <span asp-validation-for="NganHangMa" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="SoTaiKhoan" class="form-label fw-semibold">Số tài khoản ngân hàng <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-credit-card-2-front"></i></span>
                                        <input asp-for="SoTaiKhoan" class="form-control" id="inputSoTaiKhoan" placeholder="Ví dụ: 0379868686" required />
                                    </div>
                                    <span asp-validation-for="SoTaiKhoan" class="text-danger small"></span>
                                </div>

                                <div class="col-md-8">
                                    <label asp-for="TenChuTaiKhoan" class="form-label fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                                        <input asp-for="TenChuTaiKhoan" class="form-control text-uppercase" id="inputTenChuTK" placeholder="Ví dụ: NGUYEN THE TOAN" required />
                                    </div>
                                    <small class="text-muted">Khuyến nghị viết in hoa không dấu (trùng khớp thông tin thẻ ngân hàng)</small>
                                    <span asp-validation-for="TenChuTaiKhoan" class="text-danger small d-block"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="TiLeThanhToanPercent" class="form-label fw-semibold">Thu trước (%)</label>
                                    <div class="input-group">
                                        <input asp-for="TiLeThanhToanPercent" type="number" min="1" max="100" class="form-control" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <small class="text-muted">100% = Toàn bộ tiền phòng</small>
                                </div>
                            </div>
                        </div>

                        <!-- KHỐI 2: TÍCH HỢP SEPAY API -->
                        <div class="settings-group mb-4 pb-3 border-bottom">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="bi bi-cpu text-success me-2"></i>2. Tích hợp SePay API (Tự động xác nhận giao dịch mỗi 3s)
                            </h6>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="SePayApiKey" class="form-label fw-semibold">SePay API Token / Key</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                        <input asp-for="SePayApiKey" type="password" class="form-control font-monospace" id="inputApiKey" placeholder="Dán mã API Token từ SePay (ví dụ: SP_...)" />
                                        <button class="btn btn-outline-secondary" type="button" id="btnToggleApiKey" title="Ẩn/Hiện API Key">
                                            <i class="bi bi-eye" id="eyeIcon"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">
                                        Lấy API Token tại tài khoản SePay của bạn: 
                                        <a href="https://my.sepay.vn" target="_blank" rel="noopener noreferrer" class="text-decoration-underline">my.sepay.vn</a> 
                                        (Mục Tích hợp Web / API Key).
                                    </small>
                                </div>

                                <div class="col-md-8">
                                    <label asp-for="SePayApiUrl" class="form-label fw-semibold">SePay API URL (Mặc định)</label>
                                    <input asp-for="SePayApiUrl" class="form-control font-monospace text-muted" placeholder="https://my.sepay.vn/userapi/transactions/list" />
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NoiDungPrefix" class="form-label fw-semibold">Tiền tố mã thanh toán</label>
                                    <input asp-for="NoiDungPrefix" class="form-control text-uppercase font-monospace" id="inputPrefix" placeholder="DP" maxlength="10" />
                                    <small class="text-muted">Ví dụ "DP" &rarr; khách chuyển <strong>DP12</strong></small>
                                </div>

                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-info" id="btnTestSePay">
                                            <i class="bi bi-lightning-charge me-1"></i> Kiểm tra kết nối SePay
                                        </button>
                                        <span id="testSePayResult" class="small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- NÚT LƯU CẤU HÌNH -->
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                                <i class="bi bi-save me-1"></i> Lưu cấu hình thanh toán
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: XEM TRƯỚC MÃ QR VÀ CÀI ĐẶT KHÁC -->
        <div class="col-xl-4 col-lg-5">
            
            <!-- XEM TRƯỚC MÃ QR VIETQR -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-eye text-primary me-2"></i>Xem trước VietQR khách hàng</h6>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="qr-preview-box p-3 bg-light rounded-3 d-inline-block border">
                        <img id="qrPreviewImg" 
                             src="https://img.vietqr.io/image/@(Model.NganHangMa)-@(Model.SoTaiKhoan)-compact2.png?amount=500000&addInfo=@(Model.NoiDungPrefix)88&accountName=@Uri.EscapeDataString(Model.TenChuTaiKhoan ?? "")" 
                             alt="Mã QR VietQR xem trước" 
                             class="img-fluid rounded" 
                             style="max-width: 250px; height: auto;" />
                    </div>

                    <div class="mt-3 text-start small">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Ngân hàng:</span>
                            <strong id="previewBankName">@Model.NganHangMa</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Số tài khoản:</span>
                            <strong id="previewAccNo">@Model.SoTaiKhoan</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <strong id="previewAccName">@Model.TenChuTaiKhoan</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Mã ví dụ:</span>
                            <strong class="text-danger" id="previewMemo">@(Model.NoiDungPrefix)88</strong>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-3 w-100" id="btnRefreshPreview">
                        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới xem trước QR
                    </button>
                </div>
            </div>

            <!-- CÀI ĐẶT NHÂN SỰ & HỆ THỐNG -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-gear-wide-connected text-secondary me-2"></i>Cài đặt hệ thống khác</h6>
                </div>
                <div class="list-group list-group-flush rounded-bottom">
                    <a asp-controller="QuanTri" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-secondary-subtle text-secondary p-2 rounded-2">
                                <i class="bi bi-people fs-5"></i>
                            </span>
                            <div>
                                <strong class="d-block text-dark">Quản lý tài khoản nhân sự</strong>
                                <small class="text-muted">Phân quyền, tạo tài khoản và đặt mật khẩu</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle hiện / ẩn API Key
        const btnToggleApiKey = document.getElementById('btnToggleApiKey');
        const inputApiKey = document.getElementById('inputApiKey');
        const eyeIcon = document.getElementById('eyeIcon');

        if (btnToggleApiKey && inputApiKey && eyeIcon) {
            btnToggleApiKey.addEventListener('click', () => {
                const isPassword = inputApiKey.getAttribute('type') === 'password';
                inputApiKey.setAttribute('type', isPassword ? 'text' : 'password');
                eyeIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        }

        // Cập nhật tên ngân hàng ẩn khi đổi dropdown
        const selectBank = document.getElementById('selectBank');
        const inputTenNganHang = document.getElementById('inputTenNganHang');
        if (selectBank && inputTenNganHang) {
            selectBank.addEventListener('change', () => {
                const opt = selectBank.options[selectBank.selectedIndex];
                inputTenNganHang.value = opt.getAttribute('data-name') || opt.text;
                updateQrPreview();
            });
        }

        // Cập nhật Preview QR
        function updateQrPreview() {
            const bank = document.getElementById('selectBank')?.value || 'MB';
            const acc = document.getElementById('inputSoTaiKhoan')?.value || '';
            const name = document.getElementById('inputTenChuTK')?.value || '';
            const prefix = document.getElementById('inputPrefix')?.value || 'DP';

            document.getElementById('previewBankName').innerText = bank;
            document.getElementById('previewAccNo').innerText = acc || '---';
            document.getElementById('previewAccName').innerText = name || '---';
            document.getElementById('previewMemo').innerText = prefix + '88';

            const url = `https://img.vietqr.io/image/${encodeURIComponent(bank)}-${encodeURIComponent(acc)}-compact2.png?amount=500000&addInfo=${encodeURIComponent(prefix + '88')}&accountName=${encodeURIComponent(name)}`;
            const img = document.getElementById('qrPreviewImg');
            if (img) img.src = url;
        }

        document.getElementById('inputSoTaiKhoan')?.addEventListener('input', updateQrPreview);
        document.getElementById('inputTenChuTK')?.addEventListener('input', updateQrPreview);
        document.getElementById('inputPrefix')?.addEventListener('input', updateQrPreview);
        document.getElementById('btnRefreshPreview')?.addEventListener('click', updateQrPreview);

        // Kiểm tra kết nối SePay
        const btnTestSePay = document.getElementById('btnTestSePay');
        const testSePayResult = document.getElementById('testSePayResult');
        if (btnTestSePay && testSePayResult) {
            btnTestSePay.addEventListener('click', async () => {
                testSePayResult.innerHTML = '<span class="text-primary"><i class="bi bi-arrow-repeat spin"></i> Đang kiểm tra kết nối tới SePay...</span>';
                btnTestSePay.disabled = true;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const res = await fetch('/CaiDat/KiemTraKetNoiSePay', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    });
                    const data = await res.json();
                    testSePayResult.innerHTML = `<span class="fw-semibold text-dark"><i class="bi bi-info-circle me-1"></i>${data.message}</span>`;
                } catch (e) {
                    testSePayResult.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Lỗi kết nối</span>';
                } finally {
                    btnTestSePay.disabled = false;
                }
            });
        }
    </script>
}