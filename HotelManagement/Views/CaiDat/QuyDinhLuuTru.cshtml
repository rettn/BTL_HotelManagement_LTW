@model HotelManagement.Models.CaiDatHeThong
@{
    ViewData["Title"] = "Quy định lưu trú";
}

<div class="container-fluid px-0 max-w-800">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i> Trở về</a>
        <h3 class="mb-0">Quy định lưu trú</h3>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="QuyDinhLuuTru" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giờ nhận phòng mặc định</label>
                        <input type="time" class="form-control" asp-for="GioNhanPhong">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Giờ trả phòng mặc định</label>
                        <input type="time" class="form-control" asp-for="GioTraPhong">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Thời gian trả muộn tối đa (tiếng)</label>
                        <input type="number" class="form-control" asp-for="ThoiGianTraMuon">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tiền cọc mặc định (%)</label>
                        <input type="number" class="form-control" asp-for="TienCocMacDinh">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Chính sách hủy phòng</label>
                    <textarea class="form-control" asp-for="ChinhSachHuy" rows="4"></textarea>
                </div>
                <div class="text-end mt-4"><button type="submit" class="btn btn-warning px-4"><i class="bi bi-save"></i> Lưu thay đổi</button></div>
            </form>
        </div>
    </div>
</div>