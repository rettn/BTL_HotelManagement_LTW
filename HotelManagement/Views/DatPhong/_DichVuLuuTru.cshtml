@model HotelManagement.Models.LuuTru
@{
    var daDung = Model.ChiTietDichVus.OrderByDescending(d => d.ThoiGianSuDung).ToList();
    var tongTien = daDung.Sum(d => d.SoLuong * d.DonGia);
    var danhSachDichVu = ViewBag.DanhSachDichVu as List<HotelManagement.Models.DichVu> ?? new();
    var soPhong = Model.ChiTietDatPhong?.Phong?.SoPhong;
    var nhomHangs = danhSachDichVu.Select(d => d.NhomHang).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).ToList();
}
<div class="dv-header"><div><h2>Thêm sản phẩm, dịch vụ</h2><div class="dv-subtitle">@Model.ChiTietDatPhong?.DatPhong?.KhachHang?.HoTen · Phòng @soPhong</div></div><button type="button" class="dv-close" onclick="dongDichVu()" aria-label="Đóng"><i class="bi bi-x-lg"></i></button></div>
<div class="dv-body">
    @if (daDung.Count > 0) {
        <h3 class="dv-title">Đã ghi nhận · @tongTien.ToString("N0") đ</h3><div class="dv-table-wrap"><table class="dv-table"><thead><tr><th>Mặt hàng</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th><th>Thời gian</th><th></th></tr></thead><tbody>
        @foreach (var d in daDung) { <tr id="dv-row-@d.MaChiTietDichVu"><td>@(d.DichVu?.TenDichVu ?? "Đã xóa")</td><td>@d.SoLuong</td><td>@d.DonGia.ToString("N0") đ</td><td>@((d.SoLuong*d.DonGia).ToString("N0")) đ</td><td>@d.ThoiGianSuDung.ToString("HH:mm dd/MM")</td><td><button class="dv-icon-btn" onclick="batDauSuaDichVu(@d.MaChiTietDichVu)" title="Sửa"><i class="bi bi-pencil"></i></button> <button class="dv-icon-btn danger" onclick="xoaDichVu(@d.MaChiTietDichVu, '@(d.DichVu?.TenDichVu?.Replace("'", "\\'") ?? "mặt hàng")')" title="Xóa"><i class="bi bi-trash"></i></button></td></tr>
        <tr id="dv-edit-@d.MaChiTietDichVu" style="display:none"><td colspan="6"><div class="dv-edit"><select id="dvSuaChon-@d.MaChiTietDichVu">@foreach(var dv in danhSachDichVu){<option value="@dv.Id" selected="@(dv.Id==d.MaDichVu)">@dv.TenDichVu · @dv.Gia.ToString("N0") đ</option>}</select><input id="dvSuaSoLuong-@d.MaChiTietDichVu" type="number" min="1" max="100" value="@d.SoLuong"/><button class="dv-btn" onclick="luuSuaDichVu(@d.MaChiTietDichVu)">Lưu</button><button class="dv-btn-light" onclick="huySuaDichVu(@d.MaChiTietDichVu)">Hủy</button></div></td></tr> }
        </tbody></table></div>
    }
    <div class="dv-picker"><section class="dv-catalog"><div class="dv-search"><i class="bi bi-search"></i><input id="dvSearch" placeholder="Tìm theo tên, mã hàng hóa (F3)" oninput="locMatHang()" /></div><div class="dv-filters"><button class="active" onclick="chonNhomHang(this,'')">Tất cả</button>@foreach(var group in nhomHangs){<button onclick="chonNhomHang(this,'@group')">@group</button>}</div>
        <div class="dv-products">@foreach(var dv in danhSachDichVu){<button type="button" class="dv-product" data-id="@dv.Id" data-name="@dv.TenDichVu" data-code="@dv.MaHang" data-group="@dv.NhomHang" data-price="@dv.Gia" data-unit="@dv.DonViTinh" data-stock="@dv.TonKho" data-type="@dv.LoaiHang" data-image="@dv.AnhUrl" onclick="themVaoGio(this)"><span class="dv-product-image">@if(!string.IsNullOrEmpty(dv.AnhUrl)){<img src="@dv.AnhUrl" alt=""/>}else{<i class="bi bi-image"></i>}</span><span class="dv-product-info"><b>@dv.TenDichVu</b><small>@dv.Gia.ToString("N0") đ / @dv.DonViTinh</small></span></button>}</div>
    </section><section class="dv-cart"><div class="dv-cart-title"><span class="dv-room-tag">@soPhong</span><b>Đơn dịch vụ</b><span id="dvCartCount">0 mặt hàng</span></div><div id="dvCartRows" class="dv-cart-rows"><div class="dv-cart-empty">Chọn dịch vụ hoặc sản phẩm ở danh sách</div></div><div class="dv-cart-total"><span>Tổng cộng</span><strong id="dvCartTotal">0 đ</strong></div></section></div>
</div>
<div class="dv-footer"><button type="button" class="dv-btn-light" onclick="dongDichVu()">Bỏ qua</button><button type="button" class="dv-btn" onclick="themDichVu(@Model.MaLuuTru)"><i class="bi bi-check-lg"></i> Lưu</button></div>
<style>
.dv-header{display:flex;justify-content:space-between;align-items:center;padding:17px 24px;border-bottom:1px solid #e5eaf0}.dv-header h2{font-size:19px;font-weight:700;margin:0;color:#1f2937}.dv-subtitle{font-size:13px;color:#718096;margin-top:3px}.dv-close,.dv-icon-btn{border:1px solid #dce3ed;background:#fff;border-radius:8px;padding:7px 10px;color:#607087;cursor:pointer}.dv-body{padding:18px 24px}.dv-title{font-size:14px;color:#198754;font-weight:700;margin:0 0 10px}.dv-table-wrap{max-height:180px;overflow:auto;margin-bottom:18px}.dv-table{width:100%;border-collapse:collapse;font-size:13px}.dv-table th,.dv-table td{padding:8px;border-bottom:1px solid #edf0f5;text-align:left}.dv-table th{background:#f7f9fc;color:#64748b}.dv-icon-btn.danger{color:#c03939}.dv-edit{display:flex;gap:8px}.dv-edit select{flex:1;min-width:120px}.dv-edit select,.dv-edit input{padding:8px;border:1px solid #dce3ed;border-radius:7px}.dv-edit input{width:76px}.dv-picker{display:grid;grid-template-columns: minmax(300px, .85fr) minmax(350px,1.15fr);min-height:390px;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden}.dv-catalog{padding:14px;border-right:1px solid #e2e8f0}.dv-search{display:flex;align-items:center;gap:9px;border:1px solid #dce3ed;border-radius:8px;padding:0 11px;height:39px;color:#8794a6}.dv-search input{border:0;outline:0;width:100%;font-size:13px}.dv-filters{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 12px}.dv-filters button{border:1px solid #dce3ed;background:#fff;color:#64748b;border-radius:18px;padding:5px 11px;font-size:12px}.dv-filters button.active{background:#198754;color:#fff;border-color:#198754}.dv-products{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-height:295px;overflow:auto}.dv-product{display:flex;align-items:center;gap:8px;text-align:left;padding:7px;border:1px solid transparent;background:#fff;border-radius:9px;cursor:pointer;min-width:0}.dv-product:hover{background:#f5faf7;border-color:#cce9d8}.dv-product-image{width:48px;height:48px;flex:none;overflow:hidden;border-radius:9px;background:#eef2f6;display:grid;place-items:center;color:#95a2b4}.dv-product-image img{width:100%;height:100%;object-fit:cover}.dv-product-info{display:flex;flex-direction:column;min-width:0}.dv-product-info b{font-size:12px;line-height:1.25;color:#263449}.dv-product-info small{font-size:11px;color:#758399;margin-top:3px}.dv-cart{padding:14px;display:flex;flex-direction:column}.dv-cart-title{display:flex;align-items:center;gap:9px;font-size:14px;border-bottom:1px solid #eef1f4;padding-bottom:11px}.dv-cart-title>span:last-child{margin-left:auto;color:#8a96a8;font-size:12px}.dv-room-tag{padding:4px 8px;border-radius:6px;background:#e3f3e9;color:#198754;font-size:12px;font-weight:700}.dv-cart-rows{flex:1;overflow:auto;max-height:310px}.dv-cart-empty{display:grid;place-items:center;height:180px;color:#9aa5b1;font-size:13px;text-align:center}.dv-cart-row{display:grid;grid-template-columns:1fr 64px 100px 30px;align-items:center;gap:8px;padding:12px 3px;border-bottom:1px solid #edf0f5}.dv-cart-row b{font-size:13px}.dv-cart-row small{display:block;color:#8a96a8;font-size:11px}.dv-cart-row input{width:58px;border:0;border-bottom:1px solid #dce3ed;text-align:center;padding:5px}.dv-cart-row strong{text-align:right;font-size:13px}.dv-cart-row button{border:0;background:transparent;color:#9aa5b1}.dv-cart-total{display:flex;justify-content:space-between;border-top:1px solid #e7ebf0;padding-top:12px;margin-top:10px;font-weight:700}.dv-cart-total strong{color:#198754}.dv-footer{display:flex;justify-content:flex-end;gap:9px;padding:14px 24px;border-top:1px solid #e5e7eb}.dv-btn,.dv-btn-light{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border:0;border-radius:8px;font-weight:600;cursor:pointer}.dv-btn{background:#198754;color:#fff}.dv-btn-light{background:#eef1f6;color:#526174}@@media(max-width:760px){.dv-picker{grid-template-columns:1fr}.dv-catalog{border-right:0;border-bottom:1px solid #e2e8f0}.dv-products{max-height:190px}.dv-body{padding:14px}}
</style>
<script>
window.dvCart=window.dvCart||{}; window.dvGroup='';
function fmtDv(n){return Number(n||0).toLocaleString('vi-VN')+' đ'}
function chonNhomHang(btn,g){window.dvGroup=g;document.querySelectorAll('.dv-filters button').forEach(x=>x.classList.toggle('active',x===btn));locMatHang()}
function locMatHang(){const q=(document.getElementById('dvSearch')?.value||'').toLocaleLowerCase();document.querySelectorAll('.dv-product').forEach(x=>x.hidden=!(x.dataset.name.toLocaleLowerCase().includes(q)||x.dataset.code.toLocaleLowerCase().includes(q))||!!window.dvGroup&&x.dataset.group!==window.dvGroup)}
function themVaoGio(btn){const id=btn.dataset.id;const row=window.dvCart[id]||{id,name:btn.dataset.name,price:Number(btn.dataset.price),unit:btn.dataset.unit,stock:Number(btn.dataset.stock),type:btn.dataset.type,qty:0};row.qty++;window.dvCart[id]=row;veGioDv()}
function xoaKhoiGio(id){delete window.dvCart[id];veGioDv()}
function doiSoLuongDv(id,value){const row=window.dvCart[id];if(!row)return;row.qty=Math.max(1,Math.min(100,Number(value)||1));veGioDv()}
function veGioDv(){const box=document.getElementById('dvCartRows');if(!box)return;const rows=Object.values(window.dvCart);box.innerHTML=rows.length?rows.map(x=>`<div class="dv-cart-row" data-id="${x.id}"><div><b>${x.name}</b><small>${fmtDv(x.price)} / ${x.unit}</small></div><input type="number" min="1" max="100" value="${x.qty}" onchange="doiSoLuongDv('${x.id}',this.value)"><strong>${fmtDv(x.price*x.qty)}</strong><button onclick="xoaKhoiGio('${x.id}')">×</button></div>`).join(''):'<div class="dv-cart-empty">Chọn dịch vụ hoặc sản phẩm ở danh sách</div>';document.getElementById('dvCartCount').textContent=rows.length+' mặt hàng';document.getElementById('dvCartTotal').textContent=fmtDv(rows.reduce((s,x)=>s+x.price*x.qty,0))}
</script>
