@model HotelManagement.Models.LuuTru
@{
    var daDung = Model.ChiTietDichVus
        .OrderByDescending(d => d.ThoiGianSuDung)
        .ToList();
    var tongTien = daDung.Sum(d => d.SoLuong * d.DonGia);

    var danhSachDichVu = ViewBag.DanhSachDichVu as List<HotelManagement.Models.DichVu>
        ?? new List<HotelManagement.Models.DichVu>();

    var soPhong = Model.ChiTietDatPhong?.Phong?.SoPhong;
}

<div class="dv-header">
    <h2>Dịch vụ phòng @soPhong</h2>
    <button type="button" class="dv-close" onclick="dongDichVu()" aria-label="Đóng">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<div class="dv-body">
    <h3 class="dv-title">Dịch vụ đã sử dụng</h3>

    @if (daDung.Count == 0)
    {
        <p class="dv-empty">Chưa có dịch vụ nào được thêm.</p>
    }
    else
    {
        <div class="dv-table-wrap">
            <table class="dv-table">
                <thead>
                    <tr>
                        <th>Dịch vụ</th>
                        <th>SL</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>Thời gian</th>
                        <th class="dv-col-action">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in daDung)
                    {
                        <tr id="dv-row-@d.MaChiTietDichVu">
                            <td>@(d.DichVu?.TenDichVu ?? "Dịch vụ đã xóa")</td>
                            <td>@d.SoLuong</td>
                            <td>@d.DonGia.ToString("N0") đ</td>
                            <td>@((d.SoLuong * d.DonGia).ToString("N0")) đ</td>
                            <td>@d.ThoiGianSuDung.ToString("HH:mm dd/MM")</td>
                            <td class="dv-col-action">
                                <button type="button" class="dv-icon-btn dv-icon-edit"
                                        title="Sửa"
                                        onclick="batDauSuaDichVu(@d.MaChiTietDichVu)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button type="button" class="dv-icon-btn dv-icon-delete"
                                        title="Xóa"
                                        onclick="xoaDichVu(@d.MaChiTietDichVu, '@(d.DichVu?.TenDichVu?.Replace("'", "\\'") ?? "dịch vụ")')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <tr id="dv-edit-@d.MaChiTietDichVu" class="dv-edit-row" style="display:none;">
                            <td colspan="6">
                                <div class="dv-edit">
                                    <select id="dvSuaChon-@d.MaChiTietDichVu">
                                        @if (!danhSachDichVu.Any(x => x.Id == d.MaDichVu))
                                        {
                                            <option value="@d.MaDichVu" selected>
                                                @(d.DichVu?.TenDichVu ?? "Dịch vụ đã xóa") - @d.DonGia.ToString("N0") đ
                                            </option>
                                        }
                                        @foreach (var dv in danhSachDichVu)
                                        {
                                            <option value="@dv.Id" selected="@(dv.Id == d.MaDichVu)">
                                                @dv.TenDichVu - @dv.Gia.ToString("N0") đ
                                            </option>
                                        }
                                    </select>
                                    <input id="dvSuaSoLuong-@d.MaChiTietDichVu" type="number"
                                           min="1" max="100" value="@d.SoLuong" />
                                    <button type="button" class="dv-btn"
                                            onclick="luuSuaDichVu(@d.MaChiTietDichVu)">
                                        <i class="bi bi-check-lg"></i> Lưu
                                    </button>
                                    <button type="button" class="dv-btn-light"
                                            onclick="huySuaDichVu(@d.MaChiTietDichVu)">
                                        Hủy
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3">Tổng cộng</td>
                        <td colspan="3">@tongTien.ToString("N0") đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <h3 class="dv-title">Thêm dịch vụ</h3>

    @if (danhSachDichVu.Count == 0)
    {
        <p class="dv-empty">Chưa có dịch vụ nào đang hoạt động. Hãy thêm ở mục Dịch vụ.</p>
    }
    else
    {
        <div class="dv-add">
            <select id="dvChon">
                <option value="">-- Chọn dịch vụ --</option>
                @foreach (var dv in danhSachDichVu)
                {
                    <option value="@dv.Id">@dv.TenDichVu - @dv.Gia.ToString("N0") đ</option>
                }
            </select>
            <input id="dvSoLuong" type="number" min="1" max="100" value="1" />
            <button type="button" class="dv-btn" onclick="themDichVu(@Model.MaLuuTru)">
                <i class="bi bi-plus-lg"></i> Thêm
            </button>
        </div>
    }
</div>

<div class="dv-footer">
    <button type="button" class="dv-btn-light" onclick="dongDichVu()">Đóng</button>
</div>

<style>
    .dv-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
    }

        .dv-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: #1f2937;
        }

    .dv-close {
        border: 0;
        background: #f1f4f8;
        border-radius: 8px;
        padding: 8px 10px;
        cursor: pointer;
    }

    .dv-body {
        padding: 20px 24px;
    }

    .dv-title {
        font-size: 15px;
        font-weight: 700;
        color: #166534;
        margin: 18px 0 10px;
    }

        .dv-title:first-child {
            margin-top: 0;
        }

    .dv-empty {
        color: #7b8798;
        font-size: 14px;
        margin: 0 0 8px;
    }

    .dv-table-wrap {
        overflow-x: auto;
    }

    .dv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .dv-table th {
            background: #f7f9fc;
            color: #65748b;
            font-size: 12px;
            text-align: left;
            padding: 10px;
        }

        .dv-table td {
            padding: 10px;
            border-bottom: 1px solid #edf0f5;
        }

        .dv-table tfoot td {
            font-weight: 700;
            color: #198754;
            border-bottom: 0;
        }

    .dv-col-action {
        width: 92px;
        text-align: center !important;
        white-space: nowrap;
    }

    /* Nút sửa / xóa */
    .dv-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
    }

    .dv-icon-edit {
        color: #2563b7;
    }

        .dv-icon-edit:hover {
            background: #e9f2ff;
            border-color: #bcd4f7;
        }

    .dv-icon-delete {
        color: #c03939;
    }

        .dv-icon-delete:hover {
            background: #ffe8e8;
            border-color: #f3c0c0;
        }

    /* Dòng sửa */
    .dv-edit-row td {
        background: #fbfefc;
        border-bottom: 1px solid #dcefe3;
    }

    .dv-edit {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

        .dv-edit select {
            flex: 1;
            min-width: 200px;
            padding: 9px;
            border: 1px solid #cfe9d9;
            border-radius: 8px;
        }

        .dv-edit input {
            width: 80px;
            padding: 9px;
            border: 1px solid #cfe9d9;
            border-radius: 8px;
        }

    .dv-add {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

        .dv-add select {
            flex: 1;
            min-width: 200px;
            padding: 10px;
            border: 1px solid #dce3ed;
            border-radius: 8px;
        }

        .dv-add input {
            width: 80px;
            padding: 10px;
            border: 1px solid #dce3ed;
            border-radius: 8px;
        }

    .dv-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        border: 0;
        border-radius: 8px;
        background: #198754;
        color: #fff;
        font-weight: 600;
        cursor: pointer;
    }

        .dv-btn:hover {
            background: #157347;
        }

    .dv-footer {
        display: flex;
        justify-content: flex-end;
        padding: 14px 24px;
        border-top: 1px solid #e5e7eb;
    }

    .dv-btn-light {
        padding: 10px 22px;
        border: 0;
        border-radius: 8px;
        background: #eef1f6;
        color: #263449;
        font-weight: 600;
        cursor: pointer;
    }
</style>
