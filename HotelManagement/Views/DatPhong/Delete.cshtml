@model HotelManagement.Models.DatPhong

@{
    ViewData["Title"] = "Xóa phiếu đặt phòng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/room-map.css" asp-append-version="true" />
}

<div class="room-map-page">
    <div class="room-toolbar">
        <div>
            <h2 class="text-danger">Xóa phiếu đặt phòng</h2>
            <p>Xác nhận xóa dữ liệu phiếu đặt phòng khỏi hệ thống</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4" style="border-radius: 12px; background-color: #fff;">

        <div class="alert alert-danger mb-4" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa phiếu đặt phòng <strong>#@Model.MaDatPhong</strong> không? Hành động này không thể hoàn tác!
        </div>

        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold text-dark mb-1">Thông tin phiếu đặt phòng</h5>
            <p class="text-muted small mb-0">Kiểm tra kỹ thông tin trước khi xác nhận xóa.</p>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <span class="text-muted small d-block mb-1">Mã phiếu đặt</span>
                <strong class="text-dark fs-6">#@Model.MaDatPhong</strong>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-muted small d-block mb-1">Khách hàng</span>
                <strong class="text-dark">@(Model.KhachHang?.HoTen ?? "Khách lẻ / Chưa rõ")</strong>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-muted small d-block mb-1">Ngày nhận dự kiến</span>
                <span class="text-dark">@Model.NgayNhanDuKien.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-muted small d-block mb-1">Trạng thái</span>
                <span class="badge bg-secondary px-3 py-2 rounded-pill fw-normal">@Model.TrangThai</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 pt-3 border-top">
            <input type="hidden" asp-for="MaDatPhong" />

            <a asp-action="Index" class="btn btn-light px-4 py-2 border fw-normal text-secondary" style="border-radius: 8px; font-size: 0.9rem;">
                Hủy bỏ
            </a>
            <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold" style="border-radius: 8px; font-size: 0.9rem;">
                <i class="bi bi-trash"></i> Xác nhận xóa
            </button>
        </form>
    </div>
</div>