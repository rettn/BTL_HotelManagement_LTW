@model HotelManagement.ViewModels.DatPhongViewModel

@{
    ViewData["Title"] = "Danh sách đặt phòng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/room-map.css" asp-append-version="true" />
}

<div class="room-map-page py-4">
    <div class="card border-0 shadow-sm mx-auto" style="border-radius: 12px; overflow: hidden; background-color: #fff; max-width: 1100px;">
        <div class="card-body p-5">

            <div class="mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-1">Chỉnh sửa phiếu đặt phòng</h4>
                <p class="text-muted mb-0">Cập nhật thông tin phiếu đặt phòng.</p>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaDatPhong" />
                <input type="hidden" asp-for="NgayDat" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <!-- Hàng 1: Mã đặt phòng & Khách hàng -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Mã đặt phòng</label>
                        <input type="text" class="form-control py-2 bg-light" value="#@Model.MaDatPhong" disabled style="border-radius: 8px;" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaKH" class="form-label fw-semibold text-secondary">Khách hàng *</label>
                        <select asp-for="MaKH" class="form-select py-2" style="border-radius: 8px;">
                            @if (Model.KhachHangs != null)
                            {
                                foreach (var kh in Model.KhachHangs)
                                {
                                    <option value="@kh.MaKH">@kh.HoTen - SĐT: @kh.SoDienThoai</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="MaKH" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Hàng 2: Ngày nhận & Ngày trả -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="NgayNhan" class="form-label fw-semibold text-secondary">Ngày nhận dự kiến *</label>
                        <input asp-for="NgayNhan" type="date" class="form-control py-2" style="border-radius: 8px;" required />
                        <span asp-validation-for="NgayNhan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgayTra" class="form-label fw-semibold text-secondary">Ngày trả dự kiến *</label>
                        <input asp-for="NgayTra" type="date" class="form-control py-2" style="border-radius: 8px;" required />
                        <span asp-validation-for="NgayTra" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Hàng 3: Tiền cọc & Trạng thái -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="TienCoc" class="form-label fw-semibold text-secondary">Tiền cọc (VNĐ)</label>
                        <input asp-for="TienCoc" type="number" class="form-control py-2" style="border-radius: 8px;" />
                        <span asp-validation-for="TienCoc" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TrangThai" class="form-label fw-semibold text-secondary">Trạng thái</label>
                        <select asp-for="TrangThai" class="form-select py-2" style="border-radius: 8px;">
                            <option value="ChoXacNhan">Chờ xác nhận</option>
                            <option value="DaXacNhan">Đã xác nhận</option>
                            <option value="DaHuy">Đã hủy</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label fw-semibold text-secondary">Ghi chú</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="3" data-rich-text-editor="true" style="border-radius: 8px;" placeholder="Thông tin bổ sung (nếu có)..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>
                </div>

                
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 border fw-normal text-secondary" style="border-radius: 8px;">
                        Hủy
                    </a>
                    <button type="submit" class="btn text-white px-4 py-2 custom-save-btn shadow-sm" style="border-radius: 8px;">
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<style>
    .custom-save-btn {
        background-color: #198754 !important;
        border: none !important;
        transition: background-color 0.2s ease-in-out;
    }

        .custom-save-btn:hover {
            background-color: #157347 !important;
            color: #fff !important;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RichTextEditor" />
}
