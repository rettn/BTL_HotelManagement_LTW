@model HotelManagement.Models.DatPhong

@{
    ViewData["Title"] = "Chi tiết phiếu đặt phòng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/room-map.css" asp-append-version="true" />
}

<div class="room-map-page">
    <div class="room-toolbar">
        <div>
            <h2>Chi tiết phiếu đặt phòng</h2>
            <p>Thông tin chi tiết của phiếu đặt phòng #@Model.MaDatPhong</p>
        </div>
        <div class="room-toolbar-actions">
            <a asp-action="Index" class="btn btn-light px-3 py-2 border fw-normal text-secondary d-inline-flex align-items-center justify-content-center" style="border-radius: 8px; font-size: 0.9rem;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4" style="border-radius: 12px; background-color: #fff;">
        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold text-dark mb-1">Thông tin chung</h5>
            <p class="text-muted small mb-0">Mã định danh và trạng thái phiếu đặt phòng.</p>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Mã phiếu đặt</span>
                <strong class="text-dark fs-6">#@Model.MaDatPhong</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Ngày tạo phiếu</span>
                <span class="text-dark">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Trạng thái</span>
                <div>
                    @if (Model.TrangThai == "ChoXacNhan")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-normal">Chờ xác nhận</span>
                    }
                    else if (Model.TrangThai == "DaXacNhan")
                    {
                        <span class="badge bg-success px-3 py-2 rounded-pill fw-normal">Đã xác nhận</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2 rounded-pill fw-normal">Đã hủy</span>
                    }
                </div>
            </div>
        </div>

        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold text-dark mb-1">Thông tin khách hàng & phòng</h5>
            <p class="text-muted small mb-0">Khách hàng thực hiện đặt và thông tin phòng lưu trú.</p>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <span class="text-muted small d-block mb-1">Họ tên khách hàng</span>
                <strong class="text-dark">@(Model.KhachHang?.HoTen ?? "Khách lẻ / Chưa rõ")</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block mb-1">Số điện thoại</span>
                <span class="text-dark">@(Model.KhachHang?.SoDienThoai ?? "Chưa cập nhật")</span>
            </div>
        </div>

        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold text-dark mb-1">Thời gian lưu trú & Thanh toán</h5>
            <p class="text-muted small mb-0">Lịch trình dự kiến và chi phí đặt cọc.</p>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Ngày nhận dự kiến</span>
                <span class="text-dark">@Model.NgayNhanDuKien.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Ngày trả dự kiến</span>
                <span class="text-dark">@Model.NgayTraDuKien.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="col-md-4">
                <span class="text-muted small d-block mb-1">Tiền cọc</span>
                <strong class="text-success fs-6">@Model.TienCoc.ToString("N0") đ</strong>
            </div>
        </div>

        <div class="mb-4">
            <span class="text-muted small d-block mb-1">Ghi chú</span>
            <div class="p-3 bg-light rounded-3 text-secondary">
                @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú bổ sung." : Model.GhiChu)
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-light px-3 py-2 border fw-normal text-secondary d-inline-flex align-items-center justify-content-center" style="border-radius: 8px; font-size: 0.9rem;">
                Quay lại
            </a>
        </div>
    </div>
</div>