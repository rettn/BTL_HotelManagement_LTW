 @model IEnumerable<HotelManagement.Models.DatPhong>

@{
    ViewData["Title"] = "Danh sách đặt phòng";

    string TenTrangThai(string? trangThai) => trangThai switch
    {
        "DaHuy" => "Đã hủy",
        "DaThanhToan" => "Đã thanh toán",
        "DaHoanThanh" => "Đã hoàn thành",
        _ => trangThai ?? "Chưa xác định"
    };

    string MauTrangThai(string? trangThai) => trangThai switch
    {
        "DaHuy" => "badge-cancelled",
        "DaThanhToan" => "badge-paid",
        "DaHoanThanh" => "badge-completed",
        _ => "badge-pending"
    };
}

<style>
    .history-page {
        color: #263449;
    }

    .history-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .history-toolbar h2 {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .history-toolbar p {
        color: #748198;
        margin: 0;
    }

    .history-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .history-search {
        width: 100%;
        max-width: 460px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        outline: none;
    }

    .history-search:focus {
        border-color: #3997f5;
    }

    .history-table-wrapper {
        overflow-x: auto;
        margin-top: 20px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
    }

    .history-table th {
        background: #f7f9fc;
        color: #65748b;
        font-weight: 600;
        font-size: 13px;
        text-align: left;
        padding: 14px 12px;
        white-space: nowrap;
    }

    .history-table td {
        padding: 15px 12px;
        border-bottom: 1px solid #edf0f5;
        vertical-align: middle;
    }

    .history-table tbody tr:hover {
        background: #fafcff;
    }

    .history-code {
        font-weight: 700;
        color: #287fd1;
    }

    .history-customer {
        font-weight: 600;
    }

    .history-muted {
        color: #77849a;
        font-size: 13px;
        margin-top: 4px;
    }

    .history-rooms {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        max-width: 180px;
    }

    .history-room {
        display: inline-block;
        background: #edf5ff;
        color: #2874bd;
        border-radius: 5px;
        padding: 4px 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .history-status {
        display: inline-block;
        border-radius: 6px;
        padding: 6px 9px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-cancelled {
        background: #ffe8e8;
        color: #c03939;
    }

    .badge-paid {
        background: #e5f1ff;
        color: #2168b3;
    }

    .badge-completed {
        background: #e4f8ed;
        color: #16804a;
    }

    .history-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 9px;
        border: 1px solid #dce3ed;
        border-radius: 6px;
        background: white;
        color: #41516a;
        text-decoration: none;
        font-size: 12px;
        cursor: pointer;
    }

    .history-action:hover {
        background: #f1f6fc;
    }

    .history-empty {
        text-align: center;
        padding: 48px 16px;
        color: #7b8798;
    }

    .history-empty i {
        font-size: 38px;
        display: block;
        margin-bottom: 12px;
    }

    .history-empty h3 {
        color: #344258;
        font-size: 19px;
    }

    .history-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        color: #748198;
        font-size: 13px;
        margin-top: 16px;
    }

    .history-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        padding: 10px 15px;
        background: white;
        color: #41516a;
        text-decoration: none;
        font-weight: 600;
    }

    .history-back:hover {
        background: #f1f6fc;
        color: #263449;
    }
</style>

<div class="history-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="history-toolbar">
        <div>
            <h2>Lịch sử đặt phòng</h2>
            <p>Tra cứu các lượt đặt phòng đã hủy hoặc đã hoàn tất.</p>
        </div>

        <a asp-controller="DatPhong"
           asp-action="Index"
           class="history-back">
            <i class="bi bi-arrow-left"></i>
            Quay lại danh sách đặt phòng
        </a>
    </div>

    <div class="history-panel">
        <input id="historySearch"
               class="history-search"
               type="search"
               placeholder="Tìm mã đặt phòng, tên khách hàng, số phòng..." />

        <div class="history-table-wrapper">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Mã đặt phòng</th>
                        <th>Khách hàng</th>
                        <th>Phòng đã đặt</th>
                        <th>Ngày đặt</th>
                        <th>Ngày nhận</th>
                        <th>Ngày trả</th>
                        <th>Tiền cọc</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody id="historyTableBody">
                    @foreach (var datPhong in Model)
                    {
                        var cacPhong = datPhong.ChiTietDatPhongs?
                            .Where(ct => ct.Phong != null)
                            .Select(ct => ct.Phong!.SoPhong)
                            .ToList() ?? new List<string>();

                        var tenKhach = datPhong.KhachHang?.HoTen
                            ?? "Chưa có thông tin";

                        var tuKhoa =
                            $"{datPhong.MaDatPhong} {tenKhach} {string.Join(" ", cacPhong)}";

                        <tr data-search="@tuKhoa.ToLowerInvariant()">
                            <td>
                                <span class="history-code">
                                    @datPhong.MaDatPhong
                                </span>
                            </td>

                            <td>
                                <div class="history-customer">
                                    @tenKhach
                                </div>
                                <div class="history-muted">
                                    @(datPhong.KhachHang?.SoDienThoai
                                        ?? "Chưa có số điện thoại")
                                </div>
                            </td>

                            <td>
                                <div class="history-rooms">
                                    @if (cacPhong.Count > 0)
                                    {
                                        foreach (var soPhong in cacPhong)
                                        {
                                            <span class="history-room">
                                                @soPhong
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="history-muted">
                                            Chưa gán phòng
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                @datPhong.NgayDat.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @datPhong.NgayNhanDuKien.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @datPhong.NgayTraDuKien.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @datPhong.TienCoc.ToString("N0") đ
                            </td>

                            <td>
                                <span class="history-status @MauTrangThai(datPhong.TrangThai)">
                                    @TenTrangThai(datPhong.TrangThai)
                                </span>
                            </td>

                            <td>
                                <a asp-controller="DatPhong"
                                   asp-action="Details"
                                   asp-route-id="@datPhong.MaDatPhong"
                                   class="history-action"
                                   title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="historyEmpty" class="history-empty"
                 style="display:@(Model.Any() ? "none" : "block")">
                <i class="bi bi-clock-history"></i>
                <h3>Chưa có lịch sử đặt phòng</h3>
                <p>Các lượt đặt phòng đã hủy hoặc hoàn tất sẽ xuất hiện tại đây.</p>
            </div>

            <div id="historyNoResult"
                 class="history-empty"
                 style="display:none">
                <i class="bi bi-search"></i>
                <h3>Không tìm thấy kết quả</h3>
                <p>Thử tìm bằng mã đặt phòng, tên khách hàng hoặc số phòng khác.</p>
            </div>

            <div class="history-footer">
                <span>
                    Tổng số lượt trong lịch sử:
                    <strong>@Model.Count()</strong>
                </span>
                <span>Dữ liệu lịch sử đặt phòng của khách sạn</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById("historySearch");
            const rows = [
                ...document.querySelectorAll("#historyTableBody tr")
            ];
            const empty = document.getElementById("historyEmpty");
            const noResult = document.getElementById("historyNoResult");

            search?.addEventListener("input", () => {
                const keyword = search.value.trim().toLowerCase();
                let visible = 0;

                rows.forEach(row => {
                    const match =
                        (row.dataset.search || "").includes(keyword);

                    row.style.display = match ? "" : "none";

                    if (match) visible++;
                });

                empty.style.display = rows.length === 0 ? "block" : "none";
                noResult.style.display =
                    rows.length > 0 && visible === 0 ? "block" : "none";
            });
        })();
    </script>
}