@model IEnumerable<HotelManagement.Models.Thuong>
@{
    ViewData["Title"] = "Quản lý bảng lương"; var rows = Model?.ToList() ?? new();
}
<div class="container-fluid px-0"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h3 class="fw-bold mb-1">Quản lý thưởng</h3></div><a asp-action="Create" asp-route-thang="@ViewBag.Thang" asp-route-nam="@ViewBag.Nam" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm khoản thưởng</a></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form asp-action="Index" method="get" class="row g-2 align-items-end"><div class="col-sm-4 col-md-3"><label class="form-label">Tháng</label><select name="thang" class="form-select">@for(var i=1;i<=12;i++){<option value="@i" selected="@(ViewBag.Thang == i)">Tháng @i</option>}</select></div><div class="col-sm-4 col-md-3"><label class="form-label">Năm</label><input name="nam" type="number" min="2000" max="2100" value="@ViewBag.Nam" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Lọc dữ liệu</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white py-3 d-flex justify-content-between"><strong>Danh sách khoản thưởng · @ViewBag.Thang/@ViewBag.Nam</strong><span class="text-muted small">@rows.Count khoản · Tổng @(((decimal)(ViewBag.TongTien ?? 0m)).ToString("N0")) đ</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>STT</th><th>Nhân viên</th><th>Tên thưởng</th><th>Số tiền</th><th>Lý do</th><th>Thời gian tạo</th><th class="text-center">Thao tác</th></tr></thead><tbody>@if(rows.Any()){var i=0;foreach(var x in rows){i++;<tr><td>@i</td><td><div class="fw-semibold">@(x.NhanVien?.HoTen ?? "—")</div><small class="text-muted">NV@x.MaNV.ToString("D4")</small></td><td>@x.TenThuong</td><td class="text-nowrap fw-semibold text-success">@x.SoTien.ToString("N0") đ</td><td>@(string.IsNullOrWhiteSpace(x.LyDo) ? "—" : x.LyDo)</td><td class="text-nowrap">@x.NgayTao.ToString("dd/MM/yyyy HH:mm")</td><td><div class="d-flex justify-content-center gap-1"><a asp-action="Edit" asp-route-id="@x.MaThuong" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil-square"></i></a><form asp-action="Delete" asp-route-id="@x.MaThuong" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa khoản thưởng này?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button></form></div></td></tr>}}else{<tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block mb-2"></i>Chưa có khoản thưởng trong kỳ này.</td></tr>}</tbody></table></div></div></div></div>
