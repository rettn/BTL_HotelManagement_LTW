
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-page">
    <form asp-controller="Account"
          asp-action="Login"
          method="post"
          class="login-card">

        @Html.AntiForgeryToken()

        <div class="login-icon">
            <img src="~/images/logo.png" alt="Logo" style="width: 43px; height: 43px; object-fit: contain;" />
        </div>

        <h2>Đăng nhập</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <label for="email">Email đăng nhập</label>
        <input id="email"
               name="email"
               type="email"
               class="form-control"
               autocomplete="username"
               required />

        <label for="password" class="mt-3">Mật khẩu</label>
        <input id="password"
               name="password"
               type="password"
               class="form-control"
               autocomplete="current-password"
               required />

        <button type="submit" class="btn-login">
            ĐĂNG NHẬP
        </button>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-home">
            ← Quay lại trang chủ
        </a>
    </form>
</div>

@section Styles {
    <style>
        .login-page {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #f4f0eb;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            padding: 38px;
            background: white;
            border: 1px solid #e5d9ce;
            box-shadow: 0 15px 50px #46372a12;
        }

        .login-icon {
            color: #b99a7e;
            font-size: 36px;
            text-align: center;
        }

        .login-card h2 {
            margin-top: 14px;
            text-align: center;
            font-weight: 400;
        }

        .login-card > p {
            text-align: center;
            color: #81766c;
            margin-bottom: 28px;
        }

        .login-card label {
            display: block;
            margin-bottom: 8px;
        }

        .login-card .form-control {
            border-radius: 0;
            padding: 12px;
        }

        .btn-login {
            width: 100%;
            margin-top: 24px;
            padding: 14px;
            border: 0;
            background: #c9ad96;
            color: white;
        }

        .btn-login:hover {
            background: #9e7f63;
        }

        .back-home {
            display: block;
            margin-top: 20px;
            text-align: center;
            color: #776759;
            text-decoration: none;
        }
    </style>
}
