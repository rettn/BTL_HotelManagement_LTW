@model List<HotelManagement.Models.LoaiPhong>

<div class="type-manager">
    <div class="type-manager-heading">
        <div>
            <h3>Danh sách loại phòng</h3>
           
        </div>

        <a asp-controller="LoaiPhong"
           asp-action="Create"
           class="type-btn type-btn-success">
            <i class="bi bi-plus-lg"></i>
            Thêm loại phòng
        </a>
    </div>

    <form method="get"
          asp-controller="LoaiPhong"
          asp-action="Popup"
          data-type-search>
        <div class="type-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   placeholder="Tìm tên loại phòng..." />
            <button type="submit" class="type-btn type-btn-light">
                Tìm kiếm
            </button>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="type-alert type-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="type-table-wrapper">
        <table class="type-table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Loại phòng</th>
                    <th>Số người</th>
                    <th>Giá theo đêm</th>
                    <th>Mô tả</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lp in Model)
                {
                    <tr>
                        <td>#@lp.MaLoaiPhong</td>
                        <td>
                            <div class="type-name">
                                <span class="type-icon">
                                    <i class="bi bi-door-open"></i>
                                </span>
                                <strong>@lp.TenLoaiPhong</strong>
                            </div>
                        </td>
                        <td>
                            <i class="bi bi-people"></i>
                            @lp.SoNguoiToiDa người
                        </td>
                        <td class="type-price">
                            @lp.GiaTheoDem.ToString("N0") đ
                        </td>
                        <td class="type-description">
                            @(string.IsNullOrWhiteSpace(lp.MoTa)
                                                    ? "Chưa có mô tả"
                                                    : lp.MoTa)
                    </td>
                    <td>
                        <div class="type-actions">
                            <a asp-action="Edit"
                               asp-route-id="@lp.MaLoaiPhong"
                               class="type-icon-btn"
                               title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                                <a asp-action="Details"
                                   asp-route-id="@lp.MaLoaiPhong"
                                   class="type-icon-btn"
                                   title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@lp.MaLoaiPhong"
                                   class="type-icon-btn type-icon-danger"
                                   title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="type-empty">
            <i class="bi bi-inbox"></i>
            <p>Chưa có loại phòng phù hợp.</p>
        </div>
    }

    <div class="type-manager-footer">
        Tổng cộng <strong>@Model.Count</strong> loại phòng
    </div>
</div>

<style>
    .type-manager {
        color: var(--text-primary, #1f2937);
        font-size: 14px;
    }

    .type-manager-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }

        .type-manager-heading h3 {
            margin: 0 0 5px;
            font-size: 19px;
            font-weight: 700;
        }

        .type-manager-heading p {
            margin: 0;
            color: #7b8494;
        }

    .type-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border: 0;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease-in-out;
    }

    /* CSS nút xanh lá đồng bộ */
    .type-btn-success {
        background: #198754 !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(25, 135, 84, 0.2);
    }

        .type-btn-success:hover {
            background: #157347 !important;
            color: #ffffff !important;
            box-shadow: 0 4px 10px rgba(21, 115, 71, 0.3);
            transform: translateY(-1px);
        }

        .type-btn-success:active {
            transform: translateY(0);
            box-shadow: none;
        }

    .type-btn-light {
        background: #eef2f7;
        color: #374151;
    }

        .type-btn-light:hover {
            background: #e2e8f0;
            color: #1f2937;
        }

    .type-search {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        margin-bottom: 18px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

        .type-search input {
            flex: 1;
            min-width: 0;
            padding: 8px;
            border: 0;
            outline: none;
            background: transparent;
        }

    .type-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e9edf3;
        border-radius: 10px;
    }

    .type-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .type-table th {
            padding: 13px 12px;
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            text-align: left;
            font-weight: 700;
        }

        .type-table td {
            padding: 13px 12px;
            border-top: 1px solid #edf0f4;
        }

    .type-name, .type-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .type-icon {
        display: inline-flex;
        width: 35px;
        height: 35px;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eff6ff;
        color: #2563eb;
    }

    .type-price {
        color: #15803d;
        font-weight: 700;
    }

    .type-description {
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .type-icon-btn {
        display: inline-flex;
        width: 33px;
        height: 33px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        text-decoration: none;
        transition: background .2s, color .2s;
    }

        .type-icon-btn:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .type-icon-danger:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .type-empty {
        padding: 30px;
        text-align: center;
        color: #64748b;
    }

        .type-empty i {
            font-size: 32px;
        }

    .type-manager-footer {
        padding-top: 15px;
        color: #64748b;
    }

    .type-alert-success {
        padding: 12px;
        margin-bottom: 15px;
        border-radius: 8px;
        background: #dcfce7;
        color: #166534;
    }


    @@media (max-width: 650px) {

        .type-manager-heading {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>