@model IReadOnlyList<HotelManagement.ViewModels.ThongBaoItemViewModel>
@{
    ViewData["Title"] = "Thông báo";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<style>
    .notifications-page { max-width: 1000px; margin: 0 auto; }
    .notifications-head, .notification-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .notifications-head { margin-bottom: 18px; }
    .notifications-head h2 { margin: 0; font-size: 22px; font-weight: 700; }
    .notifications-actions { display: flex; gap: 8px; }
    .notification-list { overflow: hidden; border: 1px solid var(--admin-border); border-radius: 14px; background: #fff; }
    .notification-row { padding: 16px 18px; border-bottom: 1px solid var(--admin-border); }
    .notification-row:last-child { border-bottom: 0; }
    .notification-row.is-unread { background: color-mix(in srgb, var(--theme-primary) 6%, white); }
    .notification-row-main { display: flex; align-items: flex-start; gap: 13px; min-width: 0; }
    .notification-row-icon { display: grid; place-items: center; flex: 0 0 40px; width: 40px; height: 40px; border-radius: 11px; background: color-mix(in srgb, var(--theme-primary) 14%, white); color: var(--theme-primary); font-size: 18px; }
    .notification-row-copy { min-width: 0; }
    .notification-row-copy a { color: var(--admin-text); font-weight: 700; text-decoration: none; }
    .notification-row-copy a:hover { color: var(--theme-primary); }
    .notification-row-copy p { margin: 4px 0 5px; color: var(--admin-muted); }
    .notification-row-copy time { color: var(--admin-muted); font-size: 12px; }
    .notification-empty-page { padding: 54px 20px; text-align: center; color: var(--admin-muted); }
    .notification-empty-page i { display: block; margin-bottom: 10px; font-size: 32px; }
    html[data-theme="dark"] .notification-list { background: #202733; }
    html[data-theme="dark"] .notification-row.is-unread { background: color-mix(in srgb, var(--theme-primary) 15%, #202733); }
    @@media (max-width: 650px) { .notifications-head { align-items: flex-start; flex-direction: column; } .notifications-actions { flex-wrap: wrap; } .notification-row { align-items: flex-start; } }
</style>

<div class="notifications-page">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    <div class="notifications-head">
        <div>
            <h2>Hộp thư thông báo</h2>
            <span class="text-muted">@unreadCount thông báo chưa đọc · hiển thị tối đa 100 thông báo gần nhất</span>
        </div>
        <div class="notifications-actions">
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-success" type="submit" disabled="@(unreadCount == 0)"><i class="bi bi-check2-all me-1"></i>Đánh dấu đã đọc</button>
            </form>
            <form asp-action="ClearRead" method="post" onsubmit="return confirm('Xóa các thông báo đã đọc?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-trash me-1"></i>Xóa đã đọc</button>
            </form>
        </div>
    </div>

    <div class="notification-list">
        @if (Model.Count == 0)
        {
            <div class="notification-empty-page"><i class="bi bi-bell-slash"></i>Chưa có thông báo nào.</div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <article class="notification-row @(item.DaDoc ? "" : "is-unread")">
                    <div class="notification-row-main">
                        <span class="notification-row-icon"><i class="bi @(item.LoaiThongBao.StartsWith("SapHetKho") ? "bi-box-seam" : "bi-calendar-check")"></i></span>
                        <div class="notification-row-copy">
                            <a href="@item.Url">@item.TieuDe</a>
                            <p>@item.NoiDung</p>
                            <time datetime="@item.NgayTao.ToString("O")">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</time>
                        </div>
                    </div>
                    @if (!item.DaDoc)
                    {
                        <form asp-action="MarkRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Đánh dấu đã đọc"><i class="bi bi-check2"></i></button>
                        </form>
                    }
                </article>
            }
        }
    </div>
</div>
