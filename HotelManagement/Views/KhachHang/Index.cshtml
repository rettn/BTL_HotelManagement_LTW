
@model IEnumerable<HotelManagement.Models.KhachHang>

@{
    ViewData["Title"] = "Khách hàng";
}

<style>
    .customer-page { color: #263449; }
    .customer-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .customer-heading h2 { font-size: 26px; font-weight: 700; margin: 0 0 6px; }
    .customer-heading p { color: #748198; margin: 0; }
    .customer-panel {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
    }
    .customer-search {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .customer-search input {
        flex: 1;
        min-width: 220px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
    }
    .customer-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 13px;
        border: 1px solid #dce3ed;
        border-radius: 7px;
        background: white;
        color: #41516a;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }
    .customer-btn:hover { background: #f1f6fc; }
    .customer-btn-primary {
        background: #209c60;
        color: white;
        border-color: #209c60;
    }

    .customer-btn-primary:hover { background: #16834f; color: white; }
    .customer-table-wrap { overflow-x: auto; }
    .customer-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .customer-table th {
        background: #f7f9fc;
        color: #65748b;
        text-align: left;
        padding: 14px 12px;
        font-size: 13px;
        white-space: nowrap;
    }
    .customer-table td {
        padding: 14px 12px;
        border-bottom: 1px solid #edf0f5;
        vertical-align: middle;
    }
    .customer-table tbody tr:hover { background: #fafcff; }
    .customer-code { font-weight: 700; color: #287fd1; }
    .customer-name { font-weight: 600; }
    .customer-muted { color: #77849a; font-size: 13px; }
    .customer-actions { display: flex; gap: 6px; }
    .customer-alert { padding: 12px 15px; border-radius: 8px; margin-bottom: 16px; }
    .customer-success { background: #e4f8ed; color: #16804a; }
    .customer-error { background: #ffe8e8; color: #b83232; }
    .customer-empty { padding: 42px 15px; text-align: center; color: #77849a; }
    .customer-empty i { font-size: 36px; display: block; margin-bottom: 10px; }
</style>

<div class="customer-page">
    <div class="customer-heading">
        <div>
            <h2>Danh sách khách hàng</h2>
            <p>Quản lý hồ sơ và thông tin khách hàng của khách sạn</p>
        </div>

        <a asp-action="Create" class="customer-btn customer-btn-primary">
            <i class="bi bi-person-plus"></i>
            Thêm khách hàng
        </a>
    </div>

    

    <div class="customer-panel">
        <form asp-action="Index" method="get" class="customer-search">
            <input type="search"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   placeholder="Tìm mã, họ tên, số điện thoại, email, CCCD..." />

            <button type="submit" class="customer-btn">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>

            <a asp-action="Index" class="customer-btn">
                <i class="bi bi-arrow-counterclockwise"></i> Làm mới
            </a>
        </form>

        <div class="customer-table-wrap">
            <table class="customer-table">
                <thead>
                    <tr>
                        <th>Mã KH</th>
                        <th>Khách hàng</th>
                        <th>Giới tính</th>
                        <th>Ngày sinh</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr>
                            <td><span class="customer-code">@kh.MaKH.ToString("D4")</span></td>
                            <td>
                                <div class="customer-name">@kh.HoTen</div>
                                <div class="customer-muted">CCCD: @(string.IsNullOrWhiteSpace(kh.CCCD) ? "Chưa cập nhật" : kh.CCCD)</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(kh.GioiTinh) ? "—" : kh.GioiTinh)</td>
                            <td>@(kh.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(kh.SoDienThoai) ? "—" : kh.SoDienThoai)</td>
                            <td>@(string.IsNullOrWhiteSpace(kh.Email) ? "—" : kh.Email)</td>
                            <td>@kh.NgayTao.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="customer-actions">
                                    <a asp-action="Details" asp-route-id="@kh.MaKH"
                                       class="customer-btn" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@kh.MaKH"
                                       class="customer-btn" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@kh.MaKH"
                                       class="customer-btn" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="customer-empty">
                <i class="bi bi-people"></i>
                <h5>Không tìm thấy khách hàng</h5>
                <p>Hãy thử từ khóa khác hoặc thêm khách hàng mới.</p>
            </div>
        }

        <div class="customer-muted mt-3">
            Tổng số kết quả: <strong>@Model.Count()</strong>
        </div>
    </div>
</div>
