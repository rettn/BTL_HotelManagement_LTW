@model HotelManagement.ViewModels.RoomPerformanceViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Báo cáo Công suất & Khai thác Hạng phòng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalRevenueAllRooms = Model.DoanhThuTheoHangPhong.Sum(x => x.DoanhThu);
    var totalNightsAllRooms = Model.DoanhThuTheoHangPhong.Sum(x => x.TongSoDemThue);
    var totalBookingsAllRooms = Model.DoanhThuTheoHangPhong.Sum(x => x.SoLuotDat);
}

<style>
    @@media print {
        .admin-sidebar, .admin-topbar, .sidebar-resize-handle, 
        .sidebar-overlay, .sidebar-footer, .d-print-none, button, a.btn {
            display: none !important;
        }
        body, .admin-shell, .admin-main, .container-fluid {
            background-color: #ffffff !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            box-shadow: none !important;
        }
        .card {
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            break-inside: avoid;
            margin-bottom: 20px !important;
        }
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & BỘ LỌC THỜI GIAN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-xl-5 col-lg-12">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-door-open fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1">Hiệu suất Công suất & Hạng phòng</h3>
                            <p class="text-muted small mb-0">Tỷ lệ lấp đầy phòng (Occupancy Rate) và phân tích doanh thu khai thác từng loại phòng</p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-7 col-lg-12">
                    <form method="get" asp-action="RoomPerformance" class="row g-2 justify-content-xl-end align-items-center d-print-none">
                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-event me-1"></i>Từ ngày
                            </label>
                            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-check me-1"></i>Đến ngày
                            </label>
                            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12 d-flex gap-2 pt-sm-4">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold shadow-sm">
                                <i class="bi bi-funnel-fill me-1"></i>Lọc
                            </button>
                            <a asp-action="RoomPerformance" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-outline-dark btn-sm" title="In báo cáo">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ CÔNG SUẤT VÀ KHAI THÁC -->
    <div class="row g-3 mb-4">
        <!-- Tỷ lệ lấp đầy phòng (Occupancy Rate) -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tỷ lệ lấp đầy (Occupancy)</span>
                            <h3 class="fw-bold text-primary mb-0 mt-1">@Model.OccupancyRate%</h3>
                            <small class="text-muted">@Model.TongSoDemThucTe / @Model.TongSoDemKhaDung đêm khả dụng</small>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-percent fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng số phòng vận hành -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Quy mô phòng</span>
                            <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TongSoPhong phòng</h4>
                            <small class="text-muted">Tổng số phòng đang quản lý</small>
                        </div>
                        <div class="rounded-3 bg-light text-secondary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng số đêm phòng đã bán -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng đêm phòng bán</span>
                            <h4 class="fw-bold text-info mb-0 mt-1">@Model.TongSoDemThucTe đêm</h4>
                            <small class="text-muted">@Model.TongLuotDatPhong lượt đặt phòng trong kỳ</small>
                        </div>
                        <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-moon-stars fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu tiền phòng -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Doanh thu tiền phòng</span>
                            <h4 class="fw-bold text-success mb-0 mt-1">@Model.TongDoanhThuPhong.ToString("N0") đ</h4>
                            <small class="text-muted">Phát sinh từ lưu trú phòng</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG BÁO CÁO DOANH THU THEO HẠNG PHÒNG -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-table text-primary me-2"></i>Bảng chi tiết Doanh thu theo Hạng phòng
                        </h5>
                        <p class="text-muted small mb-0">Thống kê lượt đặt, đêm thuê và tỷ trọng đóng góp doanh thu của từng loại phòng</p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        @Model.DoanhThuTheoHangPhong.Count hạng phòng
                    </span>
                </div>
                <div class="card-body px-4 py-2">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary text-uppercase fs-7 fw-bold">
                                <tr>
                                    <th>STT</th>
                                    <th>Hạng phòng</th>
                                    <th class="text-center">Số lượt đặt</th>
                                    <th class="text-center">Tổng đêm thuê</th>
                                    <th class="text-end">Doanh thu</th>
                                    <th style="width: 220px;">Tỷ lệ đóng góp</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.DoanhThuTheoHangPhong.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-1 opacity-50"></i>
                                            Chưa có dữ liệu thuê phòng trong khoảng thời gian đã chọn.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int index = 1;
                                    @foreach (var item in Model.DoanhThuTheoHangPhong)
                                    {
                                        <tr>
                                            <td class="text-muted small fw-bold">@index</td>
                                            <td>
                                                <div class="fw-bold text-dark">@item.TenLoaiPhong</div>
                                                <small class="text-muted">Giá niêm yết: @item.GiaTheoDemHienTai.ToString("N0") đ/đêm</small>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                <span class="badge bg-light text-dark border px-2 py-1">@item.SoLuotDat lượt</span>
                                            </td>
                                            <td class="text-center fw-semibold text-secondary">
                                                @item.TongSoDemThue đêm
                                            </td>
                                            <td class="text-end fw-bold text-primary">
                                                @item.DoanhThu.ToString("N0") đ
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 8px; background-color: #e9ecef; border-radius: 4px;">
                                                        <div class="progress-bar" role="progressbar" 
                                                             style="width: @(item.TiLePhanTram.ToString("0.0", CultureInfo.InvariantCulture))%; background-color: #0d6efd; border-radius: 4px;" 
                                                             aria-valuenow="@(item.TiLePhanTram.ToString("0.0", CultureInfo.InvariantCulture))" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="small fw-semibold text-secondary" style="min-width: 45px;">@item.TiLePhanTram%</span>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light border-top border-2">
                                <tr class="fw-bold text-dark">
                                    <td colspan="2">TỔNG CỘNG:</td>
                                    <td class="text-center">@totalBookingsAllRooms lượt</td>
                                    <td class="text-center">@totalNightsAllRooms đêm</td>
                                    <td class="text-end text-danger fs-6">@totalRevenueAllRooms.ToString("N0") đ</td>
                                    <td><span class="badge bg-success">100%</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

