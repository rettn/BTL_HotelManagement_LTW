@model HotelManagement.ViewModels.TopCustomersViewModel

@{
    ViewData["Title"] = "Báo cáo Top Khách hàng VIP";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @@media print {
        .admin-sidebar, .admin-topbar, .sidebar-resize-handle, 
        .sidebar-overlay, .sidebar-footer, .d-print-none, button, a.btn {
            display: none !important;
        }
        body, .admin-shell, .admin-main, .container-fluid {
            background-color: #ffffff !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            box-shadow: none !important;
        }
        .card {
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            break-inside: avoid;
            margin-bottom: 20px !important;
        }
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & BỘ LỌC THỜI GIAN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-xl-5 col-lg-12">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-gem fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1">Top Khách hàng VIP & Thân thiết</h3>
                            <p class="text-muted small mb-0">Báo cáo phân tích khách hàng có mức chi tiêu cao và tần suất đặt phòng lớn nhất</p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-7 col-lg-12">
                    <form method="get" asp-action="TopCustomers" class="row g-2 justify-content-xl-end align-items-center d-print-none">
                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-event me-1"></i>Từ ngày
                            </label>
                            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-check me-1"></i>Đến ngày
                            </label>
                            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12 d-flex gap-2 pt-sm-4">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold shadow-sm">
                                <i class="bi bi-funnel-fill me-1"></i>Lọc
                            </button>
                            <a asp-action="TopCustomers" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-outline-dark btn-sm" title="In báo cáo">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ KHÁCH HÀNG VIP -->
    <div class="row g-3 mb-4">
        <!-- Khách hàng chi tiêu cao nhất -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Khách hàng chi tiêu số 1</span>
                            <h4 class="fw-bold text-dark mb-0 mt-1 text-truncate" style="max-width: 170px;" title="@Model.KhachHangTieuBieu">@Model.KhachHangTieuBieu</h4>
                            <small class="text-warning-emphasis fw-semibold"><i class="bi bi-trophy-fill me-1"></i>Hạng 1 kỳ lọc</small>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-trophy fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng chi tiêu Top 10 -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng chi tiêu Top 10</span>
                            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.TongChiTieuTop10.ToString("N0") đ</h4>
                            <small class="text-muted">Đóng góp từ 10 khách hàng đầu</small>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiêu trung bình / khách -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Chi tiêu TB / khách</span>
                            <h4 class="fw-bold text-info mb-0 mt-1">@Model.ChiTieuTrungBinh.ToString("N0") đ</h4>
                            <small class="text-muted">Doanh thu bình quân mỗi khách</small>
                        </div>
                        <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-calculator fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng khách hàng phát sinh chi tiêu -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Số khách hàng chi tiêu</span>
                            <h4 class="fw-bold text-success mb-0 mt-1">@Model.TongKhachHangChiTieu khách</h4>
                            <small class="text-muted">Có hóa đơn trong kỳ</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG XẾP HẠNG TOP KHÁCH HÀNG -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-trophy-fill text-warning me-2"></i>Bảng xếp hạng Khách hàng thân thiết chi tiêu nhiều nhất
                        </h5>
                        <p class="text-muted small mb-0">Danh sách khách hàng sắp xếp theo tổng chi tiêu giảm dần trong kỳ</p>
                    </div>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                        @Model.TopKhachHangs.Count khách hàng
                    </span>
                </div>
                <div class="card-body px-4 py-2">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary text-uppercase fs-7 fw-bold">
                                <tr>
                                    <th class="text-center" style="width: 70px;">Thứ hạng</th>
                                    <th>Khách hàng</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                    <th class="text-center">Số lần đặt</th>
                                    <th class="text-end">Tổng chi tiêu</th>
                                    <th class="text-center">Hạng thành viên</th>
                                    <th class="text-center pe-3">Đặt gần nhất</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TopKhachHangs.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
                                            Chưa ghi nhận dữ liệu chi tiêu của khách hàng trong khoảng thời gian này.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int rank = 1;
                                    @foreach (var kh in Model.TopKhachHangs)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @if (rank == 1)
                                                {
                                                    <span class="badge rounded-circle bg-warning text-dark p-2" title="Quán quân" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-trophy-fill"></i>
                                                    </span>
                                                }
                                                else if (rank == 2)
                                                {
                                                    <span class="badge rounded-circle bg-secondary-subtle text-secondary border p-2" title="Á quân" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-award-fill"></i>
                                                    </span>
                                                }
                                                else if (rank == 3)
                                                {
                                                    <span class="badge rounded-circle bg-warning-subtle text-warning-emphasis border p-2" title="Hạng 3" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-award"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold text-muted">#@rank</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@kh.TenKhachHang</div>
                                                <small class="text-muted">Mã: KH@(kh.MaKH.ToString("D4"))</small>
                                            </td>
                                            <td class="fw-semibold text-secondary">@kh.SoDienThoai</td>
                                            <td class="text-muted small">@(string.IsNullOrEmpty(kh.Email) ? "---" : kh.Email)</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1">@kh.SoLanDatPhong lần</span>
                                            </td>
                                            <td class="text-end fw-bold text-danger fs-6">
                                                @kh.TongChiTieu.ToString("N0") đ
                                            </td>
                                            <td class="text-center">
                                                @switch (kh.HangThanhVien)
                                                {
                                                    case "VIP Kim Cương":
                                                        <span class="badge rounded-pill bg-primary px-3 py-1 text-white shadow-sm">
                                                            <i class="bi bi-gem me-1"></i>Kim Cương
                                                        </span>
                                                        break;
                                                    case "VIP Vàng":
                                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-1 shadow-sm">
                                                            <i class="bi bi-star-fill me-1"></i>Vàng
                                                        </span>
                                                        break;
                                                    case "VIP Bạc":
                                                        <span class="badge rounded-pill bg-secondary text-white px-3 py-1">
                                                            <i class="bi bi-shield me-1"></i>Bạc
                                                        </span>
                                                        break;
                                                    default:
                                                        <span class="badge rounded-pill bg-light text-dark border px-3 py-1">
                                                            Thân thiết
                                                        </span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-center pe-3 text-muted small">
                                                @(kh.NgayDatGanNhat.HasValue ? kh.NgayDatGanNhat.Value.ToString("dd/MM/yyyy") : "---")
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

