@model HotelManagement.ViewModels.ReportOverviewViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Báo cáo Tổng quan chung";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    @@media print {
        .admin-sidebar, .admin-topbar, .sidebar-resize-handle, 
        .sidebar-overlay, .sidebar-footer, .d-print-none, button, a.btn {
            display: none !important;
        }
        body, .admin-shell, .admin-main, .container-fluid {
            background-color: #ffffff !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            box-shadow: none !important;
        }
        .card {
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            break-inside: avoid;
            margin-bottom: 20px !important;
        }
        canvas {
            max-width: 100% !important;
            height: auto !important;
        }
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- TIÊU ĐỀ & FORM LỌC KHOẢNG THỜI GIAN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-xl-5 col-lg-12">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-speedometer2 fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1">Tổng quan Báo cáo & Thống kê</h3>
                            <p class="text-muted small mb-0">Biến động doanh thu tổng quát, cơ cấu phòng/dịch vụ & trạng thái đơn đặt phòng</p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-7 col-lg-12">
                    <form method="get" asp-action="Overview" class="row g-2 justify-content-xl-end align-items-center d-print-none">
                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-event me-1"></i>Từ ngày
                            </label>
                            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12">
                            <label class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-calendar-check me-1"></i>Đến ngày
                            </label>
                            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-sm-4 col-12 d-flex gap-2 pt-sm-4">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold shadow-sm">
                                <i class="bi bi-funnel-fill me-1"></i>Lọc
                            </button>
                            <a asp-action="Overview" class="btn btn-outline-secondary btn-sm" title="Đặt lại">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                            <button type="button" onclick="window.print()" class="btn btn-outline-dark btn-sm" title="In báo cáo">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ DOANH THU TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu hôm nay -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Hôm nay</span>
                            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.DoanhThuHomNay.ToString("N0") đ</h4>
                            <small class="text-muted">Doanh thu phát sinh trong ngày</small>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-calendar2-day fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu tuần này -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tuần này</span>
                            <h4 class="fw-bold text-info mb-0 mt-1">@Model.DoanhThuTuanNay.ToString("N0") đ</h4>
                            <small class="text-muted">Tính từ đầu tuần đến nay</small>
                        </div>
                        <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-calendar-week fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu tháng này -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tháng @(DateTime.Now.ToString("MM/yyyy"))</span>
                            <h4 class="fw-bold text-success mb-0 mt-1">@Model.DoanhThuThangNay.ToString("N0") đ</h4>
                            <small class="text-muted">Doanh thu tháng hiện tại</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-calendar-month fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng doanh thu kỳ lọc -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng doanh thu kỳ lọc</span>
                            <h4 class="fw-bold text-danger mb-0 mt-1">@Model.TongDoanhThuKyNay.ToString("N0") đ</h4>
                            <small class="text-muted">@Model.TongLuotDatPhong đơn đặt phòng</small>
                        </div>
                        <div class="rounded-3 bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 1: BIỂU ĐỒ CỘT DOANH THU & BIỂU ĐỒ TRÒN CƠ CẤU -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ cột -->
        <div class="col-xl-8 col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>@Model.TieuDeBieuDoCot
                        </h5>
                        <p class="text-muted small mb-0">Biểu đồ phân rã chi tiết giữa tiền phòng và tiền dịch vụ theo từng mốc</p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        Gom theo @(Model.LoaiGomNhom == "Ngay" ? "Ngày" : Model.LoaiGomNhom == "Tuan" ? "Tuần" : "Tháng")
                    </span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div style="height: 320px; width: 100%;">
                        <canvas id="revenueBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ tròn cơ cấu doanh thu -->
        <div class="col-xl-4 col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="bi bi-pie-chart-fill text-info me-2"></i>Cơ cấu Doanh thu
                    </h5>
                    <p class="text-muted small mb-0">Tỷ lệ tiền phòng so với dịch vụ phát sinh</p>
                </div>
                <div class="card-body px-4 py-3 d-flex flex-column align-items-center justify-content-center">
                    <div style="height: 220px; width: 100%; position: relative;">
                        <canvas id="revenueStructureDonutChart"></canvas>
                    </div>

                    <div class="w-100 mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="d-inline-block rounded-circle" style="width: 12px; height: 12px; background-color: #0d6efd;"></span>
                                <span class="small fw-semibold text-dark">Tiền phòng:</span>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold small">@Model.DoanhThuPhong.ToString("N0") đ</span>
                                <span class="badge bg-primary-subtle text-primary ms-1">@Model.TiLeDoanhThuPhong%</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="d-inline-block rounded-circle" style="width: 12px; height: 12px; background-color: #ff9800;"></span>
                                <span class="small fw-semibold text-dark">Tiền dịch vụ:</span>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold small">@Model.DoanhThuDichVu.ToString("N0") đ</span>
                                <span class="badge bg-warning-subtle text-warning-emphasis ms-1">@Model.TiLeDoanhThuDichVu%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 2: THỐNG KÊ TRẠNG THÁI ĐƠN ĐẶT PHÒNG -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="bi bi-diagram-3-fill text-warning me-2"></i>Trạng thái đơn đặt phòng
                    </h5>
                    <p class="text-muted small mb-0">Phân bố tỷ lệ các trạng thái đơn đặt phòng được ghi nhận trong kỳ</p>
                </div>
                <div class="card-body px-4 py-3">
                    <div class="row align-items-center">
                        <div class="col-lg-4 col-12 mb-3 mb-lg-0">
                            <div style="height: 220px; width: 100%; position: relative;">
                                <canvas id="bookingStatusChart"></canvas>
                            </div>
                        </div>
                        <div class="col-lg-8 col-12">
                            <div class="row g-3">
                                @foreach (var st in Model.ThongKeTrangThaiDatPhong)
                                {
                                    <div class="col-sm-6 col-12">
                                        <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="d-inline-block rounded-circle" style="width: 12px; height: 12px; background-color: @st.MauSac;"></span>
                                                <span class="fw-semibold text-dark">@st.TenHienThi</span>
                                            </div>
                                            <div class="text-end">
                                                <span class="fw-bold text-dark">@st.SoLuong đơn</span>
                                                <span class="badge @st.BadgeClass ms-1">@st.TiLePhanTram%</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formatVND = (val) => Number(val).toLocaleString('vi-VN') + ' đ';

            // 1. BIỂU ĐỒ CỘT BIẾN ĐỘNG DOANH THU
            const labelsThoiGian = @Html.Raw(JsonSerializer.Serialize(Model.LabelsThoiGian));
            const dtPhong = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuPhongThoiGian));
            const dtDichVu = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuDichVuThoiGian));

            new Chart(document.getElementById('revenueBarChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labelsThoiGian,
                    datasets: [
                        {
                            label: 'Tiền phòng',
                            data: dtPhong,
                            backgroundColor: '#0d6efd',
                            hoverBackgroundColor: '#0b5ed7',
                            borderRadius: 6
                        },
                        {
                            label: 'Tiền dịch vụ',
                            data: dtDichVu,
                            backgroundColor: '#ff9800',
                            hoverBackgroundColor: '#f57c00',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    animation: { duration: 1000, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: { size: 12, weight: '600' } } },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.92)',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: (ctx) => ' ' + ctx.dataset.label + ': ' + formatVND(ctx.parsed.y),
                                footer: (items) => '\n Tổng cộng: ' + formatVND(items.reduce((a, b) => a + b.parsed.y, 0))
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            ticks: { callback: (v) => (v / 1000000) + ' Tr' },
                            grid: { color: 'rgba(0, 0, 0, 0.05)' }
                        }
                    }
                }
            });

            // 2. BIỂU ĐỒ TRÒN CƠ CẤU DOANH THU
            const valPhong = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuPhong));
            const valDichVu = @Html.Raw(JsonSerializer.Serialize(Model.DoanhThuDichVu));
            const tongCoCau = (valPhong + valDichVu) > 0 ? (valPhong + valDichVu) : 1;

            new Chart(document.getElementById('revenueStructureDonutChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Tiền phòng', 'Tiền dịch vụ'],
                    datasets: [{
                        data: [valPhong, valDichVu],
                        backgroundColor: ['#0d6efd', '#ff9800'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { animateScale: true, animateRotate: true, duration: 1000, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.92)',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${formatVND(ctx.parsed)} (${((ctx.parsed / tongCoCau) * 100).toFixed(1)}%)`
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // 3. BIỂU ĐỒ TRÒN TRẠNG THÁI ĐẶT PHÒNG
            const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.ThongKeTrangThaiDatPhong.Select(x => x.TenHienThi)));
            const statusCounts = @Html.Raw(JsonSerializer.Serialize(Model.ThongKeTrangThaiDatPhong.Select(x => x.SoLuong)));
            const statusColors = @Html.Raw(JsonSerializer.Serialize(Model.ThongKeTrangThaiDatPhong.Select(x => x.MauSac)));

            const totalBookings = statusCounts.reduce((a, b) => a + b, 0);

            new Chart(document.getElementById('bookingStatusChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: totalBookings > 0 ? statusLabels : ['Chưa có đơn'],
                    datasets: [{
                        data: totalBookings > 0 ? statusCounts : [1],
                        backgroundColor: totalBookings > 0 ? statusColors : ['#e9ecef'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { animateScale: true, animateRotate: true, duration: 1000, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.92)',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: (ctx) => {
                                    if (totalBookings === 0) return ' Chưa có dữ liệu';
                                    return ` ${ctx.label}: ${ctx.parsed} đơn (${((ctx.parsed / totalBookings) * 100).toFixed(1)}%)`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
}

